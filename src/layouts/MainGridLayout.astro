---
import FloatingControls from "@components/control/FloatingControls.astro";
import Banner from "@components/layout/Banner.astro";
import RightSideBar from "@components/layout/RightSideBar.astro";
import FullscreenWallpaper from "@components/misc/FullscreenWallpaper.astro";
import IconifyLoader from "@components/misc/IconifyLoader.astro";
import Footer from "@components/organisms/footer/Footer.astro";
import PaperHeader from "@components/organisms/navigation/PaperHeader.astro";
import SideBar from "@components/widgets/sidebar/SideBar.astro";
import PaperRandomCard from "@components/widgets/sidebar/PaperRandomCard.astro";
import type { MarkdownHeading } from "astro";
import { Icon } from "astro-icon/components";

import { fullscreenWallpaperConfig, siteConfig } from "../config";
import {
	BANNER_HEIGHT,
	BANNER_HEIGHT_FULLSCREEN,
} from "../constants/constants";
import { formatDateToYYYYMMDD } from "../utils/date-utils";
import {
	calculateGridLayout,
	getBannerImages,
	getMainPanelTop,
	getTransparencyClass,
	shouldEnableTransparency,
} from "../utils/grid-layout-utils";
import { widgetManager } from "../utils/widget-manager";
import Layout from "./Layout.astro";
import GridScripts from "./partials/GridScripts.astro";

interface Props {
	title?: string;
	banner?: string;
	description?: string;
	lang?: string;
	setOGTypeArticle?: boolean;
	postSlug?: string;
	headings?: MarkdownHeading[];
	coverImage?: string;
	publishedDate?: Date;
	category?: string;
	wordCount?: number;
	/**
	 * FlatPaper 列表页右栏（welcome-card + 最近动态）：仅 archive/tags/categories/tag/category/分页 列表页传入 true
	 *
	 * ⚠️ 2026-10-06：右栏与 #main-grid 都在 <main> 之外，Swup 跨页不替换它们。
	 * 原实现按 paperListRail 构建期分叉 DOM（列表页才渲染右栏、才用三列网格），
	 * 于是「从 /archive/ 切到文章页」时右栏与三列网格会整块留在原地（非首页双侧边栏）。
	 * 现在右栏始终渲染，显隐与网格列数改由 #main-grid[data-has-right-rail] 驱动，
	 * 该属性在构建期写入初值、跨页由 swup-hooks 依据新页面的 data-has-right-rail 同步。
	 */
	paperListRail?: boolean;
}

// 获取 banner 图片
const bannerImages = await getBannerImages(siteConfig);

const {
	title,
	banner,
	description,
	lang,
	setOGTypeArticle,
	postSlug,
	coverImage,
	headings = [],
	publishedDate,
	category,
	wordCount,
	paperListRail = false,
} = Astro.props;
const hasBannerCredit = siteConfig.banner.credit.enable;
const hasBannerLink = !!siteConfig.banner.credit.url;

// 检查是否为首页
const isHomePage = Astro.url.pathname === "/" || Astro.url.pathname === "";
// 手机端非首页不显示banner的CSS类
const mobileNonHomeBannerClass = !isHomePage ? "mobile-hide-banner" : "";

// 计算主内容区域位置
const finalMainPanelTop = getMainPanelTop(
	siteConfig.wallpaperMode.defaultMode,
	BANNER_HEIGHT,
	BANNER_HEIGHT_FULLSCREEN,
);

// 计算网格布局
const {
	gridCols,
	sidebarClass,
	rightSidebarClass,
	mainContentClass,
	sidebarPresence,
	mobileShowSidebar,
	tabletShowSidebar,
	desktopShowSidebar,
} = calculateGridLayout({
	siteConfig,
	widgetManager,
	// 2026-10-06：始终按「有右栏」计算三列网格，实际是否显示右栏交给
	// #main-grid[data-has-right-rail] + CSS（见文件末尾 style），
	// 避免构建期分叉 DOM 导致跨页后右栏/列数残留。
	rightRailEnabled: true,
});

// 右栏组件是否齐备（齐备才可能显示）；实际显隐见 data-has-right-rail
const { hasRightSidebarComponents, hasMobileDrawerComponents } =
	sidebarPresence;

// 半透明效果
const shouldEnable = shouldEnableTransparency(
	siteConfig.wallpaperMode.defaultMode,
);
const transparentClass = getTransparencyClass(shouldEnable);

// 布局模式
const defaultPostListLayout = siteConfig.postListLayout?.defaultMode || "list";

// FlatPaper 列表页右栏（sidebar-left.ejs：random-posts 单卡）。
// flatpaper 的 welcome-card 仅 is_home()（首页由 PaperHomeLayout 直渲），
// 归档/分类/标签/分页列表页右栏只有随机文章 —— 对齐 r16 差距 #1③。
// 仅列表页渲染（paperListRail 由 archive/tags/categories/tag/category/分页页传入）；
// 文章页与独立页保持 flatpaper 两栏结构；音乐组件（红线）始终保留。
---

<Layout
	title={title}
	banner={banner}
	description={description}
	lang={lang}
	setOGTypeArticle={setOGTypeArticle}
	postSlug={postSlug}
	coverImage={coverImage}
>
	<!-- 2026-09-30：内页不再响应壁纸模式切换/浏览器残留的 localStorage 模式，
	     wallpaperEnabled=false 锁定为配置默认值（none）——顶部就是导航栏，与 FlatPaper 一致 -->
	<GridScripts
		navbarTransparentMode={siteConfig.banner?.navbar?.transparentMode ||
			"semi"}
		defaultWallpaperMode={siteConfig.wallpaperMode.defaultMode}
		defaultPostListLayout={siteConfig.postListLayout?.defaultMode || "list"}
		BANNER_HEIGHT={BANNER_HEIGHT}
		BANNER_HEIGHT_FULLSCREEN={BANNER_HEIGHT_FULLSCREEN}
		pageScaling={siteConfig.pageScaling}
		wavesEnabled={siteConfig.banner?.waves?.enable ?? true}
		bannerTitleEnabled={siteConfig.banner?.homeText?.enable ?? true}
		wallpaperEnabled={false}
		postListLayoutEnabled={siteConfig.postListLayout?.enable ?? true}
	/>

	<!-- 全屏壁纸 - 始终渲染，通过 JS 控制显示隐藏 -->
	<FullscreenWallpaper config={fullscreenWallpaperConfig} />

	<!-- 全局图标加载器 -->
	<IconifyLoader />

	<!-- Header（FlatPaper .site-header：sticky top 16px + 铺纸 + 纸胶带由 paper-header.css 承担；
	     宽度容器与 PaperHomeLayout 首页一致：min(94%, --page-width)） -->
	<slot slot="head" name="head" />
	<div
		id="top-row"
		class="z-50 pointer-events-none relative"
		style="width: min(94%, var(--page-width)); margin-inline: auto;"
	>
		<div id="navbar-wrapper" class="pointer-events-auto">
			<PaperHeader />
		</div>
	</div>

	<!-- Banner 组件（2026-09-30：首屏大图仅首页显示——首页走 PaperHomeLayout 自带 PaperHero；
	     MainGridLayout 全部为内页，顶部就是导航栏，不再渲染 Banner，也避免隐藏状态下白白下载大图） -->
	{isHomePage && (
		<Banner
			bannerImages={bannerImages}
			mobileNonHomeBannerClass={mobileNonHomeBannerClass}
			showTextOverlay={isHomePage &&
				(siteConfig.banner.homeText?.enable ?? false)}
		/>
	)}

	<!-- Main content -->
	<div
		class={`absolute w-full z-30 pointer-events-none ${mobileNonHomeBannerClass ? "mobile-main-no-banner" : ""} ${siteConfig.wallpaperMode.defaultMode === "none" ? "no-banner-layout" : ""} ${transparentClass}`}
		style={`top: ${finalMainPanelTop}`}
	>
		<!-- The pointer-events-none here prevent blocking the click event of the TOC -->
		<!-- 2026-10-06：宽度与导航栏统一为 min(94%, var(--page-width))。
		     原来只有 max-w-(--page-width)（= max-width:1300px，没有 94% 收窄），
		     而 #top-row 用的是 min(94%, var(--page-width)) —— 两套口径不一致，
		     内容容器比导航栏宽出 6%（≈78px），右端对不齐。
		     FlatPaper 原站 .site-header 与 .paper-shell 同为 min(94vw, 1300px)，此处照齐。
		     用内联 style 而非改 Tailwind 任意值类，避免影响其它 max-w-(--page-width) 用法。 -->
		<div
			class="relative mx-auto pointer-events-auto"
			style="width: min(94%, var(--page-width));"
		>
			<div
				id="main-grid"
				class={`transition duration-700 w-full left-0 right-0 grid ${gridCols} grid-rows-none md:grid-rows-[auto] mx-auto gap-4 px-2 md:px-4 ${!mobileShowSidebar || !hasMobileDrawerComponents ? "mobile-no-sidebar" : ""} ${hasRightSidebarComponents ? "mobile-both-sidebar" : ""}`}
				data-layout-mode={defaultPostListLayout}
				data-has-right-rail={paperListRail ? "true" : "false"}
			>
				<!-- Banner image credit -->
				{
					hasBannerCredit && (
						<a
							href={siteConfig.banner.credit.url}
							id="banner-credit"
							target="_blank"
							rel="noopener"
							aria-label="Visit image source"
							class:list={[
								"group onload-animation transition-all absolute flex justify-center items-center rounded-full " +
									"px-3 right-4 -top-13 bg-black/60 hover:bg-black/70 h-9",
								{
									"hover:pr-9 active:bg-black/80":
										hasBannerLink,
								},
							]}
						>
							<Icon
								class="text-white/75 text-[1.25rem] mr-1"
								name="material-symbols:copyright-outline-rounded"
							/>
							<div class="text-white/75 text-xs">
								{siteConfig.banner.credit.text}
							</div>
							<Icon
								class:list={[
									"transition absolute text-[var(--color-accent)] right-4 text-[0.75rem] opacity-0",
									{
										"group-hover:opacity-100":
											hasBannerLink,
									},
								]}
								name="lucide:external-link"
							/>
						</a>
					)
				}

				{/* 侧边栏和主内容区域容器 */}
				<div class="contents">
					{
						(mobileShowSidebar ||
							tabletShowSidebar ||
							desktopShowSidebar) && (
							<SideBar
								class={`${sidebarClass} ${transparentClass}`}
								headings={headings}
							/>
						)
					}

					{
						hasRightSidebarComponents && (
						<div
							class={`right-sidebar-container ${rightSidebarClass} ${transparentClass}`}
						>
							<div class="hidden w-full flex-col gap-[22px] lg:flex">
								<PaperRandomCard limit={5} />
								<RightSideBar headings={headings} />
							</div>
						</div>
					)
				}
				</div>

				<main
					id="swup-container"
					class={`${mainContentClass} transition-main`}
				>
					<div
						id="content-wrapper"
						class="onload-animation transition-leaving"
					>
						<div
							id="page-overlay-data"
							data-title={title || ""}
							data-date={publishedDate ? formatDateToYYYYMMDD(publishedDate) : ""}
							data-category={category || ""}
							data-words={wordCount ? String(wordCount) : ""}
							data-is-post={postSlug ? "true" : "false"}
							data-is-home={isHomePage ? "true" : "false"}
						data-has-right-rail={paperListRail ? "true" : "false"}
							data-wallpaper-mode={siteConfig.wallpaperMode.defaultMode}
							class="hidden"
						>
						</div>
						<slot />
					</div>
				</main>

				<!-- 桌面页脚：必须是 #main-grid 的直接子元素（col-span-full），
				     不能放进 main#swup-container —— main 只是三栏网格的中间列，
				     页脚的 100vw 通栏色带需要以视口居中的容器为定位基准，
				     放进中间列会导致内页页脚色带错位（看起来像卡片）。
				     页脚内容全站一致，放在 Swup 容器外也不会在导航时丢失。 -->
				<div
					class="footer col-span-full onload-animation hidden lg:block"
				>
					<Footer />
				</div>

				<div
					class="footer col-span-full onload-animation block lg:hidden"
				>
					<Footer />
				</div>
			</div>

			<FloatingControls headings={headings} />
		</div>
	</div>

	<style>
		.right-sidebar-container {
			align-self: start;
			display: contents;
		}

		.right-sidebar-container #right-sidebar {
			height: fit-content;
		}

		/* 2026-10-06：右栏显隐与桌面三列/两列网格改由 data-has-right-rail 驱动。
		   原因：#main-grid 与右栏都在 <main> 之外，Swup 跨页不替换，
		   构建期分叉 DOM 会让「归档页 → 其他页」时右栏与三列网格整块残留。
		   桌面端（≥1280px）覆盖 Tailwind 的 lg:grid-cols-* 与 lg:block：
		   - 右栏列在无右栏时整体 display:none，主栏相应左移占两列；
		   - 移动/平板断点不受影响（本来就只有单侧栏）。 */
		@media (width >= 1280px) {
			#main-grid[data-has-right-rail="false"] {
				grid-template-columns: 17.5rem minmax(0, 1fr) !important;
			}

			#main-grid[data-has-right-rail="false"] .right-sidebar-container {
				display: none !important;
			}

			#main-grid[data-has-right-rail="false"] > main {
				grid-column: 2 / 3 !important;
			}
		}
	</style>

	<!-- 2026-09-30 Round 19：删除文章右侧悬浮目录（FlatPaper 两栏结构无此物），
	     目录改由左栏 card-toc 卡片承担。保留隐藏 #toc-container 供 swup 选择器兼容 -->
	<div id="toc-container" class="hidden" />
</Layout>

<!--
  Banner 和网格布局样式已提取到 src/styles/banner.css
  该文件通过 src/styles/main.css 导入
-->
