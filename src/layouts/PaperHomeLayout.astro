---
/**
 * PaperHomeLayout —— 手账风首页独立布局
 *
 * 为什么要独立布局（根因说明）：
 *   原有 MainGridLayout 是「全屏壁纸 + Banner 偏移 + 主内容 absolute 叠加」体系，
 *   而 FlatPaper 的结构是「hero 在最前 → 导航 → 内容正常文档流」。
 *   把 hero 塞进前者会出现：首屏被 absolute 层挤压塌缩、资料卡不可见、大段空白。
 *   所以这里照搬 flatpaper layout.ejs 的结构，给首页一套干净的文档流布局。
 *
 * 结构对照（flatpaper layout.ejs）：
 *   <home-hero>                        → PaperHero
 *   partial('_partial/header')         → Navbar
 *   <main class="paper-shell">         → .paper-shell 三栏
 *     sidebar-right.ejs（⚠️ 视觉左栏）  → 个人名片 + 分类 + 标签
 *     <section class="paper-main">     → 主栏（section-head + post-list + pager）
 *     sidebar-left.ejs（⚠️ 视觉右栏）   → 欢迎卡
 *   footer                             → Footer
 *
 * ⚠️ FlatPaper 的文件名与视觉位置相反：
 *   DOM 顺序 = 视觉从左到右，sidebar-right.ejs 排第一（视觉左），
 *   sidebar-left.ejs 排第三（视觉右）。已在其官方站点实测核实。
 *   因此这里 class 名沿用 flatpaper 的 --right/--left（保持 DOM 一致），
 *   视觉位置以 DOM 顺序为准。
 */
import FloatingControls from "@components/control/FloatingControls.astro";
import PaperHero from "@components/layout/PaperHero.astro";
import IconifyLoader from "@components/misc/IconifyLoader.astro";
import Footer from "@components/organisms/footer/Footer.astro";
import Navbar from "@components/organisms/navigation/Navbar.astro";
import PaperProfileCard from "@components/widgets/sidebar/PaperProfileCard.astro";
import PaperCategoriesCard from "@components/widgets/sidebar/PaperCategoriesCard.astro";
import PaperTagsCard from "@components/widgets/sidebar/PaperTagsCard.astro";
import PaperWelcomeCard from "@components/widgets/sidebar/PaperWelcomeCard.astro";
import type { MarkdownHeading } from "astro";

import { profileConfig, siteConfig } from "../config";
import { formatDateToYYYYMMDD } from "../utils/date-utils";
import {
	getCategoryList,
	getSortedPosts,
	getTagList,
} from "../utils/content-utils";
import Layout from "./Layout.astro";
import GridScripts from "./partials/GridScripts.astro";

interface Props {
	title?: string;
	description?: string;
	headings?: MarkdownHeading[];
}

const { title, description, headings = [] } = Astro.props;

const paperHeroConfig = siteConfig.paperHero ?? {};
const paperHeroImages = (paperHeroConfig.images ?? []).filter(
	(src): src is string => typeof src === "string" && src.length > 0,
);

// 个人名片的站点统计（照搬 flatpaper 的 site_info：文章/分类/标签）
const [allPosts, categoryList, tagList] = await Promise.all([
	getSortedPosts(),
	getCategoryList(),
	getTagList(),
]);
const postCount = allPosts.length;
const categoryCount = categoryList.length;
const tagCount = tagList.length;
---

<Layout title={title} description={description}>
	<GridScripts
		navbarTransparentMode="none"
		defaultWallpaperMode="none"
		defaultPostListLayout={siteConfig.postListLayout?.defaultMode || "list"}
		BANNER_HEIGHT={0}
		BANNER_HEIGHT_FULLSCREEN={0}
		pageScaling={siteConfig.pageScaling}
		wavesEnabled={false}
		bannerTitleEnabled={false}
		wallpaperEnabled={false}
		postListLayoutEnabled={siteConfig.postListLayout?.enable ?? true}
	/>

	<!-- 全局图标加载器 -->
	<IconifyLoader />

	<!-- 首屏（照搬 flatpaper：hero 在最前） -->
	<PaperHero
		image={paperHeroImages[0] ?? ""}
		mobileImage={paperHeroConfig.mobileImage ?? false}
		imageOverlay={paperHeroConfig.imageOverlay ?? [0.2, 0.2]}
		noteText={paperHeroConfig.noteText ?? "今天也要\n好好生活"}
		stickers={paperHeroConfig.stickers ?? []}
		stickersDraggable={paperHeroConfig.stickersDraggable ?? true}
		ctaText={paperHeroConfig.ctaText ?? "开始阅读"}
		ctaTarget="paper-home-content"
	/>

	<!-- 导航（照搬 FlatPaper .site-header：width min(94vw,1300px) + margin-inline auto + sticky top 16px）
	     宽度/居中/吸顶全部用内联 Tailwind 类直给，不依赖 CSS 覆盖原 banner 体系 -->
	<div
		id="top-row"
		class="paper-hero-layout z-50 pointer-events-none relative mx-auto"
		style="width: min(94vw, var(--page-width));"
	>
		<div
			id="navbar-wrapper"
			class="pointer-events-auto sticky transition-all"
			style="top: 16px;"
		>
			<Navbar />
		</div>
	</div>

	<!-- 主内容（照搬 main.paper-shell：正常文档流，不再 absolute 叠加）
	     容器宽度与导航一致，都用 FlatPaper 的 min(94vw, 1300px) 规格 -->
	<div id="paper-home-content" class="relative w-full z-30">
		<div class="paper-shell-container">
			<div id="main-grid" class="paper-shell" data-layout-mode="grid">
				<!-- 视觉左栏（flatpaper sidebar-right.ejs，文件名与视觉相反）：
				     个人名片 → 分类 → 标签 -->
				<aside class="paper-sidebar paper-sidebar--right">
					<PaperProfileCard
						postCount={postCount}
						categoryCount={categoryCount}
						tagCount={tagCount}
					/>
					<PaperCategoriesCard limit={6} />
					<PaperTagsCard limit={12} />
				</aside>

				<!-- 主栏（照搬 section.paper-main：grid gap 24px） -->
				<main id="swup-container" class="paper-main transition-main">
					<div id="content-wrapper" class="onload-animation transition-leaving">
						<div
							id="page-overlay-data"
							data-title={title || ""}
							data-date={formatDateToYYYYMMDD(new Date())}
							data-is-home="true"
							data-wallpaper-mode="none"
							class="hidden"
						>
						</div>
						<slot />
					</div>
				</main>

				<!-- 视觉右栏（flatpaper sidebar-left.ejs）：欢迎卡 -->
				<aside class="paper-sidebar paper-sidebar--left">
					<PaperWelcomeCard
						image={paperHeroConfig.welcomeImage ?? profileConfig.avatar ?? ""}
						label={paperHeroConfig.welcomeLabel ?? "Hello!"}
						title={siteConfig.title}
						text={profileConfig.bio ?? ""}
						ctaText={paperHeroConfig.welcomeCtaText ?? "开始阅读"}
						ctaLink={paperHeroConfig.welcomeCtaLink ?? "/archive/"}
					/>
				</aside>
			</div>

			<FloatingControls headings={headings} />
		</div>

		<!-- 页脚 -->
		<div class="footer col-span-full mt-6">
			<Footer />
		</div>
	</div>

	<style>
		/* 手账首屏之后的间距（照搬 .paper-shell margin-top: 28px） */
		#paper-home-content {
			margin-top: 28px;
		}
		@media (max-width: 760px) {
			#paper-home-content {
				margin-top: 18px;
			}
		}
	</style>
</Layout>
