---
// FlatPaper 风格版权卡（2026-10-02 第六轮视觉收敛）：
// 原 License.astro 的信息（标题/链接/作者/日期/协议）+ 结尾区同款 tape 手绘语言。
// 因置于文章卡内（文章结尾、结尾区上方），不再使用独立纸卡的撕边+蓝胶带外壳，
// 收敛为单层手绘虚线方框；字号/间距对齐 fp-nav-label（12px muted）/fp-nav-title（14px/600 ink）。
import { Icon } from "astro-icon/components";
import { licenseConfig } from "../../../config";
import I18nKey from "../../../i18n/i18nKey";
import { i18n } from "../../../i18n/translation";
import { formatDateToYYYYMMDD } from "../../../utils/date-utils";

interface Props {
	title: string;
	pubDate: Date;
	author?: string;
	sourceLink?: string;
	licenseName?: string;
	licenseUrl?: string;
	class?: string;
}

const { title, pubDate, author, sourceLink, licenseName, licenseUrl } =
	Astro.props;
const className = Astro.props.class;

// 版权信息缺省值：与原 License.astro 一致
const DEFAULT_AUTHOR = "余京";
const DEFAULT_LICENSE_NAME = "Unlicensed";
const postUrl = sourceLink || decodeURIComponent(Astro.url.toString());
const licenseHref = licenseName
	? licenseUrl || licenseConfig.url || undefined
	: licenseConfig.url || undefined;
const licenseText = licenseName || DEFAULT_LICENSE_NAME;
---

<section class:list={["paper-license", className]} aria-label="版权声明">
	<header class="paper-license__head">
		<Icon name="lucide:scale" is:inline />
		{i18n(I18nKey.license)}
	</header>

	<div class="paper-license__box">
		<Icon
			name="fa7-brands:creative-commons"
			class="paper-license__watermark"
			aria-hidden="true"
		/>
		<strong class="paper-license__title">{title}</strong>
		<a class="paper-license__link" href={postUrl}>{postUrl}</a>

		<dl class="paper-license__meta">
			<div>
				<dt>{i18n(I18nKey.author)}</dt>
				<dd>{author || DEFAULT_AUTHOR}</dd>
			</div>
			<div>
				<dt>{i18n(I18nKey.publishedAt)}</dt>
				<dd>{formatDateToYYYYMMDD(pubDate)}</dd>
			</div>
			<div>
				<dt>{i18n(I18nKey.license)}</dt>
				<dd>
					{licenseHref ? (
						<a href={licenseHref} target="_blank" rel="noopener">
							{licenseText}
						</a>
					) : (
						licenseText
					)}
				</dd>
			</div>
		</dl>
	</div>
</section>

<style is:global>
	/* ---------- 头部：与结尾区小标题同级（15px/700 ink + 16px accent 图标） ---------- */
	.paper-license__head {
		display: flex;
		align-items: center;
		gap: 8px;
		margin: 0 0 10px;
		font-size: 15px;
		font-weight: 700;
		color: var(--ink);
	}

	.paper-license__head :global(svg) {
		width: 16px;
		height: 16px;
		color: var(--color-accent-strong);
	}

	:root.dark .paper-license__head :global(svg) {
		color: var(--color-accent-muted);
	}

	/* ---------- 单层 tape 手绘方框（与评论/分享按钮同语言，不做纸中纸） ----------
	   2026-10-06：圆角由 255px 15px 225px… 改为 var(--radius-card)。
	   版权卡是整行宽（约 600px+）的成块容器，超椭圆值会被浏览器按比例
	   撑到接近半宽，两端渲染成巨大圆头；改用统一卡片圆角后与正文区
	   其余卡片弧度一致。手绘歪扭感仍由 2px 虚线边框承担。 */
	.paper-license__box {
		position: relative;
		padding: 14px 20px 16px;
		border: 2px dashed var(--dash);
		border-radius: var(--radius-card, 10px);
		background: var(--paper-warm);
		overflow: hidden;
	}

	.paper-license__watermark {
		position: absolute;
		right: 28px;
		top: 50%;
		transform: translateY(-50%) rotate(-4deg);
		width: 10.5rem;
		height: 10.5rem;
		pointer-events: none;
		color: var(--ink);
		opacity: 0.06;
	}

	:root.dark .paper-license__watermark {
		color: var(--paper);
		opacity: 0.08;
	}

	/* 标题：对齐 fp-nav-title 的 14px/600 ink */
	.paper-license__title {
		display: block;
		font-size: 14px;
		font-weight: 700;
		color: var(--ink);
		line-height: 1.5;
		position: relative;
		z-index: 1;
	}

	/* 链接：13px + 虚线下划线（手绘感，替代默认 link 样式） */
	.paper-license__link {
		display: inline-block;
		margin-top: 2px;
		color: var(--color-accent-strong);
		font-size: 13px;
		line-height: 1.6;
		text-decoration: underline dashed var(--dash);
		text-underline-offset: 4px;
		word-break: break-all;
		position: relative;
		z-index: 1;
		transition: color 0.15s ease;
	}

	.paper-license__link:hover {
		color: var(--color-accent);
	}

	:root.dark .paper-license__link {
		color: var(--color-accent-muted);
	}

	/* ---------- 三列元信息：dt 对齐 fp-nav-label（12px/600 muted），dd 对齐 fp-nav-title ---------- */
	.paper-license__meta {
		display: flex;
		flex-wrap: wrap;
		gap: 10px 28px;
		margin: 12px 0 0;
		padding-top: 12px;
		border-top: 1px dashed var(--line);
		position: relative;
		z-index: 1;
	}

	.paper-license__meta dt {
		color: var(--muted);
		font-size: 12px;
		font-weight: 600;
		letter-spacing: 0.02em;
	}

	.paper-license__meta dd {
		margin: 3px 0 0;
		color: var(--ink);
		font-weight: 600;
		font-size: 14px;
		line-height: 1.4;
	}

	.paper-license__meta dd a {
		color: var(--color-accent-strong);
		text-decoration: underline dashed var(--dash);
		text-underline-offset: 4px;
		transition: color 0.15s ease;
	}

	.paper-license__meta dd a:hover {
		color: var(--color-accent);
	}

	:root.dark .paper-license__meta dd a {
		color: var(--color-accent-muted);
	}

	@media (max-width: 600px) {
		.paper-license__box {
			padding: 12px 16px 14px;
		}

		.paper-license__watermark {
			width: 8rem;
			height: 8rem;
			right: 18px;
		}

		.paper-license__meta {
			gap: 10px 20px;
		}
	}
</style>
