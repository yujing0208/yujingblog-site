---
/**
 * PaperPostCard —— 手账风文章卡片
 * 1:1 移植 flatpaper：layout/_partial/post-card.ejs (33行) + post-card.styl (112行)
 *
 * 原版结构：
 *   article.post-card
 *     a.post-thumb-link > thumbnail        ← 顶部封面（含撕纸边）
 *     .post-card-copy
 *       h3 > a                             ← 标题（2行截断）
 *       p                                  ← 摘要（2行截断）
 *       .meta-line--tags                   ← 标签 #tag
 *       .meta-line--tax                    ← 日期 + 分类
 *
 * 数据来自本博客的 entry（与 PostCard.astro 一致）
 */
import { render } from "astro:content";
import { Icon } from "astro-icon/components";
import { getPostHomeContent } from "@utils/post-card-content";

import { getFileDirFromPath, getPostUrl, getTagUrl } from "@/utils/url-utils";

import Image from "../../atoms/Image/Image.astro";
import type { PostCardProps } from "./types";

const { entry, index = 0 }: PostCardProps = Astro.props as PostCardProps;

const {
	title,
	published,
	tags,
	category,
	image,
	description,
	hideHomeContent,
	pinned,
	encrypted,
	password,
} = entry.data;

const url = getPostUrl(entry);
const hasCover = image !== undefined && image !== null && image !== "";

const { remarkPluginFrontmatter } = await render(entry);
const homeContent = getPostHomeContent(
	{ description, hideHomeContent, password },
	remarkPluginFrontmatter.excerpt,
);

// 摘要：照搬原版「压平空白 + 截断」策略（原版 excerpt_length 默认 96）
const summary = String(homeContent ?? "")
	.replace(/<[^>]*>/gu, " ")
	.replace(/\s+/gu, " ")
	.trim();

const dateLabel = published
	? new Date(published).toISOString().slice(0, 10)
	: "";
---

<article class="post-card" data-title={title}>
	{
		hasCover && (
			<a class="post-thumb-link" href={url} aria-label={title}>
				<div class="paper-thumb paper-thumb--cover">
					<Image
						src={image}
						basePath={getFileDirFromPath(entry.filePath || "")}
						alt={title}
						class="w-full h-full"
						widths={[200, 400, 800]}
						sizes="(max-width: 768px) 100vw, 50vw"
						loading={index === 0 ? "eager" : "lazy"}
						fetchpriority={index === 0 ? "high" : "auto"}
						quality={index === 0 ? 65 : undefined}
					/>
				</div>
			</a>
		)
	}

	<div class="post-card-copy">
		<h3>
			<a href={url}>
				{pinned && <Icon name="mdi:pin" class="post-card-pin" />}
				{title}
				{encrypted && password && (
					<Icon name="material-symbols:lock-outline" class="post-card-lock" is:inline />
				)}
			</a>
		</h3>

		{summary && <p>{summary}</p>}

		{
			tags && tags.length > 0 && (
				<div class="meta-line meta-line--tags">
					<span class="meta-tags">
						<Icon name="material-symbols:tag" class="meta-icon" is:inline />
						{tags.map((tag) => (
							<a class="meta-tag-link" href={getTagUrl(tag)}>
								#{tag.trim()}
							</a>
						))}
					</span>
				</div>
			)
		}

		<div class="meta-line meta-line--tax">
			{dateLabel && (
				<span class="meta-date">
					<Icon name="material-symbols:calendar-month-outline" class="meta-icon" is:inline />
					{dateLabel}
				</span>
			)}
			{category && (
				<span class="meta-cat">
					<Icon name="material-symbols:folder-outline" class="meta-icon" is:inline />
					<a class="meta-cat-link" href={`/categories/${category}/`}>
						{category}
					</a>
				</span>
			)}
		</div>
	</div>
</article>
