---
// 统一 MD 渲染：不再导入旧渲染层 markdown.css / markdown-extend.styl（避免与全局
// paper-markdown.css 双套打架）；expressive-code.css 已由 Layout.astro 全局导入。
// 解密后的内容本就包裹在 .markdown-content 容器内，由 paper-markdown.css 统一渲染。
import "@/styles/encrypted-content.css";

import { encryptContent } from "@utils/crypto-utils";

import PasswordProtection from "./PasswordProtection.astro";

export interface Props {
	password: string | number;
	slug: string;
	hint?: string;
}

const { password, slug, hint = "" } = Astro.props;

const htmlContent = await Astro.slots.render("default");

const encryptedContent = encryptContent(htmlContent, String(password), slug);
---

<PasswordProtection encryptedContent={encryptedContent} hint={hint} />
