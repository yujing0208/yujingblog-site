---
import type { PioConfig } from "@/types/config";

interface Props {
	config: PioConfig;
}

const { config } = Astro.props;

const modelPaths = config.models ?? ["/pio/models/NOIR/noir.model3.json"];
const modelConfigs = modelPaths.map((p) => ({ path: p }));

const position = config.position === "right" ? "bottom-right" : "bottom-left";

const tipsData: Record<string, unknown> = {};
if (config.tips) {
	if (config.tips.welcomeMessage)
		tipsData.welcomeMessage = config.tips.welcomeMessage;
	tipsData.messages = config.tips.messages ?? [];
	if (config.tips.duration) tipsData.duration = config.tips.duration;
	tipsData.interval = config.tips.interval ?? 2147483647;
} else if (config.dialog?.welcome || config.dialog?.touch) {
	const welcome = config.dialog.welcome;
	if (welcome)
		tipsData.welcomeMessage = Array.isArray(welcome) ? welcome : [welcome];
	tipsData.messages = [];
	tipsData.interval = 2147483647;
}

if (config.tips?.offset) {
	tipsData.offset = config.tips.offset;
} else {
	tipsData.offset = { x: 0, y: -34 };
}

const widgetConfig: Record<string, unknown> = {
	model: modelConfigs.length === 1 ? modelConfigs[0] : modelConfigs,
	position,
	size: config.width ?? 280,
	transitionDuration: 1500,
	transitionType: "slide",
	_hideAbout: config.hideAboutMenu ?? true,
};

if (config.menus?.items && config.menus.items.length > 0) {
	widgetConfig.menus = {
		items: config.menus.items.map(({ icon, label, action }) => ({
			icon,
			label,
			action,
		})),
		...(config.menus.align && { align: config.menus.align }),
	};
} else {
	widgetConfig.menus = {
		extraItems: [
			{ icon: "mdi:message-text-outline", label: "聊天", action: "chat" },
		],
	};
}

if (Object.keys(tipsData).length > 0) {
	if (!Array.isArray(widgetConfig.model)) {
		(widgetConfig.model as Record<string, unknown>).tips = tipsData;
	}
}

if (config.hoverIntro) {
	widgetConfig._hoverIntro = config.hoverIntro;
}

const touchMsgs = config.dialog?.touch
	? Array.isArray(config.dialog.touch)
		? config.dialog.touch
		: [config.dialog.touch]
	: (config.tips?.messages ?? []);
if (touchMsgs.length > 0) {
	widgetConfig._touchMessages = touchMsgs;
}

const widgetWidth = config.width ?? 280;
const hiddenOnMobile = config.hiddenOnMobile ?? true;
const isRight = config.position === "right";
// 构建时间戳：强制聊天模块新版本生效，避免浏览器缓存旧 waifu-chat.js
const assetVer = Date.now();
---

<iframe
	id="l2d-iframe"
	src="/pio/live2d-host?v=2"
	allowtransparency="true"
	style={"position: fixed; z-index: 999; pointer-events: none; border: none; bottom: 0;"
		+ (isRight ? " right: 0;" : " left: 0;")
		+ " width: " + widgetWidth + "px;"
		+ " height: 600px;"
		+ " opacity: 0;"}
	data-config={JSON.stringify(widgetConfig)}
	data-hidden-on-mobile={hiddenOnMobile ? "true" : "false"}
	data-width={widgetWidth}
></iframe>

<link rel="stylesheet" href={"/pio/waifu-chat.css?v=" + assetVer} />
<script src={"/pio/waifu-chat.js?v=" + assetVer} is:inline></script>

<script>
	(function () {
		const PIO_MOBILE_BREAKPOINT = 768;
		const frames = document.querySelectorAll<HTMLIFrameElement>("#l2d-iframe");
		const el = frames[0] ?? null;
		if (!el) return;
		for (let i = 1; i < frames.length; i++) frames[i].remove();

		const config = JSON.parse(el.dataset.config || "{}");
		const hiddenOnMobile = el.dataset.hiddenOnMobile === "true";

		async function initChat() {
			const MizukiChat = (window as any).MizukiChat;
			if (!MizukiChat) return;
			// swup 切页会重新执行本脚本：只初始化一次，避免多个聊天框实例叠加、
			// message 监听重复绑定（否则每个实例都 toggle，关闭时要点多次）
			if ((window as any).__mizukiChatBound) return;
			(window as any).__mizukiChatBound = true;
			const userCfg = await MizukiChat.loadConfig();
			const chat = new MizukiChat(userCfg || {});
			window.addEventListener("message", (e) => {
				if (e.data?.type === "l2d-chat-toggle") chat.toggle();
			});
		}

		function initPageTips() {
			const PageTips = (window as any).MizukiPageTips;
			if (!PageTips) return;
			new PageTips();
		}

		if ((window as any).MizukiChat) {
			initChat();
			initPageTips();
		} else {
			window.addEventListener("load", () => setTimeout(() => {
				initChat();
				initPageTips();
			}, 200));
		}

		const win = window as Window & {
			__mizukiPioController?: {
				update: (el: HTMLIFrameElement, config: Record<string, unknown>, hiddenOnMobile: boolean) => void;
			};
		};

		if (!win.__mizukiPioController) {
			const menuActions: Record<string, () => void> = {
				home: () => (window.location.href = "/"),
				scrollToTop: () => window.scrollTo({ top: 0, behavior: "smooth" }),
			};
			let currentEl: HTMLIFrameElement | null = null;
			let currentConfig: Record<string, unknown> = {};
			let currentHiddenOnMobile = true;
			let isTransitioning = false;
			let initSent = false;
			let currentConfigKey = "";
			let pendingInit: number | undefined;
			let swupHooksRegistered = false;

			function applyVisibility() {
				if (!currentEl) return;
				if (currentHiddenOnMobile && window.innerWidth <= PIO_MOBILE_BREAKPOINT) currentEl.style.display = "none";
				else currentEl.style.display = "";
			}

			function postInit() {
				if (!currentEl || initSent || isTransitioning) return;
				if (currentHiddenOnMobile && window.innerWidth <= PIO_MOBILE_BREAKPOINT) return;
				currentEl.contentWindow?.postMessage({ type: "l2d-init", config: currentConfig }, "*");
				initSent = true;
			}

			function scheduleInit() {
				window.clearTimeout(pendingInit);
				pendingInit = window.setTimeout(postInit, 150);
			}

			function handleMessage(e: MessageEvent) {
				if (!currentEl || e.source !== currentEl.contentWindow) return;
				if (e.data.type === "l2d-loaded") {
					const h = e.data.contentHeight || 500;
					currentEl.style.height = h + "px";
					currentEl.style.opacity = "1";
					currentEl.style.pointerEvents = "auto";
				}
				if (e.data.type === "l2d-action") menuActions[e.data.action]?.();
			}

			function setupSwupHooks() {
				const swup = (window as any).swup;
				if (swupHooksRegistered || !swup?.hooks) return;
				swupHooksRegistered = true;
				swup.hooks.on("link:click", () => { isTransitioning = true; });
				swup.hooks.on("visit:end", () => { isTransitioning = false; scheduleInit(); });
			}

			window.addEventListener("message", handleMessage);
			window.addEventListener("resize", () => { applyVisibility(); scheduleInit(); });
			if ((window as any).swup) setupSwupHooks();
			else document.addEventListener("swup:enable", setupSwupHooks, { once: true });

			win.__mizukiPioController = {
				update(nextEl, nextConfig, nextHiddenOnMobile) {
					const isNewFrame = currentEl !== nextEl;
					const nextConfigKey = JSON.stringify(nextConfig);
					currentEl = nextEl;
					currentConfig = nextConfig;
					currentHiddenOnMobile = nextHiddenOnMobile;
					if (isNewFrame || currentConfigKey !== nextConfigKey) {
						initSent = false;
						currentConfigKey = nextConfigKey;
					}
					if (isNewFrame) nextEl.addEventListener("load", () => { initSent = false; scheduleInit(); });
					applyVisibility();
					if (nextEl.contentDocument?.readyState === "complete") scheduleInit();
				},
			};
		}

		win.__mizukiPioController.update(el, config, hiddenOnMobile);
	})();
</script>
