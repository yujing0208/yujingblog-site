---
import * as fs from "node:fs";
import * as path from "node:path";

import { footerConfig, profileConfig } from "../../../config";
import { url } from "../../../utils/url-utils";

const currentYear = new Date().getFullYear();

// 页脚自定义内容逻辑
let customFooterHtml = "";
if (footerConfig.enable) {
	// 优先使用 customHtml，如果为空则使用 FooterConfig.html 文件内容
	if (footerConfig.customHtml && footerConfig.customHtml.trim() !== "") {
		customFooterHtml = footerConfig.customHtml.trim();
	} else {
		// customHtml 为空时，读取 FooterConfig.html 文件内容
		try {
			const footerConfigPath = path.join(
				process.cwd(),
				"src",
				"FooterConfig.html",
			);
			customFooterHtml = fs.readFileSync(footerConfigPath, "utf-8");
			// 移除HTML注释
			customFooterHtml = customFooterHtml
				.replace(/<!--[\s\S]*?-->/g, "")
				.trim();
		} catch (error) {
			console.warn(
				"FooterConfig.html文件读取失败:",
				error instanceof Error ? error.message : error,
			);
		}
	}
}
---

<!-- FlatPaper 风格页脚：左侧版权，右侧 Powered by + 链接行（footer.ejs 的 .site-footer 结构） -->
<footer class="site-footer">
	<span class="site-footer__left">
		&copy; <span id="copyright-year">{currentYear}</span>
		{profileConfig.name}
	</span>
	<span class="site-footer__right">
		{customFooterHtml && (
			<span class="site-footer__row" set:html={customFooterHtml} />
		)}
		<span class="site-footer__row">
			Powered by
			<a
				class="transition link"
				target="_blank"
				href="https://github.com/LyraVoid/Mizuki">Mizuki</a
			>
		</span>
		<span class="site-footer__row">
			<a
				class="transition link"
				href={url("rss/")}
				onclick={`event.preventDefault(); navigateToPage('${url("rss/")}')`}>RSS</a
			>
			<span class="site-footer__separator">·</span>
			<a
				class="transition link"
				href={url("atom/")}
				onclick={`event.preventDefault(); navigateToPage('${url("atom/")}')`}>Atom</a
			>
			<span class="site-footer__separator">·</span>
			<a
				class="transition link"
				target="_blank"
				href={url("sitemap-index.xml")}>Sitemap</a
			>
		</span>
	</span>
</footer>

<style>
	/* 移植 FlatPaper footer.styl（变量映射：--dash→--paper-dash、--muted 同名、
	   --color-accent-strong→--fp-accent、--color-accent-muted→--fp-accent-muted） */
	.site-footer {
		display: flex;
		justify-content: space-between;
		align-items: flex-start;
		gap: 20px;
		margin-top: 36px;
		margin-bottom: 24px;
		padding: 18px 0 0;
		border-top: 1px dashed var(--paper-dash);
		color: var(--muted);
		font-size: 12px;
		line-height: 1.8;
	}

	.site-footer__left {
		text-align: left;
	}

	.site-footer__right {
		display: grid;
		justify-items: end;
		gap: 2px;
		text-align: right;
	}

	.site-footer__row {
		display: block;
	}

	.site-footer__separator {
		opacity: 0.68;
		margin-inline: 0.35em;
	}

	.site-footer a {
		transition: color 0.15s ease;
		color: inherit;
	}

	.site-footer a:hover {
		color: var(--fp-accent);
	}

	:global(html.dark) .site-footer a:hover {
		color: var(--fp-accent-muted);
	}
</style>
