---
/**
 * 全站统一页脚 —— 参考 Firefly-Mod（tblog.mmzhiku.xyz）的 site-footer 结构重写：
 *   左上：签名 SVG（src/assets/footer-signature.svg，currentColor 自适应主题）+ 标语
 *   右上：常用联系方式（社交图标）+ Sitemap / RSS / 隐私政策 / 用户协议
 *   左下：版权行 · 框架 / 主题 + 备案行（暂留空）
 *   右下：本站已运行 ·· 天 ·· 时 ·· 分 ·· 秒 + 最后更新于 ·· 天前
 * 样式使用 paper 主题令牌（--paper / --ink / --muted / --paper-dash / --fp-accent），
 * 弹窗组件在 Layout.astro 挂载（PrivacyModal / UserAgreementModal）。
 */
import { Icon } from "astro-icon/components";
import { getSortedPosts } from "@/utils/content-utils";
import { url } from "@/utils/url-utils";
import { profileConfig, siteConfig } from "../../../config";
import signatureSvg from "@assets/footer-signature.svg?raw";

const currentYear = new Date().getFullYear();

// ---- 备案信息（条目列表：label + 链接 + 可选官方图标，填写后自动显示）----
const beianList = [
	{
		label: "茶ICP备2026100394号",
		href: "https://icp.redcha.cn/beian/ICP-2026100394.html",
		icon: "https://icp.redcha.cn/static/picture/icplogoi.png",
	},
	{ label: "萌ICP备20262110号", href: "https://icp.gov.moe/?keyword=20262110", icon: "" },
];

// ---- 签名区：内联 footer-signature.svg（currentColor 自适应明暗主题）----
const hasSignature = true;

// ---- 页脚标语（页脚专用；profileConfig.bio 仍用于侧边栏等处）----
const footerTagline = "且在屏幕和纸张之间，藏些停更的草稿与旧梦。";

// ---- Powered by 信息 ----
const poweredBy = [
	{ label: "框架", name: "Astro", href: "https://astro.build" },
	{ label: "主题", name: "Mizuki", href: "https://github.com/LyraVoid/Mizuki" },
];

// ---- 社交链接（来自 profileConfig.links）----
// mailto:/tel:/weixin: 等非 http(s) 链接不在新标签打开
const opensInNewTab = (href: string) => /^https?:/i.test(href);

// 页脚「常用联系方式」只展示白名单里的这几项（其余链接侧边栏等处照常使用）
const footerSocialNames = ["GitHub", "QQ", "抖音"];
const socialLinks = profileConfig.links.filter((link) =>
	footerSocialNames.includes(link.name),
);

// ---- 联系邮箱（留空则不显示；填入地址后自动出现在常用联系方式里）----
const contactEmail = "2803673194@qq.com";

// ---- 运行时间 / 最后更新（服务端先算一次，客户端每秒刷新）----
const runningTimeTemplate = "本站已运行 {days} 天 {hours} 时 {minutes} 分 {seconds} 秒";
const lastUpdateTemplate = "最后更新于 {days} 天前";
const todayLabel = "最后更新于今天";

function getStartTimestamp(value: string | undefined): number | null {
	if (!value) return null;
	const normalized = /^\d{4}-\d{2}-\d{2}$/.test(value)
		? `${value}T00:00:00+08:00`
		: value;
	const ts = Date.parse(normalized);
	return Number.isNaN(ts) ? null : ts;
}

function formatRunningTime(template: string, elapsedSeconds: number): string {
	const days = Math.floor(elapsedSeconds / 86_400);
	const hours = Math.floor((elapsedSeconds % 86_400) / 3_600);
	const minutes = Math.floor((elapsedSeconds % 3_600) / 60);
	const seconds = elapsedSeconds % 60;
	return template
		.replace("{days}", days.toString())
		.replace("{hours}", hours.toString())
		.replace("{minutes}", minutes.toString())
		.replace("{seconds}", seconds.toString());
}

const startTimestamp = getStartTimestamp(siteConfig.siteStartDate);
const initialRunningTime =
	startTimestamp === null
		? ""
		: formatRunningTime(
				runningTimeTemplate,
				Math.max(0, Math.floor((Date.now() - startTimestamp) / 1_000)),
			);

const posts = await getSortedPosts();
const latestPost = posts.reduce((latest, post) => {
	if (!latest) return post;
	return post.data.published > latest.data.published ? post : latest;
}, posts[0]);
const lastPostDate = latestPost
	? latestPost.data.published.toISOString()
	: null;

function getLastUpdateText(value: string | null): string {
	if (!value) return "";
	const ts = Date.parse(value);
	if (Number.isNaN(ts)) return "";
	const days = Math.max(0, Math.floor((Date.now() - ts) / 86_400_000));
	return days === 0 ? todayLabel : lastUpdateTemplate.replace("{days}", days.toString());
}
const initialLastUpdateText = getLastUpdateText(lastPostDate);
---

<footer
	class="site-footer"
	data-site-footer
	data-start-ts={startTimestamp ?? ""}
	data-last-post-ts={lastPostDate ? Date.parse(lastPostDate) : ""}
	data-running-template={runningTimeTemplate}
	data-update-template={lastUpdateTemplate}
	data-today-label={todayLabel}
>
	<div class="site-footer__inner">
		<div class="site-footer__primary">
			<section class="site-footer__brand" aria-label={profileConfig.name}>
				<div class="site-footer__brand-copy">
					<div class="site-footer__signature" data-footer-signature>
						{hasSignature && <Fragment set:html={signatureSvg} />}
					</div>
					{footerTagline && (
						<p class="site-footer__tagline">{footerTagline}</p>
					)}
				</div>
			</section>

			<nav class="site-footer__contact" aria-label="常用联系方式">
				<p class="site-footer__eyebrow">常用联系方式</p>
				<ul class="site-footer__social-list" role="list">
					{socialLinks.map((link) => (
						<li>
							<a
								class="site-footer__social-link"
								href={link.url}
								target={opensInNewTab(link.url) ? "_blank" : undefined}
								rel={opensInNewTab(link.url) ? "noreferrer" : undefined}
								aria-label={link.name}
								data-tooltip={link.name}
							>
								<Icon name={link.icon} is:inline aria-hidden="true" />
							</a>
						</li>
					))}
					{contactEmail && (
						<li>
							<a
								class="site-footer__social-link"
								href={`mailto:${contactEmail}`}
								aria-label="邮箱"
								data-tooltip="邮箱"
							>
								<Icon name="lucide:mail" is:inline aria-hidden="true" />
							</a>
						</li>
					)}
				</ul>
				<div class="site-footer__utility-links">
					<a href={url("sitemap-index.xml")} target="_blank" rel="noreferrer">Sitemap</a>
					<span aria-hidden="true">/</span>
					<a href={url("rss.xml")} target="_blank" rel="noreferrer">RSS</a>
					<span aria-hidden="true">/</span>
					<button
						class="site-footer__utility-button"
						type="button"
						onclick="window.openPrivacyModal && window.openPrivacyModal()"
					>
						隐私政策
					</button>
					<span aria-hidden="true">/</span>
					<button
						class="site-footer__utility-button"
						type="button"
						onclick="window.openUserAgreementModal && window.openUserAgreementModal()"
					>
						用户协议
					</button>
				</div>
			</nav>
		</div>

		<div class="site-footer__lower">
			<div class="site-footer__legal">
				<div class="site-footer__copyright-row">
					<p class="site-footer__copyright">
						&copy; {currentYear} {profileConfig.name}
					</p>
					{poweredBy.map((item) => (
						<>
							<span class="site-footer__copyright-divider" aria-hidden="true">·</span>
							<span class="site-footer__powered-by">
								<span>{item.label}</span>
								<a href={item.href} target="_blank" rel="noreferrer">{item.name}</a>
							</span>
						</>
					))}
				</div>
				{beianList.length > 0 && (
					<div class="site-footer__beian">
						{beianList.map((item, index) => (
							<>
								{index > 0 && <span aria-hidden="true">/</span>}
								<a href={item.href} target="_blank" rel="noreferrer">
									{item.icon && <img src={item.icon} alt="备案图标" loading="lazy" />}
									<span>{item.label}</span>
								</a>
							</>
						))}
					</div>
				)}
			</div>

			<div class="site-footer__status">
				{startTimestamp !== null && (
					<p class="site-footer__status-line">
						<Icon name="lucide:calendar-clock" is:inline aria-hidden="true" />
						<span data-footer-running-time>{initialRunningTime}</span>
					</p>
				)}
				{lastPostDate && (
					<p class="site-footer__status-line">
						<Icon name="heartbeat-line" is:inline aria-hidden="true" />
						<span data-footer-last-update>{initialLastUpdateText}</span>
					</p>
				)}
			</div>
		</div>
	</div>
</footer>

<script>
	// 页脚每秒刷新：运行时间 + 最后更新。组件在页面渲染两份（桌面/移动），
	// 这里统一扫描所有 [data-site-footer]，重复初始化是安全的。
	function updateFooterStats() {
		const now = Date.now();
		const footers = document.querySelectorAll<HTMLElement>("[data-site-footer]");
		for (const footer of footers) {
			const startTs = Number(footer.dataset.startTs);
			const lastPostTs = Number(footer.dataset.lastPostTs);

			const runningEl = footer.querySelector<HTMLElement>("[data-footer-running-time]");
			if (runningEl && Number.isFinite(startTs) && startTs > 0) {
				const template = footer.dataset.runningTemplate || "";
				runningEl.textContent = formatRunningTime(
					template,
					Math.max(0, Math.floor((now - startTs) / 1_000)),
				);
			}

			const updateEl = footer.querySelector<HTMLElement>("[data-footer-last-update]");
			if (updateEl && Number.isFinite(lastPostTs) && lastPostTs > 0) {
				const days = Math.max(0, Math.floor((now - lastPostTs) / 86_400_000));
				const template = footer.dataset.updateTemplate || "";
				const today = footer.dataset.todayLabel || "";
				updateEl.textContent = days === 0 ? today : template.replace("{days}", days.toString());
			}
		}
	}

	function formatRunningTime(template: string, elapsedSeconds: number): string {
		const days = Math.floor(elapsedSeconds / 86_400);
		const hours = Math.floor((elapsedSeconds % 86_400) / 3_600);
		const minutes = Math.floor((elapsedSeconds % 3_600) / 60);
		const seconds = elapsedSeconds % 60;
		return template
			.replace("{days}", days.toString())
			.replace("{hours}", hours.toString())
			.replace("{minutes}", minutes.toString())
			.replace("{seconds}", seconds.toString());
	}

	// 签名描边动画（svg 放入 [data-footer-signature] 后自动生效）
	function initSignatureAnimation() {
		const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
		if (reducedMotion || !("IntersectionObserver" in window)) return;
		document.querySelectorAll<HTMLElement>("[data-site-footer]").forEach((footer) => {
			const signature = footer.querySelector("[data-footer-signature]");
			if (!signature || !signature.querySelector("svg")) return;
			footer.classList.add("is-signature-pending");
			const observer = new IntersectionObserver(
				(entries) => {
					if (!entries.some((entry) => entry.isIntersecting)) return;
					footer.classList.add("is-signature-drawn");
					observer.disconnect();
				},
				{ threshold: 0.35 },
			);
			observer.observe(signature);
		});
	}

	const win = window as unknown as { __siteFooterStatsInit?: boolean };
	if (!win.__siteFooterStatsInit) {
		win.__siteFooterStatsInit = true;
		updateFooterStats();
		window.setInterval(updateFooterStats, 1_000);
		initSignatureAnimation();
		// Swup 客户端导航后重新绑定新页面的签名动画
		document.addEventListener("astro:page-load", initSignatureAnimation);
	}
</script>

<style>
	/* 通栏色带：不用卡片边框，靠底色差与正文分隔（参考站做法）；
	   内容宽度上限 64rem 居中。100vw + 负外边距逃出父级限宽容器。 */
	:global(body) {
		overflow-x: clip; /* 防止 100vw 含滚动条宽度产生横向滚动 */
	}

	.site-footer {
		box-sizing: border-box;
		position: relative;
		left: 50%;
		width: 100vw;
		margin-left: -50vw;
		margin-top: 4rem;
		background: var(--paper); /* 与组件卡片同色 */
		color: var(--ink);
	}

	.site-footer__inner {
		box-sizing: border-box;
		width: 100%;
		max-width: 64rem;
		margin-inline: auto;
		padding: 3.5rem 1.5rem 2.5rem;
	}

	.site-footer__primary,
	.site-footer__lower {
		display: grid;
		grid-template-columns: minmax(0, 1.3fr) minmax(16rem, 0.7fr);
		gap: 2rem 4rem;
	}

	.site-footer__primary {
		align-items: center;
		min-height: 8rem;
	}

	.site-footer__brand {
		min-width: 0;
	}

	.site-footer__brand-copy {
		min-width: 0;
	}

	.site-footer__signature {
		display: block;
		min-height: 1px;
		/* 视觉左移：签名图片左侧有留白，负外边距抵消约一个字符宽 */
		margin-left: -1.5rem;
	}

	.site-footer__signature :global(svg) {
		display: block;
		width: min(100%, 20rem);
		height: auto;
		color: var(--ink);
	}

	.site-footer__signature:empty {
		display: none;
	}

	.site-footer__tagline {
		max-width: 34rem;
		margin: 0.5rem 0 0;
		color: var(--muted);
		font-size: 0.9375rem;
		line-height: 1.65;
	}

	.site-footer__signature:not(:empty) + .site-footer__tagline {
		margin-top: 0.75rem;
	}

	.site-footer__contact {
		justify-self: end;
		width: 100%;
		min-width: 0;
		text-align: right;
	}

	.site-footer__eyebrow {
		margin: 0 0 0.75rem;
		color: var(--muted);
		font-size: 0.9375rem;
		font-weight: 700;
		line-height: 1.35;
	}

	.site-footer__social-list {
		display: flex;
		flex-wrap: wrap;
		justify-content: flex-end;
		gap: 0.625rem;
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.site-footer__social-link {
		position: relative;
		display: grid;
		width: 2.75rem;
		height: 2.75rem;
		place-items: center;
		border: 1px solid var(--paper-dash);
		border-radius: 10px;
		background: transparent;
		color: var(--ink);
		text-decoration: none;
		transition:
			background-color 180ms ease,
			border-color 180ms ease,
			color 180ms ease;
	}

	.site-footer__social-link :global(svg) {
		width: 1.25rem;
		height: 1.25rem;
	}

	.site-footer__social-link::after {
		position: absolute;
		bottom: calc(100% + 0.5rem);
		left: 50%;
		padding: 0.25rem 0.5rem;
		border-radius: 6px;
		background: var(--ink);
		color: var(--paper);
		content: attr(data-tooltip);
		font-size: 0.75rem;
		line-height: 1.3;
		white-space: nowrap;
		opacity: 0;
		pointer-events: none;
		transform: translate(-50%, 0.25rem);
		transition:
			opacity 180ms ease,
			transform 180ms ease,
			visibility 180ms ease;
		visibility: hidden;
	}

	.site-footer__social-link:hover,
	.site-footer__social-link:focus-visible {
		border-color: var(--fp-accent);
		background: var(--color-accent-soft);
	}

	.site-footer__social-link:hover::after,
	.site-footer__social-link:focus-visible::after {
		opacity: 1;
		transform: translate(-50%, 0);
		visibility: visible;
	}

	.site-footer__social-link:focus-visible,
	.site-footer__utility-links a:focus-visible,
	.site-footer__utility-button:focus-visible,
	.site-footer__beian a:focus-visible,
	.site-footer__powered-by a:focus-visible {
		outline: 2px solid var(--fp-accent);
		outline-offset: 3px;
	}

	.site-footer__utility-links,
	.site-footer__beian {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.5rem;
	}

	.site-footer__utility-links {
		justify-content: flex-end;
		margin-top: 0.875rem;
		color: var(--muted);
		font-size: 0.875rem;
		line-height: 1.5;
	}

	.site-footer__utility-links a,
	.site-footer__utility-button,
	.site-footer__beian a,
	.site-footer__powered-by a {
		border: 0;
		background: transparent;
		color: inherit;
		cursor: pointer;
		font: inherit;
		padding: 0;
		text-decoration: none;
		transition: color 180ms ease;
	}

	.site-footer__powered-by a {
		color: var(--fp-accent-strong);
		font-weight: 700;
		text-decoration: underline;
		text-decoration-thickness: 1px;
		text-underline-offset: 0.2em;
	}

	.site-footer__utility-links a:hover,
	.site-footer__utility-button:hover,
	.site-footer__beian a:hover,
	.site-footer__powered-by a:hover {
		color: var(--fp-accent-strong);
	}

	.site-footer__lower {
		margin-top: 2rem;
		padding-top: 2rem;
		border-top: 1px solid var(--paper-line);
	}

	.site-footer__legal,
	.site-footer__status {
		display: flex;
		flex-direction: column;
		gap: 0.75rem;
		min-width: 0;
	}

	.site-footer__copyright-row {
		display: flex;
		flex-wrap: wrap;
		align-items: baseline;
		gap: 0.5rem;
	}

	.site-footer__copyright,
	.site-footer__status-line,
	.site-footer__powered-by {
		margin: 0;
		font-size: 0.9375rem;
		line-height: 1.5;
	}

	.site-footer__copyright {
		font-weight: 700;
	}

	.site-footer__copyright-divider {
		color: var(--muted);
	}

	.site-footer__beian,
	.site-footer__powered-by {
		color: var(--muted);
	}

	.site-footer__powered-by {
		display: inline-flex;
		align-items: baseline;
		gap: 0.25rem;
	}

	.site-footer__beian a {
		display: inline-flex;
		align-items: center;
		gap: 0.375rem;
	}

	/* 备案官方图标：按备案局要求高约 20px，随行内文字对齐 */
	.site-footer__beian img {
		width: auto;
		height: 1.25rem;
		object-fit: contain;
	}

	.site-footer__status {
		align-items: flex-end;
		text-align: right;
	}

	.site-footer__status-line {
		display: inline-flex;
		align-items: center;
		justify-content: flex-end;
		gap: 0.375rem;
		color: var(--muted);
	}

	.site-footer__status-line :global(svg) {
		width: 1rem;
		height: 1rem;
		flex: 0 0 auto;
	}

	/* 签名笔画动画（参考站同款 mask 描边法：
	   mask 白描边作为笔迹窗口，墨迹从窗口中露出，一条 1.2s 动画画完） */
	.site-footer.is-signature-pending :global(.site-footer__signature-mask) {
		stroke-dasharray: 1 1;
		stroke-dashoffset: 1;
	}

	.site-footer.is-signature-pending :global(.site-footer__signature-dot) {
		opacity: 0;
	}

	.site-footer.is-signature-pending.is-signature-drawn :global(.site-footer__signature-mask) {
		animation: site-footer-signature-draw 1.2s cubic-bezier(0.35, 0, 0.15, 1) forwards;
	}

	.site-footer.is-signature-pending.is-signature-drawn :global(.site-footer__signature-dot) {
		animation: site-footer-signature-dot 200ms ease-out 1.05s forwards;
	}

	@keyframes site-footer-signature-draw {
		to {
			stroke-dashoffset: 0;
		}
	}

	@keyframes site-footer-signature-dot {
		to {
			opacity: 1;
		}
	}

	@media (max-width: 768px) {
		.site-footer {
			margin-top: 3rem;
		}

		.site-footer__inner {
			padding: 3rem 1rem 2rem;
		}

		.site-footer__primary,
		.site-footer__lower {
			grid-template-columns: minmax(0, 1fr);
			gap: 2rem;
		}

		.site-footer__primary {
			min-height: 0;
		}

		.site-footer__contact {
			justify-self: start;
			text-align: left;
		}

		.site-footer__social-list,
		.site-footer__utility-links {
			justify-content: flex-start;
		}

		.site-footer__lower {
			margin-top: 1.5rem;
			padding-top: 1.5rem;
		}

		.site-footer__status {
			align-items: flex-start;
			text-align: left;
		}

		.site-footer__status-line {
			justify-content: flex-start;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.site-footer__social-link,
		.site-footer__social-link::after,
		.site-footer__utility-links a,
		.site-footer__utility-button,
		.site-footer__beian a,
		.site-footer__powered-by a {
			transition: none;
		}

		.site-footer.is-signature-pending :global(.site-footer__signature-mask) {
			stroke-dasharray: none;
			stroke-dashoffset: 0;
			animation: none;
		}

		.site-footer.is-signature-pending :global(.site-footer__signature-dot) {
			opacity: 1;
			animation: none;
		}
	}
</style>
