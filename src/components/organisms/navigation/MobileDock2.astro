---
import { Icon } from "astro-icon/components";
import { announcementConfig, navBarConfig } from "@/config";
import { LinkPresets } from "@/constants/link-presets";
import type { LinkPreset, NavBarLink } from "@/types/config";
import { url } from "@/utils/url-utils";
import FabMusicPanel from "@/components/widgets/music-player/FabMusicPanel.svelte";

const resolveLink = (link: NavBarLink | LinkPreset): NavBarLink => typeof link === "number" ? LinkPresets[link] : link;
const links = navBarConfig.links.map(resolveLink).map((link) => ({ ...link, children: link.children?.map(resolveLink) }));
const announcementEntries = Array.isArray(announcementConfig.content) ? announcementConfig.content : [announcementConfig.content];
const announcements = announcementEntries.map((entry) => typeof entry === "string" ? { title: entry, content: entry, link: announcementConfig.link } : { title: entry.content, content: entry.content, link: entry.link ?? announcementConfig.link });
const mobileName = (name: string) => name === "Links" ? "链接" : name === "My" ? "我的" : name === "About" ? "关于" : name === "Others" ? "其他" : name === "Devices" ? "设备" : name === "Timeline" ? "时间线" : name;
const siteTitle = "YuJing的记忆终端";
const siteIcon = "/favicon/avatar-icon.png";
---
<div class="mobile-dock__overlay" id="mobile-dock-overlay" aria-hidden="true"></div>
<section class="mobile-dock" id="mobile-dock" data-state="pill" data-view="menu" aria-label="移动端导航">
  <div class="mobile-dock__bar"><div class="mobile-dock__context"><a class="mobile-dock__site-mark" href={url("/")} aria-label={siteTitle}><img src={siteIcon} alt="" /></a><button class="mobile-dock__context-action" id="mobile-dock-context-btn" type="button" aria-label={siteTitle}><span class="mobile-dock__back-mark" aria-hidden="true"><Icon name="material-symbols:arrow-back-rounded" is:inline /></span><span class="mobile-dock__context-viewport"><span class="mobile-dock__site-title" id="mobile-dock-site-title">{siteTitle}</span><span class="mobile-dock__view-title" id="mobile-dock-view-title">菜单</span></span></button></div><button class="mobile-dock__menu-toggle" id="mobile-dock-menu-btn" type="button" aria-label="菜单" aria-controls="mobile-dock-card" aria-expanded="false"><span class="mobile-dock__menu-icon"><Icon name="material-symbols:menu-rounded" is:inline /></span><span class="mobile-dock__close-icon"><Icon name="material-symbols:close-rounded" is:inline /></span></button></div>
  <div class="mobile-dock__card" id="mobile-dock-card" aria-hidden="true"><div class="mobile-dock__card-inner" tabindex="-1"><div class="mobile-dock__views">
    <section class="mobile-dock__view is-active" data-dock-view="menu"><nav class="mobile-dock__menu" aria-label="导航菜单">{links.map((link, index) => link.children?.length ? <div class="mobile-dock__accordion" data-dock-accordion><button class="mobile-dock__menu-row mobile-dock__accordion-trigger" type="button" aria-expanded="false" aria-controls={`mobile-dock-submenu-${index}`}><span class="mobile-dock__menu-row-main">{link.icon && <Icon name={link.icon} is:inline />}<span>{mobileName(link.name)}</span></span><Icon name="material-symbols:keyboard-arrow-down-rounded" is:inline class="mobile-dock__accordion-arrow" /></button><div class="mobile-dock__submenu" id={`mobile-dock-submenu-${index}`} aria-hidden="true" inert><div class="mobile-dock__submenu-inner">{link.children.map((child) => child.action ? <button class="mobile-dock__submenu-row" type="button" data-action={child.action}>{child.icon && <Icon name={child.icon} is:inline />}<span>{mobileName(child.name)}</span></button> : <a class="mobile-dock__submenu-row" href={child.external ? child.url : url(child.url)} target={child.external ? "_blank" : undefined} rel={child.external ? "noopener noreferrer" : undefined} data-dock-navigation>{child.icon && <Icon name={child.icon} is:inline />}<span>{mobileName(child.name)}</span>{child.external && <Icon name="fa7-solid:arrow-up-right-from-square" is:inline class="mobile-dock__external-icon" />}</a>)}</div></div></div> : link.action ? <button class="mobile-dock__menu-row" type="button" data-action={link.action}><span class="mobile-dock__menu-row-main">{link.icon && <Icon name={link.icon} is:inline />}<span>{mobileName(link.name)}</span></span></button> : <a class="mobile-dock__menu-row" href={link.external ? link.url : url(link.url)} target={link.external ? "_blank" : undefined} rel={link.external ? "noopener noreferrer" : undefined} data-dock-navigation><span class="mobile-dock__menu-row-main">{link.icon && <Icon name={link.icon} is:inline />}<span>{mobileName(link.name)}</span></span>{link.external && <Icon name="fa7-solid:arrow-up-right-from-square" is:inline class="mobile-dock__external-icon" />}</a>)}</nav></section>
    <section class="mobile-dock__view" data-dock-view="announcement" hidden><div class="mobile-dock__announcement-list">{announcements.map((item) => <details class="mobile-dock__announcement"><summary><span class="mobile-dock__announcement-main"><span class="mobile-dock__announcement-tag">公告</span><strong>{item.title}</strong></span><Icon name="material-symbols:keyboard-arrow-down-rounded" is:inline class="mobile-dock__accordion-arrow" /></summary><div class="mobile-dock__announcement-content"><p>{item.content}</p>{item.link?.enable && <a href={/^https?:\/\//.test(item.link.url) ? item.link.url : url(item.link.url)} target={item.link.external ? "_blank" : undefined} rel={item.link.external ? "noopener noreferrer" : undefined}>{item.link.text}</a>}</div></details>)}</div></section>
    <section class="mobile-dock__view mobile-dock__toc-view" data-dock-view="toc" hidden><div class="mobile-dock__toc-list" id="mobile-dock-toc-list"></div></section>
    <section class="mobile-dock__view mobile-dock__music-view" data-dock-view="music" hidden><FabMusicPanel client:load /></section>
  </div><nav class="mobile-dock__toolbar" aria-label="快捷工具">
    <button type="button" id="mobile-dock-search-btn"><Icon name="material-symbols:search-rounded" is:inline /><span>搜索</span></button>
    <button type="button" id="mobile-dock-theme-btn"><Icon name="material-symbols:wb-sunny-outline-rounded" is:inline /><span>主题</span></button>
    <button type="button" id="mobile-dock-guestbook-btn"><Icon name="material-symbols:chat-bubble-outline-rounded" is:inline /><span>留言板</span></button>
    <button type="button" id="mobile-dock-music-btn"><Icon name="material-symbols:music-note-rounded" is:inline /><span>音乐</span></button>
    <button type="button" id="mobile-dock-toc-btn"><Icon name="material-symbols:list-alt-rounded" is:inline /><span>目录</span></button>
    <button type="button" id="mobile-dock-comments-btn"><Icon name="material-symbols:chat-rounded" is:inline /><span>评论</span></button>
    <button type="button" id="mobile-dock-announcement-btn"><Icon name="material-symbols:notifications-outline-rounded" is:inline /><span>公告</span></button>
    <button type="button" id="mobile-dock-top-btn"><Icon name="material-symbols:keyboard-arrow-up-rounded" is:inline /><span>顶部</span></button>
  </nav></div></div>
</section>
<script>
  import { requestSearchModalToggle } from "@/utils/search-modal-controller";
  import { getStoredTheme, setTheme } from "@/utils/setting-utils";
  import { guestbookWidgetStore } from "@/stores/guestbookWidgetStore";
  import { musicPlayerStore } from "@/stores/musicPlayerStore";
  const dock = document.getElementById("mobile-dock"); const card = document.getElementById("mobile-dock-card"); const overlay = document.getElementById("mobile-dock-overlay"); const menuButton = document.getElementById("mobile-dock-menu-btn"); const contextButton = document.getElementById("mobile-dock-context-btn"); const viewTitle = document.getElementById("mobile-dock-view-title"); const siteTitleNode = document.getElementById("mobile-dock-site-title"); const siteTitle = "YuJing的记忆终端"; const guestbookButton = document.getElementById("mobile-dock-guestbook-btn"); const tocButton = document.getElementById("mobile-dock-toc-btn"); const commentsButton = document.getElementById("mobile-dock-comments-btn"); const announcementButton = document.getElementById("mobile-dock-announcement-btn");
  if (dock && card && overlay && menuButton && contextButton && viewTitle) {
    let isArticle = false; let state: "pill" | "bubble" | "card" = "pill"; let activeView = "menu"; let lastScrollY = window.scrollY;
    const syncPageTools = () => { isArticle = !!document.getElementById("post-container"); tocButton?.style.setProperty("display", isArticle ? "flex" : "none"); commentsButton?.style.setProperty("display", isArticle ? "flex" : "none"); announcementButton?.style.setProperty("display", isArticle ? "none" : "flex"); if (!isArticle && activeView === "toc") setView("menu"); };
    const setState = (next: typeof state) => { state = next; dock.dataset.state = next; const open = next === "card"; card.setAttribute("aria-hidden", String(!open)); menuButton.setAttribute("aria-expanded", String(open)); overlay.classList.toggle("is-open", open); overlay.setAttribute("aria-hidden", String(!open)); document.body.style.overflow = open ? "hidden" : ""; };
    const buildToc = () => { const list = document.getElementById("mobile-dock-toc-list"); if (!list) return; const headings = Array.from(document.querySelectorAll("#post-container h1, #post-container h2, #post-container h3, #post-container h4, #post-container h5, #post-container h6")); list.innerHTML = ""; if (!headings.length) { list.innerHTML = '<p class="mobile-dock__toc-empty">暂无目录</p>'; return; } headings.forEach((heading, index) => { if (!heading.id) heading.id = `mobile-dock-heading-${index}`; const a = document.createElement("a"); a.href = `#${heading.id}`; a.className = `mobile-dock__toc-row mobile-dock__toc-level-${heading.tagName.slice(1)}`; a.textContent = heading.textContent?.trim() || `章节 ${index + 1}`; a.addEventListener("click", () => setState("pill")); list.appendChild(a); }); };
    const setView = (view: string) => { const target = dock.querySelector<HTMLElement>(`[data-dock-view="${view}"]`); if (!target) return; activeView = view; dock.dataset.view = view; dock.querySelectorAll<HTMLElement>("[data-dock-view]").forEach((item) => { const active = item === target; item.hidden = !active; item.classList.toggle("is-active", active); }); viewTitle.textContent = view === "announcement" ? "公告" : view === "toc" ? "目录" : view === "music" ? "音乐" : "菜单"; dock.classList.toggle("is-child-view", view !== "menu"); if (view === "toc") buildToc(); };
    syncPageTools(); document.addEventListener("astro:page-load", syncPageTools);
    menuButton.addEventListener("click", () => setState(state === "card" ? "pill" : "card")); contextButton.addEventListener("click", () => { if (state === "card" && activeView !== "menu") setView("menu"); else if (state === "bubble") setState("pill"); }); overlay.addEventListener("click", () => setState("pill"));
    dock.querySelectorAll<HTMLElement>("[data-dock-accordion]").forEach((accordion) => { const trigger = accordion.querySelector<HTMLButtonElement>(".mobile-dock__accordion-trigger"); const submenu = accordion.querySelector<HTMLElement>(".mobile-dock__submenu"); trigger?.addEventListener("click", () => { const open = !accordion.classList.contains("is-open"); dock.querySelectorAll<HTMLElement>("[data-dock-accordion]").forEach((other) => { if (other !== accordion) { other.classList.remove("is-open"); other.querySelector(".mobile-dock__accordion-trigger")?.setAttribute("aria-expanded", "false"); const panel = other.querySelector<HTMLElement>(".mobile-dock__submenu"); if (panel) panel.inert = true; } }); accordion.classList.toggle("is-open", open); trigger?.setAttribute("aria-expanded", String(open)); if (submenu) submenu.inert = !open; }); });
    dock.querySelectorAll<HTMLElement>("[data-dock-navigation]").forEach((link) => link.addEventListener("click", () => setState("pill"))); dock.querySelectorAll<HTMLElement>("[data-action]").forEach((button) => button.addEventListener("click", () => { const action = button.dataset.action; if (action) window.dispatchEvent(new CustomEvent(action)); setState("pill"); }));
    document.getElementById("mobile-dock-search-btn")?.addEventListener("click", () => { setState("pill"); requestSearchModalToggle(); }); document.getElementById("mobile-dock-theme-btn")?.addEventListener("click", () => { const current = getStoredTheme() as string; const resolved = current === "system" ? (document.documentElement.classList.contains("dark") ? "dark" : "light") : current; setTheme(resolved === "light" ? "dark" : "light"); }); guestbookButton?.addEventListener("click", () => { setState("pill"); guestbookWidgetStore.toggle(); }); tocButton?.addEventListener("click", () => { if (isArticle) { setState("card"); setView("toc"); } }); document.getElementById("mobile-dock-music-btn")?.addEventListener("click", () => { if (activeView === "music" && state === "card") setView("menu"); else { setState("card"); setView("music"); } }); commentsButton?.addEventListener("click", () => { if (isArticle) { setState("pill"); document.getElementById("comments")?.scrollIntoView({ behavior: "smooth", block: "start" }); } }); announcementButton?.addEventListener("click", () => { setView("announcement"); setState("card"); }); document.getElementById("mobile-dock-top-btn")?.addEventListener("click", () => { setState("pill"); window.scrollTo({ top: 0, behavior: "smooth" }); });
    const unsubscribeMusic = musicPlayerStore.subscribe((nextState) => { const lyric = nextState.lyrics[nextState.currentLrcIndex]?.text?.trim(); if (siteTitleNode) siteTitleNode.textContent = lyric || siteTitle; }); window.addEventListener("beforeunload", () => unsubscribeMusic(), { once: true }); window.addEventListener("scroll", () => { if (state === "card") return; const y = window.scrollY; if (y - lastScrollY > 8 && y > 80) setState("bubble"); else if (lastScrollY - y > 8) setState("pill"); lastScrollY = y; }, { passive: true }); document.addEventListener("keydown", (event) => { if (event.key === "Escape" && state === "card") setState("pill"); });
  }
</script>