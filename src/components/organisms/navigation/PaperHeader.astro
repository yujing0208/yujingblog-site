---
/**
 * PaperHeader —— FlatPaper 的 .site-header（内页导航）
 *
 * 1:1 对照 hexo-theme-flatpaper：
 *   结构 = layout/_partial/header.ejs（汉堡 + brand + site-nav + header-tools）
 *   样式 = styles/paper-header.css（main.css 已引入）+ paper-responsive.css 移动端段
 *   行为 = public/js/paper-header.js（brand 菜单 / site-nav 下拉 / accent / Esc）
 *
 * 与 flatpaper 的两处必要差异（本站基建差异，非视觉差异）：
 *   1. 搜索：flatpaper 是独立搜索弹层；本站复用 Search 组件（pagefind），
 *      组件本体藏在 .paper-search-carrier（只渲染浮层），.js-search-open 转发点击。
 *   2. 主题切换：flatpaper 的 .theme-toggle 由 main.js 自行切类（会漏掉本站
 *      代码块 data-theme 同步）；这里转发给 ThemeSwitch（#scheme-switch），
 *      与全站主题链路（localStorage/data-theme/view transition）完全一致。
 *
 * 移动端：flatpaper 960px 以下导航进抽屉；本站内页无抽屉结构，汉堡按钮改为
 * 开合 NavMenuPanel（全站链接面板，与原 Navbar 移动端能力等价）。
 */
import { Icon } from "astro-icon/components";

import { navBarConfig, siteConfig } from "../../../config";
import type { NavBarLink } from "../../../types/config";
import { url } from "../../../utils/url-utils";
import MobileTOC from "../../features/toc/MobileTOC.svelte";
import ThemeSwitch from "../../control/ThemeSwitch.svelte";
import NavMenuPanel from "./NavMenuPanel.astro";
import PaperAccentPicker from "./PaperAccentPicker.astro";
import Search from "./Search.svelte";

const currentPath = Astro.url.pathname;

// featurePage URL -> config key mapping（与 Navbar.astro 保持一致）
const featurePageUrlMap: Record<string, string> = {
	"/albums/": "albums",
	"/anime/": "anime",
	"/diary/": "diary",
	"/friends/": "friends",
	"/websites/": "friends",
	"/projects/": "projects",
	"/skills/": "skills",
	"/timeline/": "timeline",
	"/devices/": "devices",
	"/changelog/": "changelog",
	"/notebooks/": "notebooks",
};

function isFeaturePageDisabled(linkUrl: string): boolean {
	const key = featurePageUrlMap[linkUrl];
	if (
		key &&
		!siteConfig.featurePages[key as keyof typeof siteConfig.featurePages]
	) {
		return true;
	}
	return false;
}

function resolveLink(item: NavBarLink): NavBarLink | null {
	if (isFeaturePageDisabled(item.url)) return null;
	return item;
}

function filterLinksByFeaturePages(items: NavBarLink[]): NavBarLink[] {
	return items
		.map(resolveLink)
		.filter((item): item is NavBarLink => item !== null)
		.map((item) => {
			if (item.children) {
				const filteredChildren = item.children
					.map(resolveLink)
					.filter((child): child is NavBarLink => child !== null);
				return { ...item, children: filteredChildren };
			}
			return item;
		})
		.filter((item) => !item.children || item.children.length > 0);
}

const links: NavBarLink[] = filterLinksByFeaturePages(navBarConfig.links);

const isActive = (href: string) => {
	// 参考 FlatPaper scripts/menu-helpers.js 的 active()：
	// # 锚点与外部链接（含 scheme: 或 //）不参与 active 判定，
	// 否则会被错误地解析成根路径 "/" 而误命中首页（与客户端 isActivePath 保持一致）。
	const raw = String(href || "").trim();
	if (!raw || raw.charAt(0) === "#" || /^(?:[a-z][a-z0-9+.-]*:|\/\/)/i.test(raw))
		return false;
	const path = href === "/" ? "/" : url(href);
	if (path === "/") return currentPath === "/" || currentPath === "";
	return currentPath.startsWith(path);
};

const brandTitle = siteConfig.title || "FlatPaper";

// 顶栏品牌区「找到我」下拉：读 navbar 自己的 brandMenu，
// 不再共用 profileConfig.links（那是个人名片 / 首屏的社交链接）。
const brandMenu = navBarConfig.brandMenu ?? [];
// astro-icon 的 sprite 白名单由构建期扫描 src/ 里的静态字面量生成；
// 品牌菜单的图标名来自配置（运行时变量），这里以字面量罗列一次保证被收集。
const BRAND_MENU_ICON_MANIFEST = ["lucide:pen-line"];
void BRAND_MENU_ICON_MANIFEST;
---

<header class="site-header">
	<!-- 汉堡：移动端开合 NavMenuPanel（flatpaper 为侧栏抽屉） -->
	<button
		class="icon-button js-sidebar-toggle sidebar-toggle"
		type="button"
		aria-label="打开菜单"
		aria-controls="nav-menu-panel"
		aria-expanded="false"
	>
		<Icon name="lucide:menu" is:inline />
	</button>

	<div class="brand">
		<div class="brand-mark-wrapper">
			<button
				class="brand-mark"
				type="button"
				aria-label="快捷菜单"
				aria-haspopup="true"
				aria-expanded="false"
				aria-controls="brand-nav-menu"
			>
				<Icon name="lucide:layout-grid" is:inline />
			</button>
			<div class="brand-nav-menu" id="brand-nav-menu" role="menu">
				<div class="brand-nav-group">
					<div class="brand-nav-title">找到我</div>
					{
						brandMenu.map((link) => (
							<a
								role="menuitem"
								href={link.url}
								target="_blank"
								rel="noopener noreferrer"
							>
								{link.icon && <Icon name={link.icon} is:inline />}
								<span>{link.name}</span>
							</a>
						))
					}
				</div>
			</div>
		</div>
		<a class="brand-text" href={url("/")}>{brandTitle}</a>
	</div>

	<nav class="site-nav" aria-label="主导航">
		{
			links.map((l) => {
				const active = isActive(l.url);
				if (l.children && l.children.length > 0) {
					const childActive = l.children.some((c) => isActive(c.url));
					return (
						<div class:list={["site-nav-item", "has-children", { active: active || childActive }]}>
							<button
								class="site-nav-link site-nav-parent"
								type="button"
								aria-haspopup="true"
								aria-expanded="false"
							>
								{l.icon && <Icon name={l.icon} is:inline />}
								<span>{l.name}</span>
							</button>
							<div class="site-nav-menu" role="menu">
								{l.children.map((c) => {
									const cActive = isActive(c.url);
									const cHref = c.external ? c.url : url(c.url);
									return (
										<a
											role="menuitem"
											class:list={[{ active: cActive }]}
											href={cHref}
											target={c.external ? "_blank" : null}
											rel={c.external ? "noopener noreferrer" : null}
											{...(cHref === "/music/" ? { "data-swup-ignore": true } : {})}
										>
											{c.icon && <Icon name={c.icon} is:inline />}
											<span>{c.name}</span>
										</a>
									);
								})}
							</div>
						</div>
					);
				}
				const href = l.external ? l.url : url(l.url);
				return (
					<a
						class:list={["site-nav-link", { active }]}
						href={href}
						target={l.external ? "_blank" : null}
						rel={l.external ? "noopener noreferrer" : null}
						{...(href === "/music/" ? { "data-swup-ignore": true } : {})}
					>
						{l.icon && <Icon name={l.icon} is:inline />}
						<span>{l.name}</span>
					</a>
				);
			})
		}
	</nav>

	<div class="header-tools">
		<button
			class="icon-button js-search-open"
			type="button"
			aria-label="搜索文章"
		>
			<Icon name="lucide:search" is:inline />
		</button>
		{
			siteConfig.toc.enable && siteConfig.toc.mobileTop && (
				<MobileTOC client:only="svelte" />
			)
		}
		<PaperAccentPicker defaultAccent="green" />
		<button
			class="theme-toggle"
			type="button"
			aria-label="切换明暗模式"
		>
			<span class="theme-icon theme-icon--sun">
				<Icon name="lucide:sun" is:inline />
			</span>
			<span class="theme-icon theme-icon--moon">
				<Icon name="lucide:moon" is:inline />
			</span>
		</button>

		<!-- 搜索 / 主题切换的隐藏载体：只借它们的浮层与状态管理 -->
		<div class="paper-search-carrier" aria-hidden="true">
			<Search client:only="svelte" />
		</div>
		<div class="paper-theme-carrier" aria-hidden="true">
			<ThemeSwitch client:only="svelte" />
		</div>
	</div>

	<NavMenuPanel links={links} />
</header>

<style is:global>
	/* 隐藏载体：Search 的浮层（#search-panel）与 MobileTOC 浮层是 absolute
	   定位，需保留在布局内；仅隐藏其按钮本体。⚠️ 不能用 display:none 挂在
	   载体容器上——那会把浮层一起藏掉。
	   2026-10-01：client:only 组件实际包在 astro-island（display:contents）里，
	   原 `> div:first-child / > button` 匹配不到（隔了一层），导致桌面搜索按钮
	   (#search-bar) 漏出来叠在导航下缘；补 astro-island 路径。 */
	.paper-search-carrier,
	.paper-theme-carrier {
		position: absolute;
		width: 0;
		height: 0;
		overflow: visible;
	}
	.paper-search-carrier > div:first-child,
	.paper-search-carrier > button,
	.paper-search-carrier astro-island > div:first-child,
	.paper-search-carrier astro-island > button,
	.paper-theme-carrier > button,
	.paper-theme-carrier astro-island > button {
		display: none !important;
	}
	/* 窄屏 CSS 给 .site-header 定宽（min(94vw,760px)），补居中 */
	.site-header {
		margin-inline: auto;
	}
</style>

<script is:inline>
	(function () {
		"use strict";

		/* ---------------- 导航高亮（记号笔）跟随当前页 ----------------
		 * 2026-10-06：原先 active 类只在构建期按 Astro.url.pathname 渲染一次。
		 * 但 #navbar-wrapper 在 <main> 之外、Swup 跨页不替换它，
		 * 于是「记号笔」会一直停在离开时的那一项上。
		 * 现在每次换页用 DOM 里的链接 href 重新判定 active，
		 * 前缀匹配规则与构建期 isActive() 保持一致。
		 */
		function normalizePath(p) {
			var path = String(p || "").split("#")[0].split("?")[0];
			if (!path) return "/";
			// 补尾斜杠，使 /archive 与 /archive/ 判定一致
			if (path.length > 1 && !/\/$/.test(path)) path += "/";
			return path;
		}

		function isActivePath(href, currentPath) {
			if (!href) return false;
			// 参考 FlatPaper scripts/menu-helpers.js 的 active()：
			// # 锚点与外部链接（含 scheme: 或 //）不参与 active 判定，
			// 否则 new URL(external, location).pathname 会解析成 "/" 而误命中首页。
			var raw = String(href || "").trim();
			if (raw.charAt(0) === "#" || /^(?:[a-z][a-z0-9+.-]*:|\/\/)/i.test(raw))
				return false;
			var target;
			try {
				target = normalizePath(new URL(href, window.location.href).pathname);
			} catch (e) {
				return false;
			}
			if (target === "/") return currentPath === "/" || currentPath === "";
			return currentPath === target || currentPath.indexOf(target) === 0;
		}

		function syncNavActiveState() {
			var currentPath = normalizePath(window.location.pathname);
			var nav = document.querySelector("#navbar-wrapper .site-nav");
			if (!nav) return;

			// 下拉里的子项
			nav.querySelectorAll(".site-nav-menu a").forEach(function (link) {
				link.classList.toggle("active", isActivePath(link.getAttribute("href"), currentPath));
			});

			// 顶层导航项：自身有 href 用自身判定；带下拉的用「子项命中」判定
			nav.querySelectorAll(":scope > .site-nav-link, :scope > .site-nav-item").forEach(function (item) {
				if (item.classList.contains("site-nav-item")) {
					item.classList.toggle("active", item.querySelector(".site-nav-menu a.active") !== null);
					return;
				}
				item.classList.toggle("active", isActivePath(item.getAttribute("href"), currentPath));
			});
		}

		function bindOnce(selector, handler) {
			document.querySelectorAll(selector).forEach(function (btn) {
				// 预占 paper-header.js 的绑定标记：三个按钮的转发逻辑由本脚本负责，
				// 避免 public/js/paper-header.js 的通用实现（抽屉/裸切类）二次绑定。
				if (btn.dataset.paperBound) return;
				btn.dataset.paperBound = "1";
				btn.addEventListener("click", handler);
			});
		}

		// 汉堡 → 移动端菜单面板（NavMenuPanel）
		bindOnce(".js-sidebar-toggle", function () {
			var panel = document.getElementById("nav-menu-panel");
			if (!panel) return;
			var willOpen = panel.classList.contains("float-panel-closed");
			panel.classList.toggle("float-panel-closed", !willOpen);
			document
				.querySelectorAll(".js-sidebar-toggle")
				.forEach(function (b) {
					b.setAttribute("aria-expanded", willOpen ? "true" : "false");
				});
		});

		// 搜索 → 打开 flatpaper 同款搜索弹窗，由 public/js/paper-search.js 全局接管
		// （document capture 阶段委托，事件到不了这里的按钮级监听）。
		// 保留一个空绑定占位：预占 dataset.paperBound 标记，防止 public/js/paper-header.js
		// 的旧转发逻辑（search-container/search-bar，指向已弃用的 Mizuki Search 浮层）抢绑。
		bindOnce(".js-search-open", function () {});

		// 主题 → 转发给 ThemeSwitch（保证 data-theme/localStorage/过渡一致）
		bindOnce(".theme-toggle", function () {
			var sw = document.getElementById("scheme-switch");
			if (sw) sw.click();
		});

		// 点外部关闭移动端菜单面板
		if (!document.documentElement.dataset.paperMenuOutside) {
			document.documentElement.dataset.paperMenuOutside = "1";
			document.addEventListener("click", function (event) {
				var panel = document.getElementById("nav-menu-panel");
				if (!panel || panel.classList.contains("float-panel-closed"))
					return;
				if (
					event.target.closest &&
					(event.target.closest("#nav-menu-panel") ||
						event.target.closest(".js-sidebar-toggle"))
				)
					return;
				panel.classList.add("float-panel-closed");
				document.querySelectorAll(".js-sidebar-toggle").forEach(function (b) {
					b.setAttribute("aria-expanded", "false");
				});
			});
			// Esc 关闭移动端菜单面板（paper-header.js 的 Esc 管不到它）
			document.addEventListener("keydown", function (event) {
				if (event.key !== "Escape") return;
				var panel = document.getElementById("nav-menu-panel");
				if (panel) panel.classList.add("float-panel-closed");
			});
		}

		// 首帧同步一次（SSR 渲染的 active 本就正确，这里覆盖直接改地址栏/回退的情况）
		syncNavActiveState();

		// Swup 换页后重算；popstate 覆盖浏览器前进/后退
		if (!document.documentElement.dataset.navActiveBound) {
			document.documentElement.dataset.navActiveBound = "1";
			document.addEventListener("swup:content:replace", function () {
				setTimeout(syncNavActiveState, 0);
			});
			document.addEventListener("swup:page:view", function () {
				setTimeout(syncNavActiveState, 0);
			});
			window.addEventListener("popstate", function () {
				setTimeout(syncNavActiveState, 0);
			});
		}
	})();
</script>
