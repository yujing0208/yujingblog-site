---
import {
	expressiveCodeConfig,
	fullscreenWallpaperConfig,
	sakuraConfig,
	siteConfig,
} from "@/config";
import MobileDock from "@components/organisms/navigation/MobileDock2.astro";
---

<div
	id="config-carrier"
	data-hue={siteConfig.themeColor.hue}
	data-hide-code-blocks-during-transition={expressiveCodeConfig.hideDuringThemeTransition
		? "true"
		: "false"}
	data-overlay-opacity={fullscreenWallpaperConfig.overlay?.opacity ?? 0.8}
	data-overlay-blur={fullscreenWallpaperConfig.overlay?.blur ?? 10}
	data-overlay-card-opacity={fullscreenWallpaperConfig.overlay?.cardOpacity ?? 0.5}
	data-fullscreen-opacity={fullscreenWallpaperConfig.opacity ?? 0.8}
	data-fullscreen-blur={fullscreenWallpaperConfig.blur ?? 0}
	data-default-wallpaper-mode={siteConfig.wallpaperMode.defaultMode}
	data-sakura-enabled={sakuraConfig.enable ? "true" : "false"}
	data-waves-enabled={siteConfig.banner?.waves?.enable ? "true" : "false"}
	data-banner-title-enabled={siteConfig.banner?.homeText?.enable ? "true" : "false"}
	data-banner-carousel-enabled={siteConfig.banner?.carousel?.enable ? "true" : "false"}
>
</div>

<MobileDock />

<style is:global>
	@import "../../styles/components/mobile-dock.css";
	@import "../../styles/components/mobile-dock-article.css";
</style>

<script
	is:inline
	define:vars={{
		tocEnable: siteConfig.toc.enable,
		tocDepth: siteConfig.toc.depth,
		tocUseJapaneseBadge: siteConfig.toc.useJapaneseBadge,
	}}
>
	window.siteConfig = window.siteConfig || {};
	window.siteConfig.toc = {
		enable: tocEnable,
		depth: tocDepth,
		useJapaneseBadge: tocUseJapaneseBadge,
	};

	/* 竖屏 Dock 的滚动收缩：监听页面真正的滚动容器，避免 Astro/移动端滚动链导致 window.scroll 监听失效。 */
	(() => {
		let lastY = window.scrollY || document.documentElement.scrollTop || 0;
		let ticking = false;
		const getY = () => Math.max(0, window.scrollY || document.scrollingElement?.scrollTop || document.documentElement.scrollTop || 0);
		const sync = () => {
			ticking = false;
			const dock = document.getElementById("mobile-dock");
			if (!dock || !matchMedia("(max-width: 767px) and (orientation: portrait)").matches) return;
			if (dock.dataset.state === "card") return;
			const y = getY();
			const delta = y - lastY;
			if (delta > 4 && y > 48) {
				dock.dataset.state = "bubble";
				dock.querySelector("#mobile-dock-card")?.setAttribute("aria-hidden", "true");
			} else if (delta < -4) {
				dock.dataset.state = "pill";
		}
			lastY = y;
		};
		const onScroll = () => {
			if (!ticking) {
				ticking = true;
				requestAnimationFrame(sync);
			}
		};
		window.addEventListener("scroll", onScroll, { passive: true });
		document.addEventListener("scroll", onScroll, { passive: true, capture: true });
		window.addEventListener("touchstart", () => { lastY = getY(); }, { passive: true });
		window.addEventListener("touchmove", onScroll, { passive: true });
	})();

	console.log("TOC Config:", window.siteConfig.toc);
</script>
