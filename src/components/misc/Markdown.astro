---

interface Props {
	class: string;
}
const className = Astro.props.class;
---

<!-- 统一 MD 渲染：只保留 markdown-content（paper-markdown.css 一套），旧 prose / custom-md 层已移除 -->
<div
	data-pagefind-body
	class={`markdown-content ${className}`}
>
	<!--<div class="prose dark:prose-invert max-w-none custom-md">-->
	<!--<div class="max-w-none custom-md">-->
	<slot />
</div>

<script>
	/**
	 * FlatPaper 选项卡（flatpaper-tabs）交互
	 * 用事件委托挂在 document 上，Swup 换页后无需重新绑定。
	 * 标记 → 面板的三种状态：
	 *   点未激活项   → 激活该项（收起其它项）
	 *   点已激活项   → 若整块带 .is-collapsible，则收起该项（其余保持收起）
	 *   其余情况     → 保持至少一项展开
	 */
	document.addEventListener("click", function (e: MouseEvent) {
		const target = (e.target as Element | null)?.closest(
			".flatpaper-tabs__nav-item",
		) as HTMLElement | null;
		if (!target) return;

		const tabsRoot = target.closest(".flatpaper-tabs") as HTMLElement | null;
		if (!tabsRoot) return;

		const collapsible = tabsRoot.classList.contains("is-collapsible");
		const wasActive = target.classList.contains("is-active");

		const navItems = Array.from(
			tabsRoot.querySelectorAll<HTMLElement>(".flatpaper-tabs__nav-item"),
		);
		const panels = Array.from(
			tabsRoot.querySelectorAll<HTMLElement>(".flatpaper-tabs__panel"),
		);

		const activate = (index: number) => {
			navItems.forEach((item, i) => {
				const on = i === index;
				item.classList.toggle("is-active", on);
				item.setAttribute("aria-selected", String(on));
			});
			panels.forEach((panel, i) => {
				const on = i === index;
				panel.classList.toggle("is-active", on);
				if (on) {
					panel.removeAttribute("hidden");
				} else {
					panel.setAttribute("hidden", "");
				}
			});
			if (index >= 0) {
				tabsRoot.classList.remove("is-collapsible");
			}
		};

		const index = Number.parseInt(target.dataset.index ?? "0", 10);

		if (wasActive && collapsible) {
			// 折叠态下点当前项 = 全部收起
			activate(-1);
			tabsRoot.classList.add("is-collapsible");
			return;
		}

		if (wasActive && !collapsible) return;

		activate(index);
	});

	document.addEventListener("click", function (e: MouseEvent) {
		const target = e.target as Element | null;
		if (target && target.classList.contains("copy-btn")) {
			const codeEle = target.parentElement?.querySelector("code");

			// 精确的代码提取逻辑
			let code = "";
			if (codeEle) {
				// 获取所有代码行元素
				const lineElements = codeEle.querySelectorAll("span.line");
				if (lineElements.length > 0) {
					// 对于有行结构的代码块，精确处理每一行
					const lines: string[] = [];
					for (let i = 0; i < lineElements.length; i++) {
						const lineElement = lineElements[i];
						// 直接获取文本内容，不添加额外处理
						const lineText = lineElement.textContent || "";
						lines.push(lineText);
					}
					// 重要：使用 \n 连接行，而不是 \n\n 或其他方式
					code = lines.join("\n");
				} else {
					// 对于没有行结构的代码块
					const codeElements = codeEle.querySelectorAll(
						".code:not(summary *)",
					);
					if (codeElements.length > 0) {
						const lines: string[] = [];
						for (let i = 0; i < codeElements.length; i++) {
							const el = codeElements[i];
							const lineText = el.textContent || "";
							lines.push(lineText);
						}
						code = lines.join("\n");
					} else {
						// 最后回退到直接使用整个code元素的文本内容
						code = codeEle.textContent || "";
					}
				}
			}

			// 处理连续空行：改进的逻辑
			code = code.replace(/\n\n\n+/g, function (match) {
				// 计算连续换行符的数量
				const newlineCount = match.length;
				// 计算空行数量（换行符数量减1）
				const emptyLineCount = newlineCount - 1;

				// 偶数空行：除以2
				// 奇数空行：(空行数+1)/2 向下取整
				let resultEmptyLines: number;
				if (emptyLineCount % 2 === 0) {
					// 偶数
					resultEmptyLines = emptyLineCount / 2;
				} else {
					// 奇数
					resultEmptyLines = Math.floor((emptyLineCount + 1) / 2);
				}

				// 至少保留一个空行
				if (resultEmptyLines < 1) {
					resultEmptyLines = 1;
				}

				// 返回对应数量的换行符
				return "\n".repeat(resultEmptyLines + 1);
			});

			const copyToClipboard = async (text: string) => {
				if (!navigator.clipboard?.writeText) {
					throw new Error("Clipboard API 不可用");
				}

				await navigator.clipboard.writeText(text);
			};

			copyToClipboard(code)
				.then(() => {
					const timeoutId = target.getAttribute("data-timeout-id");
					if (timeoutId) {
						clearTimeout(parseInt(timeoutId));
					}

					target.classList.add("success");

					// 设置新的timeout并保存ID到按钮的自定义属性中
					const newTimeoutId = setTimeout(() => {
						target.classList.remove("success");
					}, 1000);

					target.setAttribute(
						"data-timeout-id",
						newTimeoutId.toString(),
					);
				})
				.catch((err) => {
					console.error("复制失败:", err);
					// 可以在这里添加用户提示
				});
		}
	});
</script>
