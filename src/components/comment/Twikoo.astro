---
import { commentConfig } from "@/config";

interface Props {
	path: string;
}

const config = {
	...commentConfig.twikoo,
	el: "#tcomment",
	path: Astro.props.path,
};

// 站长评论昵称统一显示（2026-10-01 定稿）：不隐藏、不改数据，仅前端把站长
// 评论的昵称（含「回复 @xxx」提及）统一改写为 YuJing。全站评论区生效。
// 识别依据：
//   · 头像哈希：站长邮箱 2803673194@qq.com（weavatar 线上同时出现 md5 与 sha256 两种形式）
//   · 昵称兜底：站长用过的「余京 / YuJing」马甲
const OWNER_NICKS = ["余京", "YuJing"];
const OWNER_AVATAR_HASHES = [
	"46d038eb362227469c0145d278dc3dbf",
	"9735dc7774c6444b2647f25b595d67d5668e1d0ad38aa11557f3a7a4954a1abb",
];
const OWNER_DISPLAY_NICK = "YuJing";
---

<div id="twikoo-container" class="twikoo-container">
	<div id="tcomment"></div>
</div>

<script is:inline define:vars={{ config, OWNER_NICKS, OWNER_AVATAR_HASHES, OWNER_DISPLAY_NICK }}>
	(function () {
		const TWIKOO_CONTAINER_ID = "twikoo-container";
		// ?v=1.7.14b —— 后缀 b 是「解冻标记」，不是上游版本号。
		// /assets/** 是 `max-age=31536000, immutable` 的一年缓存且**连 404 一起缓存**：
		// 2026-10-03 的 assets 覆盖事故把原来的 ?v=1.7.14 在 CDN 上冻成 404，
		// 修好源文件也回不来，换 URL 才能让浏览器重新取到脚本（否则评论区整块不加载）。
		const TWIKOO_SCRIPT_URL = "/assets/js/twikoo.all.min.js?v=1.7.14b";
		const ROOT_MARGIN = "200px";

		let observer = null;
		let twikooLoaded = false;
		let ownerRenameObserver = null;

		// ---- 站长评论昵称统一（全站生效）----
		function isOwnerNode(node) {
			if (!node || node.nodeType !== 1) return false;
			// 注意：.tk-comment 可能嵌套（回复在 .tk-replies 里），
			// querySelector 取到的第一个头像/昵称一定是该评论自己的
			const avatar = node.querySelector(".tk-avatar img");
			const src = avatar ? avatar.getAttribute("src") || "" : "";
			for (const hash of OWNER_AVATAR_HASHES) {
				if (src.indexOf(hash) !== -1) return true;
			}
			const nickEl = node.querySelector(".tk-nick");
			if (nickEl) {
				const nick = (nickEl.textContent || "").trim();
				if (OWNER_NICKS.indexOf(nick) !== -1) return true;
			}
			return false;
		}

		function renameOwnerNick(node) {
			const nickEl = node.querySelector(".tk-nick");
			if (!nickEl) return;
			const nick = (nickEl.textContent || "").trim();
			if (OWNER_NICKS.indexOf(nick) === -1 && nick !== OWNER_DISPLAY_NICK)
				return;
			// .tk-nick 内是 <strong>昵称</strong>（或本身是 strong），保留原有加粗样式
			const strong = nickEl.querySelector("strong");
			const target = strong || nickEl;
			target.textContent = OWNER_DISPLAY_NICK;
		}

		function renameOwnerMentions(node) {
			node.querySelectorAll(".tk-ruser").forEach((el) => {
				const text = (el.textContent || "").trim();
				for (const nick of OWNER_NICKS) {
					if (text === "@" + nick) {
						el.textContent = "@" + OWNER_DISPLAY_NICK;
						break;
					}
				}
			});
		}

		function applyOwnerRename(root) {
			// 扫描范围用 document：twikoo.init() 会用自建根节点 replace 掉
			// #tcomment（2026-10-01 无头实测），挂死在旧节点上永远收不到变更。
			const scope = root || document;
			scope
				.querySelectorAll(".tk-comment:not([data-owner-renamed])")
				.forEach((node) => {
					node.dataset.ownerRenamed = "1";
					if (isOwnerNode(node)) renameOwnerNick(node);
					renameOwnerMentions(node);
				});
		}

		function startOwnerRename() {
			if (ownerRenameObserver) ownerRenameObserver.disconnect();
			ownerRenameObserver = new MutationObserver(() => {
				applyOwnerRename(document);
			});
			// 挂在 body 上：#tcomment 会被 twikoo 替换，只有 body 是稳定锚点
			ownerRenameObserver.observe(document.body, { childList: true, subtree: true });
			applyOwnerRename(document);
		}

		function getCurrentPath() {
			const pathname = window.location.pathname;
			return pathname.endsWith("/") && pathname.length > 1
				? pathname.slice(0, -1)
				: pathname;
		}

		function createTwikooConfig() {
			return {
				...config,
				path: getCurrentPath(),
				el: "#tcomment",
			};
		}

		// ---- 评论图片直传个人图床（2026-10-02）----
		// Twikoo 前端没有 imageUploader 钩子，图片上传由服务端按后台 IMAGE_CDN 配置执行。
		// 这里在组件挂载后 hook TkSubmit 实例的 uploadPhotoToThirdParty：
		// 拦截上传 → 直调 ImgBed /upload（进图床 KV 索引，管理后台可见）→ 复用
		// Twikoo 自己的 uploadCompleted 把占位符回填为 Markdown 图片。
		// 注意：后台 IMAGE_CDN 需保持非空（决定前端是否调用 uploadPhotoToThirdParty）；
		// hook 后实际走本逻辑，后台 S3 各项不再参与上传。
		// token 与 /js/editor/imgbed.js 保持一致（本就公开，无新增暴露）。
		const IMGBED_BASE = "https://img.yujingblog.top";
		const IMGBED_UPLOAD_URL = IMGBED_BASE + "/upload";
		const IMGBED_TOKEN =
			"imgbed_7d675d35eba290f15714416efc9aa60ece523272f067c7be58ab5afeb847704f";

		function hookImgbedUpload() {
			const input = document.querySelector("input.tk-input-image");
			if (!input) return false;
			let el = input;
			while (el) {
				const vue = el.__vue__;
				if (
					vue &&
					typeof vue.uploadPhotoToThirdParty === "function" &&
					typeof vue.uploadCompleted === "function"
				) {
					if (vue.__imgbedHooked) return true;
					vue.__imgbedHooked = true;
					vue.uploadPhotoToThirdParty = async function (id, fileName, ext, file) {
						try {
							const fd = new FormData();
							fd.append("file", file, fileName || (file && file.name) || "image");
							const resp = await fetch(IMGBED_UPLOAD_URL, {
								method: "POST",
								headers: { Authorization: "Bearer " + IMGBED_TOKEN },
								body: fd,
							});
							if (!resp.ok) throw new Error("图床接口返回 " + resp.status);
							const data = await resp.json();
							const src = data && data[0] && data[0].src;
							if (!src) throw new Error("图床未返回图片地址");
							this.uploadCompleted(id, fileName, ext, IMGBED_BASE + src);
						} catch (err) {
							this.uploadFailed(
								id,
								ext,
								err && err.message ? err.message : String(err),
							);
						}
					};
					return true;
				}
				el = el.parentElement;
			}
			return false;
		}

		function startImgbedHook() {
			// twikoo.init 后 Vue 组件异步渲染，轮询至多 15s
			let tries = 0;
			const timer = setInterval(() => {
				if (hookImgbedUpload() || ++tries > 30) clearInterval(timer);
			}, 500);
		}

		async function loadTwikooScript() {
			if (
				twikooLoaded ||
				document.getElementById("twikoo-script-loaded")
			) {
				return;
			}
			return new Promise((resolve, reject) => {
				const script = document.createElement("script");
				script.id = "twikoo-script-loaded";
				script.src = TWIKOO_SCRIPT_URL;
				script.async = true;
				script.onload = () => {
					twikooLoaded = true;
					resolve();
				};
				script.onerror = reject;
				document.head.appendChild(script);
			});
		}

		async function initTwikoo() {
			const commentEl = document.getElementById("tcomment");
			if (!commentEl) {
				return;
			}

			// 改名观察器必须在 twikoo.init() 之前挂上：init 的 Promise 在部分环境
			// （无头/弱网）迟迟不 resolve，而评论列表已经先渲染出来了，
			// 挂在 await 之后会漏掉首批评论（2026-10-01 无头实测踩过）。
			startOwnerRename();

			try {
				await loadTwikooScript();

				if (typeof twikoo === "undefined") {
					console.warn("[Twikoo] 脚本加载失败");
					return;
				}

				commentEl.innerHTML = "";
				const dynamicConfig = createTwikooConfig();
				await twikoo.init(dynamicConfig);
				// init 完成后补扫一次，兜住 init 内部同步渲染的首屏评论
				applyOwnerRename(document);
				// 组件挂载后接管图片上传（直传个人图床）
				startImgbedHook();
			} catch (error) {
				console.error("[Twikoo] 初始化失败:", error);
			}
		}

		function cleanup() {
			if (observer) {
				observer.disconnect();
				observer = null;
			}
			if (ownerRenameObserver) {
				ownerRenameObserver.disconnect();
				ownerRenameObserver = null;
			}
			if (window.swup?.hooks) {
				window.swup.hooks.off("content:replace", initTwikoo);
			}
		}

		function setupLazyLoad() {
			const container = document.getElementById(TWIKOO_CONTAINER_ID);
			if (!container) {
				return;
			}

			observer = new IntersectionObserver(
				(entries) => {
					if (entries[0].isIntersecting) {
						observer.disconnect();
						observer = null;
						initTwikoo();
					}
				},
				{ rootMargin: ROOT_MARGIN },
			);

			observer.observe(container);
		}

		function setupSwupHooks() {
			if (window.swup?.hooks) {
				window.swup.hooks.on("content:replace", () => {
					setTimeout(setupLazyLoad, 200);
				});
			} else {
				document.addEventListener(
					"swup:enable",
					() => {
						if (window.swup?.hooks) {
							window.swup.hooks.on("content:replace", () => {
								setTimeout(setupLazyLoad, 200);
							});
						}
					},
					{ once: true },
				);
			}
		}

		document.addEventListener("mizuki:page:loaded", () => {
			setupLazyLoad();
		});

		window.addEventListener("beforeunload", cleanup);

		if (document.readyState === "loading") {
			document.addEventListener("DOMContentLoaded", () => {
				setupLazyLoad();
				setupSwupHooks();
			});
		} else {
			setupLazyLoad();
			setupSwupHooks();
		}
	})();
</script>

<style>
	.twikoo-container {
		min-height: 200px;
	}
</style>
