---
import { commentConfig } from "@/config";

interface Props {
	path: string;
}

const config = {
	...commentConfig.twikoo,
	el: "#tcomment",
	path: Astro.props.path,
};
---

<div id="twikoo-container" class="twikoo-container">
	<div id="tcomment"></div>
</div>

<script is:inline define:vars={{ config }}>
	(function () {
		const TWIKOO_CONTAINER_ID = "twikoo-container";
		const TWIKOO_SCRIPT_URL = "/assets/js/twikoo.all.min.js?v=1.7.14";
		const ROOT_MARGIN = "200px";

		let observer = null;
		let twikooLoaded = false;

		function getCurrentPath() {
			const pathname = window.location.pathname;
			return pathname.endsWith("/") && pathname.length > 1
				? pathname.slice(0, -1)
				: pathname;
		}

		function createTwikooConfig() {
			return {
				...config,
				path: getCurrentPath(),
				el: "#tcomment",
			};
		}

		async function loadTwikooScript() {
			if (
				twikooLoaded ||
				document.getElementById("twikoo-script-loaded")
			) {
				return;
			}
			return new Promise((resolve, reject) => {
				const script = document.createElement("script");
				script.id = "twikoo-script-loaded";
				script.src = TWIKOO_SCRIPT_URL;
				script.async = true;
				script.onload = () => {
					twikooLoaded = true;
					resolve();
				};
				script.onerror = reject;
				document.head.appendChild(script);
			});
		}

		async function initTwikoo() {
			const commentEl = document.getElementById("tcomment");
			if (!commentEl) {
				return;
			}

			try {
				await loadTwikooScript();

				if (typeof twikoo === "undefined") {
					console.warn("[Twikoo] 脚本加载失败");
					return;
				}

				commentEl.innerHTML = "";
				const dynamicConfig = createTwikooConfig();
				await twikoo.init(dynamicConfig);

				// Twikoo 初始化完成后，绑定 OwO 面板增强
				setupOwoEnhancements();
			} catch (error) {
				console.error("[Twikoo] 初始化失败:", error);
			}
		}

		/* ==== OwO 表情面板增强（在 Twikoo 初始化后调用） ==== */
		function setupOwoEnhancements() {
			var owo = document.querySelector("#twikoo .OwO");
			if (!owo) return;

			// 1. 监听面板开/关，动态调整展开方向
			var mo = new MutationObserver(function (mutations) {
				mutations.forEach(function (m) {
					if (m.attributeName === "class") {
						if (owo.classList.contains("OwO-open")) {
							fixOwoPosition(owo);
						} else {
							owo.classList.remove("OwO-up");
						}
					}
				});
			});
			mo.observe(owo, { attributes: true });

			// 2. 点击面板外部关闭（使用 capture 阶段优先拦截）
			document.addEventListener(
				"click",
				function (e) {
					if (!owo.classList.contains("OwO-open")) return;
					// 如果点击目标不在 OwO 容器内，关闭面板
					if (!owo.contains(e.target)) {
						owo.classList.remove("OwO-open");
						owo.classList.remove("OwO-up");
					}
				},
				true // capture phase
			);
		}

		// 检测面板是否会超出视口底部，超出则切换为向上展开
		function fixOwoPosition(owo) {
			var body = owo.querySelector(".OwO-body");
			if (!body) return;

			// 强制浏览器 reflow 以获取准确尺寸
			var _ = body.offsetHeight;

			var rect = body.getBoundingClientRect();
			var viewportHeight = window.innerHeight;

			// 如果面板底部超出视口（留 20px 安全边距）
			if (rect.bottom > viewportHeight - 20) {
				owo.classList.add("OwO-up");
			} else {
				owo.classList.remove("OwO-up");
			}
		}

		function cleanup() {
			if (observer) {
				observer.disconnect();
				observer = null;
			}
			if (window.swup?.hooks) {
				window.swup.hooks.off("content:replace", initTwikoo);
			}
		}

		function setupLazyLoad() {
			const container = document.getElementById(TWIKOO_CONTAINER_ID);
			if (!container) {
				return;
			}

			observer = new IntersectionObserver(
				(entries) => {
					if (entries[0].isIntersecting) {
						observer.disconnect();
						observer = null;
						initTwikoo();
					}
				},
				{ rootMargin: ROOT_MARGIN },
			);

			observer.observe(container);
		}

		function setupSwupHooks() {
			if (window.swup?.hooks) {
				window.swup.hooks.on("content:replace", () => {
					setTimeout(setupLazyLoad, 200);
				});
			} else {
				document.addEventListener(
					"swup:enable",
					() => {
						if (window.swup?.hooks) {
							window.swup.hooks.on("content:replace", () => {
								setTimeout(setupLazyLoad, 200);
							});
						}
					},
					{ once: true },
				);
			}
		}

		document.addEventListener("mizuki:page:loaded", () => {
			setupLazyLoad();
		});

		window.addEventListener("beforeunload", cleanup);

		if (document.readyState === "loading") {
			document.addEventListener("DOMContentLoaded", () => {
				setupLazyLoad();
				setupSwupHooks();
			});
		} else {
			setupLazyLoad();
			setupSwupHooks();
		}
	})();
</script>

<style>
	.twikoo-container {
		min-height: 200px;
	}
</style>
