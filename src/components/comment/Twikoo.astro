---
import { commentConfig } from "@/config";

interface Props {
	path: string;
	/** 留言板用：不显示站长自己的评论（按头像哈希 / 昵称过滤） */
	hideOwner?: boolean;
}

const config = {
	...commentConfig.twikoo,
	el: "#tcomment",
	path: Astro.props.path,
};

// 站长身份（2026-10-01 确认）：
//   邮箱 2803673194@qq.com 的 weavatar 头像哈希 = sha256(邮箱)
//   昵称兜底：站长常用「余京 / YuJing」两个马甲
const OWNER_NICKS = ["余京", "YuJing"];
const OWNER_AVATAR_HASHES = [
	"9735dc7774c6444b2647f25b595d67d5668e1d0ad38aa11557f3a7a4954a1abb",
];
---

<div id="twikoo-container" class="twikoo-container">
	<div id="tcomment"></div>
</div>

<script is:inline define:vars={{ config, hideOwner: Astro.props.hideOwner ?? false, OWNER_NICKS, OWNER_AVATAR_HASHES }}>
	(function () {
		const TWIKOO_CONTAINER_ID = "twikoo-container";
		const TWIKOO_SCRIPT_URL = "/assets/js/twikoo.all.min.js?v=1.7.14";
		const ROOT_MARGIN = "200px";

		let observer = null;
		let twikooLoaded = false;
		let ownerFilterObserver = null;

		// ---- 站长评论过滤（仅留言板 hideOwner 时启用）----
		function isOwnerCommentNode(node) {
			if (!node || node.nodeType !== 1) return false;
			const avatar = node.querySelector(".tk-avatar img");
			const src = avatar ? avatar.getAttribute("src") || "" : "";
			for (const hash of OWNER_AVATAR_HASHES) {
				if (src.indexOf(hash) !== -1) return true;
			}
			const nickEl = node.querySelector(".tk-nick");
			const nick = nickEl ? (nickEl.textContent || "").trim() : "";
			return OWNER_NICKS.indexOf(nick) !== -1;
		}

		function applyOwnerFilter(root) {
			if (!root || !hideOwner) return;
			root
				.querySelectorAll(".tk-comment:not([data-owner-hidden])")
				.forEach((node) => {
					if (isOwnerCommentNode(node)) {
						node.dataset.ownerHidden = "1";
						node.style.display = "none";
					}
				});
		}

		function startOwnerFilter(commentEl) {
			if (!hideOwner) return;
			if (ownerFilterObserver) ownerFilterObserver.disconnect();
			ownerFilterObserver = new MutationObserver(() => {
				applyOwnerFilter(commentEl);
			});
			ownerFilterObserver.observe(commentEl, { childList: true, subtree: true });
			applyOwnerFilter(commentEl);
		}

		function getCurrentPath() {
			const pathname = window.location.pathname;
			return pathname.endsWith("/") && pathname.length > 1
				? pathname.slice(0, -1)
				: pathname;
		}

		function createTwikooConfig() {
			return {
				...config,
				path: getCurrentPath(),
				el: "#tcomment",
			};
		}

		async function loadTwikooScript() {
			if (
				twikooLoaded ||
				document.getElementById("twikoo-script-loaded")
			) {
				return;
			}
			return new Promise((resolve, reject) => {
				const script = document.createElement("script");
				script.id = "twikoo-script-loaded";
				script.src = TWIKOO_SCRIPT_URL;
				script.async = true;
				script.onload = () => {
					twikooLoaded = true;
					resolve();
				};
				script.onerror = reject;
				document.head.appendChild(script);
			});
		}

		async function initTwikoo() {
			const commentEl = document.getElementById("tcomment");
			if (!commentEl) {
				return;
			}

			try {
				await loadTwikooScript();

				if (typeof twikoo === "undefined") {
					console.warn("[Twikoo] 脚本加载失败");
					return;
				}

				commentEl.innerHTML = "";
				const dynamicConfig = createTwikooConfig();
				await twikoo.init(dynamicConfig);
				startOwnerFilter(commentEl);
			} catch (error) {
				console.error("[Twikoo] 初始化失败:", error);
			}
		}

		function cleanup() {
			if (observer) {
				observer.disconnect();
				observer = null;
			}
			if (ownerFilterObserver) {
				ownerFilterObserver.disconnect();
				ownerFilterObserver = null;
			}
			if (window.swup?.hooks) {
				window.swup.hooks.off("content:replace", initTwikoo);
			}
		}

		function setupLazyLoad() {
			const container = document.getElementById(TWIKOO_CONTAINER_ID);
			if (!container) {
				return;
			}

			observer = new IntersectionObserver(
				(entries) => {
					if (entries[0].isIntersecting) {
						observer.disconnect();
						observer = null;
						initTwikoo();
					}
				},
				{ rootMargin: ROOT_MARGIN },
			);

			observer.observe(container);
		}

		function setupSwupHooks() {
			if (window.swup?.hooks) {
				window.swup.hooks.on("content:replace", () => {
					setTimeout(setupLazyLoad, 200);
				});
			} else {
				document.addEventListener(
					"swup:enable",
					() => {
						if (window.swup?.hooks) {
							window.swup.hooks.on("content:replace", () => {
								setTimeout(setupLazyLoad, 200);
							});
						}
					},
					{ once: true },
				);
			}
		}

		document.addEventListener("mizuki:page:loaded", () => {
			setupLazyLoad();
		});

		window.addEventListener("beforeunload", cleanup);

		if (document.readyState === "loading") {
			document.addEventListener("DOMContentLoaded", () => {
				setupLazyLoad();
				setupSwupHooks();
			});
		} else {
			setupLazyLoad();
			setupSwupHooks();
		}
	})();
</script>

<style>
	.twikoo-container {
		min-height: 200px;
	}
</style>
