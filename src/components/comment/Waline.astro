---
import { commentConfig } from "@/config";

interface Props {
	path: string;
}

const config = commentConfig.waline || {};
---

<div id="waline-container" class="waline-container">
	<div id="waline"></div>
</div>

<script is:inline define:vars={{ config }}>
	(function () {
		const WARENA_CONTAINER_ID = "waline-container";
		const WARENA_SCRIPT_URL = "/assets/js/waline.js";
		const ROOT_MARGIN = "200px";

		let observer = null;
		let walineLoaded = false;

		function getCurrentPath() {
			const pathname = window.location.pathname;
			return pathname.endsWith("/") && pathname.length > 1
				? pathname.slice(0, -1)
				: pathname;
		}

		async function loadWalineScript() {
			if (
				walineLoaded ||
				document.getElementById("waline-script-loaded")
			) {
				return;
			}
			return new Promise((resolve, reject) => {
				const script = document.createElement("script");
				script.id = "waline-script-loaded";
				script.src = WARENA_SCRIPT_URL;
				script.async = true;
				script.onload = () => {
					walineLoaded = true;
					resolve();
				};
				script.onerror = reject;
				document.head.appendChild(script);
			});
		}

		async function initWaline() {
			const commentEl = document.getElementById("waline");
			if (!commentEl) {
				return;
			}

			try {
				await loadWalineScript();

				if (typeof Waline === "undefined") {
					console.warn("[Waline] 脚本加载失败");
					return;
				}

				commentEl.innerHTML = "";
				const Waline = window.Waline;
				new Waline({
					el: "#waline",
					path: getCurrentPath(),
					...config,
				});
			} catch (error) {
				console.error("[Waline] 初始化失败:", error);
			}
		}

		function cleanup() {
			if (observer) {
				observer.disconnect();
				observer = null;
			}
			if (window.swup?.hooks) {
				window.swup.hooks.off("content:replace", initWaline);
			}
		}

		function setupLazyLoad() {
			const container = document.getElementById(WARENA_CONTAINER_ID);
			if (!container) {
				return;
			}

			observer = new IntersectionObserver(
				(entries) => {
					if (entries[0].isIntersecting) {
						observer.disconnect();
						observer = null;
						initWaline();
					}
				},
				{ rootMargin: ROOT_MARGIN },
			);

			observer.observe(container);
		}

		function setupSwupHooks() {
			if (window.swup?.hooks) {
				window.swup.hooks.on("content:replace", () => {
					setTimeout(setupLazyLoad, 200);
				});
			} else {
				document.addEventListener(
					"swup:enable",
					() => {
						if (window.swup?.hooks) {
							window.swup.hooks.on("content:replace", () => {
								setTimeout(setupLazyLoad, 200);
							});
						}
					},
					{ once: true },
				);
			}
		}

		document.addEventListener("mizuki:page:loaded", () => {
			setupLazyLoad();
		});

		window.addEventListener("beforeunload", cleanup);

		if (document.readyState === "loading") {
			document.addEventListener("DOMContentLoaded", () => {
				setupLazyLoad();
				setupSwupHooks();
			});
		} else {
			setupLazyLoad();
			setupSwupHooks();
		}
	})();
</script>

<style>
	.waline-container {
		min-height: 200px;
	}
</style>