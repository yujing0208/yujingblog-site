---
import type { CollectionEntry } from "astro:content";

import { commentConfig } from "@/config";
import { removeFileExtension } from "@/utils/url-utils";

import Waline from "./Waline.astro";

interface Props {
	post?: CollectionEntry<"posts">;
	path?: string;
}

const { post, path: customPath } = Astro.props as Props;

const path = post
	? `/posts/${removeFileExtension(post.id)}`
	: (customPath ?? "");

const commentService =
	commentConfig?.enable && commentConfig.system === "waline"
		? "waline"
		: "";

const commentEnabled = post ? (post.data.comment ?? true) : true;
---

{
	commentService && commentEnabled && path && (
		<div id="comments" class="card-base p-6 mb-4">
			<Waline path={path} />
		</div>
	)
}
