---
import type { CollectionEntry } from "astro:content";

import { commentConfig } from "@/config";
import { removeFileExtension } from "@/utils/url-utils";

import Giscus from "./Giscus.astro";
import Twikoo from "./Twikoo.astro";

interface Props {
	post?: CollectionEntry<"posts">;
	path?: string;
}

const { post, path: customPath } = Astro.props as Props;

const path = post
	? `/posts/${removeFileExtension(post.id)}`
	: (customPath ?? "");

let commentService = "";
if (commentConfig?.enable) {
	if (commentConfig.system) {
		commentService = commentConfig.system;
	} else if (commentConfig.twikoo) {
		commentService = "twikoo";
	}
}

const commentEnabled = post ? (post.data.comment ?? true) : true;
---

{
	commentConfig?.enable && commentEnabled && path && (
		/* 照搬 flatpaper 的评论区外壳（.comments-section，样式见 paper-comments.css）：
		   独立纸卡 + 顶部胶带 + 「评论」标题，与参考博客一模一样 */
		<section id="comments" class="comments-section" aria-label="评论">
			<header class="comments-section__head">
				<h2>
					<svg
						class="lucide"
						viewBox="0 0 24 24"
						fill="none"
						stroke="currentColor"
						stroke-width="1.8"
						stroke-linecap="round"
						stroke-linejoin="round"
						aria-hidden="true"
					>
						<path
							d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"
						></path>
					</svg>
					评论
				</h2>
			</header>
			{commentService === "twikoo" && <Twikoo path={path} />}
			{commentService === "giscus" && <Giscus path={path} />}
			{commentService === "" && null}
		</section>
	)
}
