---
/**
 * CardTOC —— 文章页左栏「文章目录」卡（1:1 对齐 hexo-theme-flatpaper）
 *
 * 参考站结构（homulilly.com/post/xxx.html）：
 *   <section class="side-card toc-card">
 *     <header class="toc-card__head">
 *       <h2>〔lucide:table-of-contents〕文章目录</h2>
 *       <button class="toc-toggle-all" data-action="toggle-toc" aria-pressed="false">
 *         〔lucide:chevron-down〕
 *       </button>
 *     </header>
 *     <div class="toc-content"><ol class="toc">…</ol></div>
 *   </section>
 *
 * 样式：src/styles/paper-toc-card.css（照搬原版 CSS）
 * 交互：src/utils/flatpaper-toc.ts（照搬原版 main.js 的 TOC scrollspy 段）
 *
 * Round 20（2026-09-30）：原实现是 Mizuki 的 widget-layout（左侧竖线标题 + 徽章式
 * 条目 + 虚框指示器），与参考站 UI/交互都不同；本次换成与左栏其余卡一致的
 * side-card 手账卡 + flatpaper 目录样式与交互。
 *
 * 样式走全局 main.css 的 @import（不放组件内，避免组件级 CSS 异步加载
 * 造成首访时高亮样式缺失）。
 */
import { Icon } from "astro-icon/components";

import I18nKey from "../../../i18n/i18nKey";
import { i18n } from "../../../i18n/translation";

interface Props {
	class?: string;
	style?: string;
	/** 由 SidebarColumn 注入：当前页面是否为文章页（根路径永久链接下 pathname 判定不可靠） */
	isPost?: boolean;
}

const { class: className, style, isPost } = Astro.props;

// FlatPaper 对齐：toc-card 只在文章页出现（flatpaper sidebar-right.ejs 的 is_post 分支）。
// 非文章路径渲染空占位，避免归档/标签页出现「当前页面没有目录」的空卡。
const isPostPage = isPost ?? Astro.url.pathname.startsWith("/posts/");

const tocTitle = i18n(I18nKey.tableOfContents);
const labelExpand = i18n(I18nKey.tocExpandAll);
const labelCollapse = i18n(I18nKey.tocCollapseAll);

// 参考站 hexo toc 收录到 3 级（toc-level-2 / toc-level-3），这里同样保留三层。
const tocDepth = 3;
---

{
	isPostPage ? (
		<section
			class:list={["side-card toc-card", className]}
			style={style}
			data-card-toc-root
			data-toc-label-expand={labelExpand}
			data-toc-label-collapse={labelCollapse}
			data-toc-depth={String(tocDepth)}
		>
			<header class="toc-card__head">
				<h2>
					<Icon
						name="mdi:table-of-contents"
						class="side-card-icon"
						is:inline
					/>
					{tocTitle}
				</h2>
				<button
					type="button"
					class="toc-toggle-all"
					data-action="toggle-toc"
					aria-pressed="false"
					aria-label={labelExpand}
					title={labelExpand}
				>
					<Icon
						name="mdi:chevron-down"
						class="toc-toggle-all__icon"
						is:inline
					/>
				</button>
			</header>
			<div class="toc-content" data-card-toc-content />
		</section>
	) : (
		<div class="hidden" aria-hidden="true" />
	)
}

<script>
	import { FlatpaperTOC } from "@/utils/flatpaper-toc";

	const cardTocInstances = new WeakMap<HTMLElement, FlatpaperTOC>();

	/**
	 * 为单个 card-toc 实例初始化目录。
	 * 目录绑定组件自己的内容容器，避免左侧多断点并存时命中隐藏实例。
	 */
	function initCardTOC(root: Element) {
		if (!(root instanceof HTMLElement)) {
			return;
		}

		const content = root.querySelector("[data-card-toc-content]");
		if (!(content instanceof HTMLElement)) {
			return;
		}

		try {
			cardTocInstances.get(root)?.destroy();

			const toc = new FlatpaperTOC({
				root,
				content,
				card: root,
				labels: {
					expand: root.dataset.tocLabelExpand ?? "展开全部目录",
					collapse: root.dataset.tocLabelCollapse ?? "收起全部目录",
				},
				maxLevel: Number.parseInt(root.dataset.tocDepth ?? "3", 10) || 3,
			});

			if (!toc.init()) {
				// 正文可能还在入场动画中，标题尚未就绪，短暂轮询重试
				let retry = 0;
				const timer = window.setInterval(() => {
					retry += 1;
					if (toc.init() || retry >= 5) {
						window.clearInterval(timer);
					}
				}, 150);
			}

			cardTocInstances.set(root, toc);
		} catch (error) {
			if (typeof reportError === "function" && error instanceof Error) {
				reportError(error);
			}
		}
	}

	/**
	 * 页面内可能同时存在多个 card-toc 实例（tablet / desktop 各一份）。
	 * 统一批量初始化，确保每个可见实例都绑定到自己的容器。
	 */
	function initAllCardTOCs() {
		document.querySelectorAll("[data-card-toc-root]").forEach((root) => {
			initCardTOC(root);
		});
	}

	if (document.readyState === "loading") {
		document.addEventListener("DOMContentLoaded", initAllCardTOCs);
	} else {
		initAllCardTOCs();
	}

	document.addEventListener("swup:contentReplaced", () => {
		setTimeout(initAllCardTOCs, 100);
	});

	document.addEventListener("astro:page-load", () => {
		setTimeout(initAllCardTOCs, 100);
	});

	document.addEventListener("astro:after-swap", () => {
		setTimeout(initAllCardTOCs, 100);
	});

	window.addEventListener("popstate", () => {
		setTimeout(initAllCardTOCs, 200);
	});

	document.addEventListener("password:decrypted", () => {
		setTimeout(initAllCardTOCs, 200);
	});
</script>
