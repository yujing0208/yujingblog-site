---
/**
 * UmamiStats —— 手账风「访问统计」侧栏卡片（2026-10-02 纸化重做）
 *
 * 历史：原为 Mizuki 风格（WidgetLayout card-base + 中性灰大字），Round 5 时
 * 从桌面侧栏撤下；本次按需求加回左栏并适配纸风格。
 *
 * 视觉（对齐 side-card 家族：撕纸边纸面 + 右上黄胶带由 paper-sidebar-right.css
 * 的 .side-card::before 提供，卡片无需自己画）：
 *   section.side-card.visit-card
 *     h2                           ← lucide:eye + 「访问统计」（16px/700，同 random/tag 卡）
 *     a.visit-link                 ← 整卡可点，跳 Umami 公开分享页（原组件行为保留）
 *       .visit-hero                ← 总浏览量大数字 + 黄色荧光笔下划线（welcome h1::after 同手法）
 *       .visit-grid                ← 访问数 / 游客数 两列，虚线分隔（--paper-dash）
 *
 * 数据：Umami 云端分享 API（脚本逻辑原样保留，类名 umami-total-* 不能改，
 *       容器类 umami-visit-stats 供 IntersectionObserver 用）。
 *       统计周期 30 天（脚本 STATS_PERIOD_DAYS）。
 */
import { Icon } from "astro-icon/components";

interface Props {
	class?: string;
	style?: string;
}
const { class: className, style } = Astro.props;

// Umami 公开分享链接（在 Umami 后台对应站点开启 Share 后获得）
const UMAMI_SHARE_URL = "https://cloud.umami.is/share/eq6I2iWnakVCH2Rt";
---

<section class:list={["side-card", "visit-card", "umami-visit-stats", className]} style={style}>
	<h2>
		<Icon name="lucide:eye" class="side-card-icon" is:inline />
		访问统计
	</h2>
	<a
		href={UMAMI_SHARE_URL}
		target="_blank"
		rel="noopener noreferrer"
		class="visit-link"
	>
		<div class="visit-hero">
			<strong class="visit-hero__num umami-total-pageviews">-</strong>
			<span class="visit-hero__label">总浏览量 · 近 30 天</span>
		</div>
		<div class="visit-grid">
			<div class="visit-cell">
				<strong class="visit-cell__num umami-total-visits">-</strong>
				<span class="visit-cell__label">访问数</span>
			</div>
			<div class="visit-cell">
				<strong class="visit-cell__num umami-total-visitors">-</strong>
				<span class="visit-cell__label">游客数</span>
			</div>
		</div>
	</a>
</section>

<script is:inline define:vars={{ UMAMI_SHARE_URL }}>
	const UMAMI_CONFIG = { shareUrl: UMAMI_SHARE_URL };
	// 统计周期（天）：30 = 最近 30 天；设为 0 表示全部时间
	const STATS_PERIOD_DAYS = 30;
	// API 请求失败时的兜底数据（保持 UI 美观）
	const FALLBACK_STATS = { pageviews: 1000, visits: 1000, visitors: 1000 };

	let __UMAMI_INTERNAL = {
		baseUrl: "",
		websiteId: "",
		shareToken: "",
		shareId: "",
		isReady: false,
	};

	async function initUmamiConfig() {
		try {
			const sharePath = UMAMI_CONFIG.shareUrl.split("/share/")[1];
			if (!sharePath) throw new Error("Invalid Umami Share URL");

			let apiBase = "";
			if (
				UMAMI_CONFIG.shareUrl.includes("cloud.umami.is") ||
				UMAMI_CONFIG.shareUrl.includes("analytics.umami.is")
			) {
				const region = UMAMI_CONFIG.shareUrl.includes("/analytics/eu/")
					? "eu"
					: "us";
				apiBase = `https://cloud.umami.is/analytics/${region}/api`;
			} else {
				const urlObj = new URL(UMAMI_CONFIG.shareUrl);
				apiBase = `${urlObj.origin}/api`;
			}

			const res = await fetch(`${apiBase}/share/${sharePath}`);
			if (!res.ok)
				throw new Error(`Failed to fetch share config: ${res.status}`);
			const data = await res.json();

			__UMAMI_INTERNAL = {
				baseUrl: apiBase,
				websiteId: data.websiteId,
				shareToken: data.token,
				shareId: data.shareId,
				isReady: true,
			};

			document
				.querySelectorAll(".umami-link")
				.forEach((link) => link.setAttribute("href", UMAMI_CONFIG.shareUrl));
		} catch (e) {
			console.error("Umami Config Init Failed:", e);
		}
	}

	function formatNumber(num) {
		if (num >= 1000000) return (num / 1000000).toFixed(1) + "M";
		if (num >= 1000) return (num / 1000).toFixed(1) + "K";
		return Math.round(num).toString();
	}

	function setStats(values) {
		const pageviewsEls = document.querySelectorAll(".umami-total-pageviews");
		const visitsEls = document.querySelectorAll(".umami-total-visits");
		const visitorsEls = document.querySelectorAll(".umami-total-visitors");
		const easeOutCubic = (t) => 1 - Math.pow(1 - t, 3);
		const animHandles = new Map();

		const animateStat = (el, to, duration = 2000) => {
			if (!el) return;
			const prev = animHandles.get(el);
			if (prev) cancelAnimationFrame(prev);
			const from = 0;
			const startTime = performance.now();
			const tick = (now) => {
				const elapsed = now - startTime;
				const progress = Math.min(1, elapsed / duration);
				const eased = easeOutCubic(progress);
				const current = from + (to - from) * eased;
				el.textContent = formatNumber(current);
				if (progress < 1) animHandles.set(el, requestAnimationFrame(tick));
			};
			animHandles.set(el, requestAnimationFrame(tick));
		};

		pageviewsEls.forEach((el) => animateStat(el, values.pageviews));
		visitsEls.forEach((el) => animateStat(el, values.visits));
		visitorsEls.forEach((el) => animateStat(el, values.visitors));
	}

	async function fetchUmamiStats() {
		if (!__UMAMI_INTERNAL.isReady) await initUmamiConfig();
		if (!__UMAMI_INTERNAL.isReady) {
			setStats(FALLBACK_STATS);
			return;
		}
		try {
			const endAt = Date.now();
			const startAt =
				STATS_PERIOD_DAYS > 0
					? Date.now() - STATS_PERIOD_DAYS * 24 * 60 * 60 * 1000
					: 0;
			const url = `${__UMAMI_INTERNAL.baseUrl}/websites/${__UMAMI_INTERNAL.websiteId}/stats?startAt=${startAt}&endAt=${endAt}&unit=hour&timezone=Asia%2FShanghai`;
			const response = await fetch(url, {
				headers: {
					"x-umami-share-context": "1",
					"x-umami-share-token": __UMAMI_INTERNAL.shareToken,
				},
			});
			if (!response.ok) throw new Error(`HTTP ${response.status}`);
			const data = await response.json();
			const getValue = (field) =>
				(typeof field === "object" && field !== null
					? field.value
					: field) || 0;
			setStats({
				pageviews: getValue(data.pageviews),
				visits: getValue(data.visits),
				visitors: getValue(data.visitors),
			});
		} catch (error) {
			console.error("Umami Fetch Failed:", error);
			setStats(FALLBACK_STATS);
		}
	}

	let __umamiStatsStarted = false;
	function startUmamiStats() {
		if (__umamiStatsStarted) return;
		__umamiStatsStarted = true;
		fetchUmamiStats();
	}

	function initUmamiStatsVisibility() {
		const containers = document.querySelectorAll(".umami-visit-stats");
		if (!containers.length) return;
		const io = new IntersectionObserver(
			(entries) => {
				entries.forEach((entry) => {
					if (entry.isIntersecting) {
						startUmamiStats();
						io.unobserve(entry.target);
					}
				});
			},
			{ threshold: 0.1 },
		);
		containers.forEach((c) => io.observe(c));
	}

	initUmamiStatsVisibility();

	// Mizuki 使用 Swup 做 SPA 导航，content:replace 时重新拉取数据
	if (window.swup) {
		window.swup.hooks.on("content:replace", () => {
			setTimeout(() => {
				__umamiStatsStarted = false;
				initUmamiStatsVisibility();
			}, 150);
		});
	}
</script>

<style>
	/* 链接整体：去下划线，占满卡内容宽 */
	.visit-link {
		display: block;
		text-decoration: none;
	}

	/* --- 主数字：总浏览量 --- */
	.visit-hero {
		padding: 4px 0 16px;
		text-align: center;
	}

	.visit-hero__num {
		position: relative;
		display: inline-block;
		padding: 0 6px;
		font-size: 30px;
		line-height: 1.25;
		font-weight: 800;
		letter-spacing: 0.5px;
		color: var(--deep-text);
		font-variant-numeric: tabular-nums;
	}

	/* 黄色荧光笔下划线（welcome h1::after 同手法） */
	.visit-hero__num::after {
		content: "";
		position: absolute;
		left: 2px;
		right: 2px;
		bottom: 3px;
		z-index: -1;
		height: 10px;
		background: rgba(241, 193, 84, 0.4);
	}

	.visit-hero__label {
		display: block;
		margin-top: 6px;
		font-size: 12px;
		font-weight: 600;
		letter-spacing: 1px;
		color: var(--text-muted);
	}

	/* --- 两列小数字：访问数 / 游客数 --- */
	.visit-grid {
		display: grid;
		grid-template-columns: 1fr 1fr;
		padding-top: 14px;
		border-top: 1px dashed var(--paper-dash, rgba(89, 62, 30, 0.24));
	}

	.visit-cell {
		position: relative;
		text-align: center;
	}

	/* 中缝虚线分隔 */
	.visit-cell + .visit-cell::before {
		content: "";
		position: absolute;
		left: 0;
		top: 12%;
		bottom: 12%;
		border-left: 1px dashed var(--paper-dash, rgba(89, 62, 30, 0.24));
	}

	.visit-cell__num {
		display: block;
		font-size: 18px;
		font-weight: 700;
		color: var(--deep-text);
		font-variant-numeric: tabular-nums;
		transition: color 0.2s ease;
	}

	.visit-cell__label {
		display: block;
		margin-top: 3px;
		font-size: 12px;
		font-weight: 600;
		letter-spacing: 0.5px;
		color: var(--text-muted);
	}

	/* 悬停：小数字染强调色（卡片自身的 translate 上浮由 .side-card 提供） */
	.visit-link:hover .visit-cell__num {
		color: var(--color-accent-strong);
	}

	/* --- 暗色（--deep-text 不自动适配，照 welcome h1 的做法显式覆盖） --- */
	:root.dark .visit-hero__num,
	:root.dark .visit-cell__num {
		color: var(--text-strong);
	}

	:root.dark .visit-link:hover .visit-cell__num {
		color: var(--color-accent);
	}

	@media (prefers-reduced-motion: reduce) {
		.visit-cell__num,
		.visit-link:hover .visit-cell__num {
			transition: none;
		}
	}
</style>
