---

{
	icon ? (
		<svg
			width="1em"
			height="1em"
			viewBox={icon.viewBox}
			class="socials-icon"
			aria-hidden="true"
		>
			<path fill="currentColor" d={icon.path} />
		</svg>
	) : (
		<svg
			width="1em"
			height="1em"
			viewBox="0 0 640 640"
