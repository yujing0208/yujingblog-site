---
import { SidebarTOC } from "@components/features/toc";
import type { MarkdownHeading } from "astro";
import type { AstroComponentFactory } from "astro/runtime/server/index.js";

import { widgetManager } from "@/utils/widget-manager";
import { buildComponentProps } from "@/utils/widget-renderer";

import Announcement from "../widgets/announcement/Announcement.astro";
import Calendar from "../widgets/calendar/Calendar.astro";
import { CardTOC } from "../widgets/card-toc";
import Categories from "../widgets/categories/Categories.astro";
import Hitokoto from "../widgets/hitokoto/Hitokoto.astro";
import MusicPlayer from "../widgets/music-player/MusicPlayer.svelte";
import { MusicSidebarWidget } from "../widgets/music-sidebar";
import PaperLatestCard from "../widgets/sidebar/PaperLatestCard.astro";
import PaperProfileCard from "../widgets/sidebar/PaperProfileCard.astro";
import PaperCategoriesCard from "../widgets/sidebar/PaperCategoriesCard.astro";
import PaperTagsCard from "../widgets/sidebar/PaperTagsCard.astro";
import Profile from "../widgets/profile/Profile.astro";
import SiteStats from "../widgets/site-stats/SiteStats.astro";
import Tags from "../widgets/tags/Tags.astro";
import UmamiStats from "../widgets/umami-stats/UmamiStats.astro";

interface Props {
	side: "left" | "right";
	headings?: MarkdownHeading[];
	containerId?: string;
	stickyId?: string;
	rootClass?: string;
	topClass?: string;
	stickyClass?: string;
	showMobile?: boolean;
	showTablet?: boolean;
	showDesktop?: boolean;
}

const {
	side,
	headings,
	containerId,
	stickyId,
	rootClass = "w-full",
	topClass = "",
	stickyClass = "",
	showMobile = false,
	showTablet = true,
	showDesktop = true,
} = Astro.props;

const componentMap: Record<string, unknown> = {
	profile: Profile,
	announcement: Announcement,
	categories: Categories,
	tags: Tags,
	"paper-profile": PaperProfileCard,
	"paper-categories": PaperCategoriesCard,
	"paper-tags": PaperTagsCard,
	"paper-latest": PaperLatestCard,
	toc: SidebarTOC,
	"card-toc": CardTOC,
	"music-player": MusicPlayer,
	"music-sidebar": MusicSidebarWidget,
	"site-stats": SiteStats,
	calendar: Calendar,
	hitokoto: Hitokoto,
	"umami-stats": UmamiStats,
};

type WidgetComponentConfig = ReturnType<
	typeof widgetManager.getComponentsByPosition
>[number];

const mobileTopComponents = showMobile
	? widgetManager.getComponentsByPosition("top", side, "mobile")
	: [];
const mobileStickyComponents = showMobile
	? widgetManager.getComponentsByPosition("sticky", side, "mobile")
	: [];

// FlatPaper 对齐（r15 差距 #2）：文章页左栏 = profile + toc-card + latest-posts
// （flatpaper sidebar-right.ejs 的 is_post 分支：分类/标签卡在文章页让位给目录+最新文章）。
// 仅作用于 tablet/desktop 桌面左栏；mobile 走 drawer 组、right 组不参与，均不受影响。
const isPostPage = Astro.url.pathname.startsWith("/posts/");

function pickPostLeftComponents(
	comps: ReturnType<typeof widgetManager.getComponentsByPosition>,
	position: "top" | "sticky",
): ReturnType<typeof widgetManager.getComponentsByPosition> {
	if (!isPostPage || side !== "left") {
		return comps;
	}
	const order = [
		"paper-profile",
		"card-toc",
		"paper-latest",
	] as const;
	return order
		.map((type) => {
			const found = comps.find((c) => c.type === type);
			if (found) {
				return found;
			}
			// paper-latest 不在 components.left，构造兜底条目（properties 已注册）
			if (type === "paper-latest") {
				return {
					type,
					position,
					class: "onload-animation",
					animationDelay: 150,
				} as (typeof comps)[number];
			}
			return null;
		})
		.filter(Boolean) as ReturnType<typeof widgetManager.getComponentsByPosition>;
}

const tabletTopComponents = showTablet
	? pickPostLeftComponents(
			widgetManager.getComponentsByPosition("top", side, "tablet"),
			"top",
		)
	: [];
const tabletStickyComponents = showTablet
	? pickPostLeftComponents(
			widgetManager.getComponentsByPosition("sticky", side, "tablet"),
			"sticky",
		)
	: [];

const desktopTopComponents = showDesktop
	? pickPostLeftComponents(
			widgetManager.getComponentsByPosition("top", side, "desktop"),
			"top",
		)
	: [];
const desktopStickyComponents = showDesktop
	? pickPostLeftComponents(
			widgetManager.getComponentsByPosition("sticky", side, "desktop"),
			"sticky",
		)
	: [];

// paper-profile 的站点统计（构建期算一次，flatpaper site_info 三列）
const allRendered = [
	...mobileTopComponents,
	...mobileStickyComponents,
	...tabletTopComponents,
	...tabletStickyComponents,
	...desktopTopComponents,
	...desktopStickyComponents,
];
const needsPaperCounts = allRendered.some((c) => c.type === "paper-profile");
const paperCounts = needsPaperCounts
	? await (async () => {
			const { getSortedPosts, getCategoryList, getTagList } =
				await import("../../utils/content-utils");
			const [posts, cats, tgs] = await Promise.all([
				getSortedPosts(),
				getCategoryList(),
				getTagList(),
			]);
			return { posts: posts.length, categories: cats.length, tags: tgs.length };
		})()
	: { posts: 0, categories: 0, tags: 0 };

function renderComponent(
	component: WidgetComponentConfig,
	index: number,
): { Component: AstroComponentFactory; props: Record<string, unknown> } | null {
	const ComponentToRender = componentMap[component.type] as
		| AstroComponentFactory
		| undefined;
	if (!ComponentToRender) {
		return null;
	}

	const props = buildComponentProps(component, index, headings);

	// paper-profile 需要「文章/分类/标签」三列统计，构建期现算注入
	// （FlatPaper profile-card 的 site_info 段）
	if (component.type === "paper-profile") {
		props.postCount = paperCounts.posts;
		props.categoryCount = paperCounts.categories;
		props.tagCount = paperCounts.tags;
	}

	return {
		Component: ComponentToRender,
		props,
	};
}
---

<div id={containerId} class:list={[rootClass, "sidebar-column-root"]}>
	<div class:list={["flex flex-col w-full gap-4 mb-4", topClass]}>
		{
			showMobile && mobileTopComponents.length > 0 && (
				<div class="flex flex-col w-full gap-4 md:hidden">
					{mobileTopComponents.map((component, index) => {
						const renderData = renderComponent(component, index);
						if (!renderData) {
							return null;
						}

						const { Component, props } = renderData;
						return <Component {...props} />;
					})}
				</div>
			)
		}

		{
			showTablet && tabletTopComponents.length > 0 && (
				<div class="sidebar-content hidden md:flex lg:hidden flex-col w-full gap-4">
					{tabletTopComponents.map((component, index) => {
						const renderData = renderComponent(component, index);
						if (!renderData) {
							return null;
						}

						const { Component, props } = renderData;
						return <Component {...props} />;
					})}
				</div>
			)
		}

		{
			showDesktop && desktopTopComponents.length > 0 && (
				<div class="sidebar-content hidden lg:flex flex-col w-full gap-4">
					{desktopTopComponents.map((component, index) => {
						const renderData = renderComponent(component, index);
						if (!renderData) {
							return null;
						}

						const { Component, props } = renderData;
						return <Component {...props} />;
					})}
				</div>
			)
		}
	</div>

	<div
		id={stickyId}
		class:list={[
			"transition-all duration-700 flex flex-col w-full gap-4 sticky top-4 sidebar-sticky-column",
			stickyClass,
		]}
	>
		{
			showMobile && mobileStickyComponents.length > 0 && (
				<div class="flex flex-col w-full gap-4 md:hidden">
					{mobileStickyComponents.map((component, index) => {
						const renderData = renderComponent(component, index);
						if (!renderData) {
							return null;
						}

						const { Component, props } = renderData;
						return <Component {...props} />;
					})}
				</div>
			)
		}

		{
			showTablet && tabletStickyComponents.length > 0 && (
				<div class="sidebar-content hidden md:flex lg:hidden flex-col w-full gap-4">
					{tabletStickyComponents.map((component, index) => {
						const renderData = renderComponent(component, index);
						if (!renderData) {
							return null;
						}

						const { Component, props } = renderData;
						return <Component {...props} />;
					})}
				</div>
			)
		}

		{
			showDesktop && desktopStickyComponents.length > 0 && (
				<div class="sidebar-content hidden lg:flex flex-col w-full gap-4">
					{desktopStickyComponents.map((component, index) => {
						const renderData = renderComponent(component, index);
						if (!renderData) {
							return null;
						}

						const { Component, props } = renderData;
						return <Component {...props} />;
					})}
				</div>
			)
		}
	</div>
</div>
