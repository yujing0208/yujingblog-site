---
/**
 * PaperHero —— 手账风首屏（1:1 移植 Homulilly/hexo-theme-flatpaper 的 home-hero）
 *
 * 来源：layout/_partial/home-hero.ejs (271 行) + _components/home-hero.styl (934 行)
 *      + source/js/main.js 的 initHomeHero 交互段
 *
 * 与原版保持一致的能力：
 *   · 纯纸张底 / 图片底 两种模式（home-hero--image）
 *   · 贴纸层（内置便签 + 自定义图片贴纸），可拖拽、可 shuffle
 *   · 右上工具组：shuffle + 主题亮暗切换
 *   · eyebrow（绿点 + 副标题）/ h1 / bio / 波浪分隔线 / 社交换行
 *   · 底部下拉纸签 CTA（呼吸动画 + hover 按压动画）
 *   · 外链二次确认气泡（hero-visit-confirm）
 *   · 社交链接超宽自动裁切（syncClippedHeroLinks）
 *
 * 内容取自本博客现有配置：
 *   siteConfig.title / siteConfig.subtitle / profileConfig.avatar / profileConfig.bio
 *   / profileConfig.links
 */
import { Icon } from "astro-icon/components";
import { profileConfig, siteConfig } from "../../config";
import SocialIcon from "@components/widgets/sidebar/SocialIcon.astro";

interface Props {
	/** 首屏背景图；留空则用纯纸张底（照搬 FlatPaper 的 --image 分支） */
	image?: string;
	/** 移动端是否也使用背景图（对应原版 home-hero--mobile-image） */
	mobileImage?: boolean;
	/** 上下遮罩浓度 [top, bottom] */
	imageOverlay?: [number, number];
	/** 便签贴纸文字（对应原版 builtin-note） */
	noteText?: string;
	/** 自定义贴纸：[{ image, link?, alt?, size? }] */
	stickers?: Array<{
		image: string;
		link?: string;
		alt?: string;
		size?: number;
	}>;
	/** 是否允许拖拽贴纸 */
	stickersDraggable?: boolean;
	/** 下拉 CTA 文案 */
	ctaText?: string;
	/** 下拉目标锚点 id */
	ctaTarget?: string;
}

const {
	image = "",
	mobileImage = false,
	imageOverlay = [0.2, 0.2],
	noteText = "今天也要\n好好生活",
	stickers = [],
	stickersDraggable = true,
	ctaText = "开始阅读",
	ctaTarget = "paper-home-content",
} = Astro.props;

const heroTitle = siteConfig.title;
const heroSubtitle = profileConfig.name;
const heroBio = profileConfig.bio;
const heroAvatar = profileConfig.avatar;

// 社交链接映射到原版 .socials a 的用法。
// 只保留 icon 为合法 "prefix:name" 形式的条目（astro-icon 要求静态可解析的名字，
// 空值或缺失冒号会回退到 local 图标集并导致构建中断）。
const socials = (profileConfig.links ?? []).filter(
	(l) =>
		!!l.url &&
		typeof l.icon === "string" &&
		l.icon.includes(":") &&
		l.icon.split(":")[0].length > 0 &&
		l.icon.split(":")[1].length > 0,
);

// ⚠️ astro-icon sprite 白名单由构建期源码扫描生成，只认静态字面量。
// 社交图标名是运行时变量，必须在此以字面量罗列一次才能进 sprite，
// 否则书签图标渲染为空白（详见 PaperProfileCard.astro 内同名注释）。
const ICON_SPRITE_MANIFEST = [
	"fa7-brands:github",
	"fa7-brands:bilibili",
	"fa7-brands:qq",
	"mdi:wechat",
	"simple-icons:tiktok",
];
void ICON_SPRITE_MANIFEST;

const [overlayTop, overlayBottom] = imageOverlay;

const heroClass = [
	"home-hero",
	image ? "home-hero--image" : "",
	image && mobileImage ? "home-hero--mobile-image" : "",
	stickersDraggable ? "has-draggable-stickers" : "",
]
	.filter(Boolean)
	.join(" ");

// 背景图内联变量（与原版一致，供 JS 随机切换 data-hero-images 时复用）
const heroStyle = image
	? `--hero-bg-image: url("${image}"); --hero-image-overlay-top: rgba(42, 33, 22, ${overlayTop}); --hero-image-overlay-bottom: rgba(42, 33, 22, ${overlayBottom});`
	: "";
---

<section class={heroClass} aria-label="站点首屏" data-paper-hero style={heroStyle}>
	<!-- 颗粒层 -->
	<div class="home-hero__grain" aria-hidden="true"></div>

	<!-- 右上工具：shuffle + 主题切换 -->
	<div class="home-hero__tools" aria-label="首屏工具">
		{
			stickersDraggable && (
				<button
					class="icon-button home-hero__tool js-hero-shuffle"
					type="button"
					aria-label="重新摆放贴纸"
					title="重新摆放贴纸"
				>
					<Icon name="material-symbols:shuffle" width={18} height={18} />
				</button>
			)
		}
		<button
			class="theme-toggle home-hero__tool js-theme-toggle"
			type="button"
			aria-label="切换颜色模式"
			title="切换颜色模式"
		>
			<span class="theme-icon theme-icon--sun"
				><Icon name="material-symbols:light-mode" width={18} height={18} /></span
			>
			<span class="theme-icon theme-icon--moon"
				><Icon name="material-symbols:dark-mode" width={18} height={18} /></span
			>
		</button>
	</div>

	<!-- 贴纸层 -->
	<div class="home-hero__stickers" aria-hidden="true">
		<button
			type="button"
			class="hero-sticker hero-sticker--note"
			data-hero-sticker="builtin-note"
			aria-hidden="true"
			tabindex="-1"
		>
			<span>{noteText}</span>
		</button>
		{
			stickers.slice(0, 5).map((item, index) => (
				<button
					type="button"
					class={`hero-sticker hero-sticker--custom hero-sticker--custom-${index}`}
					data-hero-sticker={`custom-${index}`}
					aria-hidden="true"
					tabindex="-1"
					style={item.size ? `--sticker-size: ${item.size}px;` : undefined}
				>
					<img
						src={item.image}
						alt=""
						loading="lazy"
						decoding="async"
						draggable="false"
						referrerpolicy="no-referrer"
					/>
				</button>
			))
		}
	</div>

	<!-- 资料卡 -->
	<div class="home-hero__content">
		<div class="home-hero__profile">
			{
				heroAvatar && (
					<div class="avatar avatar--image home-hero__avatar">
						<img
							src={heroAvatar}
							alt={heroTitle}
							loading="eager"
							referrerpolicy="no-referrer"
						/>
					</div>
				)
			}
			<p class="home-hero__eyebrow">
				<span class="green-dot"></span>{heroSubtitle}
			</p>
			<h1>{heroTitle}</h1>
			<p class="home-hero__bio">{heroBio}</p>

			<!-- 波浪分隔线（原版在有 nav 链接时显示 nav，否则显示波浪线） -->
			<div class="home-hero__divider" aria-hidden="true">
				<svg
					xmlns="http://www.w3.org/2000/svg"
					width="56"
					height="12"
					viewBox="0 0 56 12"
					fill="none"
					stroke="currentColor"
					stroke-width="2"
					stroke-linecap="round"
					stroke-linejoin="round"
				>
					<path
						d="M3 6c3.5-3.5 6.5-3.5 10 0s6.5 3.5 10 0 6.5-3.5 10 0 6.5 3.5 10 0 6.5-3.5 10 0"
					></path>
				</svg>
			</div>

			<!-- 社交书签（原版把它挂在资料卡下沿，做成书签条） -->
			<div class="socials home-hero__links" aria-label="社交链接">
				{
					socials.map((link) => (
						<a
							href={link.url}
							target={link.url.startsWith("http") ? "_blank" : undefined}
							rel={link.url.startsWith("http")
								? "noopener noreferrer"
								: undefined}
							aria-label={link.name}
							data-tooltip={link.name}
						>
							<SocialIcon name={link.icon} />
						</a>
					))
				}
			</div>
		</div>
	</div>

	<!-- 下拉纸签 CTA（照搬 FlatPaper：背景用 cta-bg-01.webp 花朵药丸贴纸，
	     text-shadow 提可读性；--hero-cta-bg 由内联样式给出） -->
	<a
		class="home-hero__arrow"
		href={`#${ctaTarget}`}
		data-hero-scroll
		aria-label={ctaText}
		title={ctaText}
		style={`--hero-cta-bg: url("/assets/home/cta/cta-bg-01.webp");`}
	>
		<span class="home-hero__arrow-text">{ctaText}</span>
	</a>
</section>
