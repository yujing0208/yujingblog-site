---
import { getEntry, render } from "astro:content";
import Comment from "@components/comment/index.astro";
import Markdown from "@components/misc/Markdown.astro";

import I18nKey from "../i18n/i18nKey";
import { i18n } from "../i18n/translation";
import MainGridLayout from "../layouts/MainGridLayout.astro";
import "../styles/paper-page.css";

const aboutPost = await getEntry("spec", "about");

if (!aboutPost) {
	throw new Error("About page content not found");
}

const { Content } = await render(aboutPost);
const title = String(aboutPost.data.title || i18n(I18nKey.about));
---

<MainGridLayout title={title}>
	<!-- 引入右侧边栏布局管理器 -->
	<script>
		import("../scripts/right-sidebar-layout.js");
	</script>
	<!-- 顶图布局与友链页一致（with-top-img + page-top-img）。
	     关于页是整幅连续场景图，改用宽扁 6:1 变体 --wide-top-img：
	     4:1 容器会 cover 掉画面上下各一截，再叠加下缘渐隐与页头叠压，实际只剩中间一条。 -->
	<article
		class="article-paper article-paper--with-top-img article-paper--page-top-img article-paper--wide-top-img card-base relative z-10 w-full"
	>
		<figure class="article-top-img article-top-img--page" aria-label={title}>
			<img
				src="/assets/pages/about-top.webp?v=2"
				alt=""
				loading="eager"
				fetchpriority="high"
				referrerpolicy="no-referrer"
				draggable="false"
			/>
		</figure>

		<header class="article-header">
			<span class="label-pill">关于</span>
			<h1>{title}</h1>
		</header>

		<!-- 从MD文件读取的内容 -->
		<Markdown class="mt-2">
			<Content />
		</Markdown>
	</article>

	<div class="mt-4">
		<Comment path="/about" />
	</div>
</MainGridLayout>
