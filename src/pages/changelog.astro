---
import MainGridLayout from "@layouts/MainGridLayout.astro";
import ChangelogGraph from "@components/features/changelog/ChangelogGraph.astro";
import { changelogData } from "../config/changelog";
import { adaptChangelogItems } from "@utils/changelog";

// 按日期倒序，再交给组件截取最近 30 条
const entries = adaptChangelogItems(
	[...changelogData].sort((a, b) => b.date.localeCompare(a.date)),
);
---

<MainGridLayout
	title="更新日志"
	description="本站持续迭代的更新记录，按时间倒序整理。"
>
	<div class="changelog-page-wrapper">
		<ChangelogGraph entries={entries} limit={30} />
	</div>
</MainGridLayout>

<style>
	.changelog-page-wrapper {
		padding: 1.25rem 0.5rem 2rem;
		max-width: 1100px;
		margin: 0 auto;
	}
</style>
