---
import { FilterTabs } from "@components/atoms/filter-tabs";
import MainGridLayout from "@layouts/MainGridLayout.astro";
import { Icon } from "astro-icon/components";

import { siteConfig } from "../config";
import { changelogData } from "../config/changelog";
import type { ChangelogType } from "../types/changelog";

if (!siteConfig.featurePages.changelog) {
	return Astro.redirect("/404/");
}

const typeConfig: Record<ChangelogType, { label: string; icon: string }> = {
	feature: { label: "功能新增", icon: "material-symbols:rocket-launch" },
	improvement: { label: "功能优化", icon: "material-symbols:mop" },
	fix: { label: "问题修复", icon: "material-symbols:bug-report" },
	removal: { label: "功能删除", icon: "material-symbols:delete" },
	other: { label: "其他", icon: "material-symbols:more-horiz" },
};

const filterTabs = [
	{
		value: "all",
		label: "全部",
		icon: "material-symbols:apps",
		count: changelogData.length,
	},
	...Object.entries(typeConfig).map(([value, config]) => ({
		value,
		label: config.label,
		icon: config.icon,
		count: changelogData.filter((item) => item.type === value).length,
	})),
];

const title = "更新日志";
const subtitle = "记录博客项目的功能迭代、问题修复与重要变更";
---

<MainGridLayout title={title} description={subtitle}>
	<script>
		import("../scripts/right-sidebar-layout.js");
		import { loadIconify } from "../utils/icon-loader";

		loadIconify().catch((error) => {
			console.error("Failed to load Iconify:", error);
		});
	</script>

	<script is:inline src="/js/filter-tabs-handler.js"></script>

	<div
		class="flex w-full rounded-(--radius-large) overflow-hidden relative min-h-32"
	>
		<div class="card-base z-10 px-6 sm:px-9 py-6 relative w-full">
			<div class="flex flex-col items-start justify-center mb-8">
				<h1
					class="text-4xl font-bold text-black/90 dark:text-white/90 mb-2 relative flex items-center gap-3
						before:w-1 before:h-8 before:rounded-md before:bg-(--primary)
						before:absolute before:top-1/2 before:-translate-y-1/2 before:-left-4"
				>
					<Icon
						name="material-symbols:history"
						class="text-3xl text-(--primary)"
					/>
					{title}
				</h1>
				<p class="text-lg text-black/60 dark:text-white/60">{subtitle}</p>
			</div>

			<div class="mb-8">
				<FilterTabs tabs={filterTabs} dataAttr="type" />
			</div>

			<div id="changelog-list" class="changelog-list">
				{
					changelogData.map((item) => (
						<div
							class="changelog-item"
							data-type={item.type}
						>
							<div class="changelog-dot" />
							<div class="changelog-content">
								<div class="changelog-meta">
									<span class="changelog-date">
										{item.date.replace(" ", " · ")}
									</span>
									<span
										class:list={[
											"changelog-badge",
											item.type,
										]}
									>
										<Icon
											name={typeConfig[item.type].icon}
											class="w-3 h-3"
										/>
										{typeConfig[item.type].label}
									</span>
								</div>
								<div class="changelog-card">
									<p class="changelog-message text-black/85 dark:text-white/85">{item.message}</p>
									<a
										href={`https://github.com/yujing0208/yujingblog/commit/${item.hash}`}
										target="_blank"
										rel="noopener noreferrer"
										class="changelog-hash"
									>
										{item.hash}
									</a>
								</div>
							</div>
						</div>
					))
				}
			</div>

			<div id="no-results" class="hidden text-center py-16">
				<Icon
					name="material-symbols:search-off-rounded"
					class="text-6xl text-black/15 dark:text-white/15 mb-4"
				/>
				<p class="text-black/40 dark:text-white/40 text-lg">
					没有找到匹配的更新记录
				</p>
			</div>
		</div>
	</div>
</MainGridLayout>

<style>
	.changelog-list {
		position: relative;
		padding-left: 1.5rem;
	}

	.changelog-list::before {
		content: "";
		position: absolute;
		left: 5px;
		top: 0;
		bottom: 0;
		width: 2px;
		background: var(--line-divider);
		border-radius: 1px;
	}

	.changelog-item {
		position: relative;
		padding-bottom: 1.5rem;
		opacity: 1;
		transition: opacity 0.2s ease, transform 0.2s ease;
	}

	.changelog-item.filtered-out {
		display: none;
	}

	.changelog-dot {
		position: absolute;
		left: -1.5rem;
		top: 0.375rem;
		width: 12px;
		height: 12px;
		border-radius: 50%;
		background: var(--primary);
		border: 2px solid var(--card-bg);
		box-shadow: 0 0 0 2px var(--primary);
	}

	.changelog-content {
		display: flex;
		flex-direction: column;
		gap: 0.5rem;
	}

	.changelog-meta {
		display: flex;
		align-items: center;
		gap: 0.75rem;
		flex-wrap: wrap;
	}

	.changelog-date {
		font-size: 0.9rem;
		font-weight: 500;
		color: var(--content-meta);
	}

	.changelog-badge {
		display: inline-flex;
		align-items: center;
		gap: 0.25rem;
		padding: 0.25rem 0.5rem;
		border-radius: var(--radius-medium);
		font-size: 0.75rem;
		font-weight: 600;
		background: var(--btn-regular-bg);
		color: var(--btn-content);
		border: 1px solid var(--line-divider);
	}

	.changelog-badge.feature {
		background: rgba(var(--primary-rgb), 0.1);
		color: var(--primary);
		border-color: rgba(var(--primary-rgb), 0.3);
	}

	.changelog-badge.improvement {
		background: rgba(34, 197, 94, 0.1);
		color: rgb(34, 197, 94);
		border-color: rgba(34, 197, 94, 0.3);
	}

	.changelog-badge.fix {
		background: rgba(239, 68, 68, 0.1);
		color: rgb(239, 68, 68);
		border-color: rgba(239, 68, 68, 0.3);
	}

	.changelog-badge.removal {
		background: rgba(156, 163, 175, 0.1);
		color: rgb(156, 163, 175);
		border-color: rgba(156, 163, 175, 0.3);
	}

	.changelog-badge.other {
		background: rgba(147, 51, 234, 0.1);
		color: rgb(147, 51, 234);
		border-color: rgba(147, 51, 234, 0.3);
	}

	.changelog-card {
		position: relative;
		padding: 1rem 1.25rem;
		border: 1px solid var(--line-divider);
		border-radius: var(--radius-large);
		background: var(--card-bg);
		transition: all 0.2s ease;
	}

	.changelog-card:hover {
		border-color: var(--primary);
		box-shadow: 0 4px 12px rgba(var(--primary-rgb), 0.08);
	}

	.changelog-message {
		margin: 0;
		font-size: 0.95rem;
		line-height: 1.6;
	}

	.changelog-hash {
		display: inline-block;
		margin-top: 0.5rem;
		font-size: 0.75rem;
		font-family: ui-monospace, monospace;
		color: var(--content-meta);
		text-decoration: none;
		transition: opacity 0.2s ease;
	}

	.changelog-hash:hover {
		opacity: 1;
		text-decoration: underline;
	}

	@media (width < 768px) {
		.changelog-list {
			padding-left: 1.25rem;
		}

		.changelog-list::before {
			left: 4px;
		}

		.changelog-dot {
			left: -1.25rem;
			width: 10px;
			height: 10px;
		}

		.changelog-card {
			padding: 0.875rem 1rem;
		}

		.changelog-message {
			font-size: 0.9rem;
		}
	}
</style>
