---
// 归档页 —— 1:1 移植 flatpaper layout/_partial/archive-list.ejs：
//   .archive-paper 纸卡 + h1 + .archive-list 平铺行（日期 / 标题 / 箭头）+ dashed 分隔线
// 样式见 src/styles/paper-archive.css（照搬 archive-taxonomy.styl，token 已映射）。
import I18nKey from "@i18n/i18nKey";
import { i18n } from "@i18n/translation";
import MainGridLayout from "@layouts/MainGridLayout.astro";
import { getSortedPosts } from "../utils/content-utils";
import { getPostUrl } from "../utils/url-utils";

import "../styles/paper-archive.css";

const posts = await getSortedPosts();

const items = posts
	.filter((entry) => entry.data.published !== false)
	.map((entry) => ({
		url: getPostUrl(entry),
		title: entry.data.title,
		date: entry.data.published
			? new Date(entry.data.published).toISOString().slice(0, 10)
			: "",
	}));
---

<MainGridLayout title={i18n(I18nKey.archive)}>
	<section class="archive-paper">
		<h1>{i18n(I18nKey.archive)}</h1>
		<div class="archive-list">
			{items.map((item) => (
				<a class="archive-item" href={item.url}>
					<span>{item.date}</span>
					<strong>{item.title}</strong>
					<em />
				</a>
			))}
		</div>
	</section>
</MainGridLayout>
