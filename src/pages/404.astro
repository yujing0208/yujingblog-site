---
import { Icon } from "astro-icon/components";

import I18nKey from "../i18n/i18nKey";
import { i18n } from "../i18n/translation";
import MainGridLayout from "../layouts/MainGridLayout.astro";
import "../styles/paper-page.css";
---

<MainGridLayout
	title={i18n(I18nKey.notFound)}
	description={i18n(I18nKey.notFoundDescription)}
>
	<!-- 引入右侧边栏布局管理器 -->
	<script>
		import("../scripts/right-sidebar-layout.js");
	</script>

	<!-- FlatPaper 404.ejs 壳层：article-tape-wrap + tape + not-found-paper 纸卡 -->
	<div class="article-tape-wrap w-full relative min-h-96">
		<span class="tape tape--top-right" aria-hidden="true"></span>
		<article class="article-paper not-found-paper card-base relative z-10 w-full">
			<header class="article-header not-found-header">
				<span class="label-pill">{i18n(I18nKey.notFound)}</span>
				<p class="not-found-code" aria-hidden="true">404</p>
				<h1>{i18n(I18nKey.notFoundTitle)}</h1>
				<p class="not-found-lead">{i18n(I18nKey.notFoundDescription)}</p>
			</header>

			<div class="not-found-actions">
				<a class="not-found-action" href="/">
					<Icon name="material-symbols:home-outline-rounded" is:inline class="w-4 h-4" />
					<span>{i18n(I18nKey.backToHome)}</span>
				</a>
				<a class="not-found-action" href="/archive/">
					<Icon name="material-symbols:article-outline" is:inline class="w-4 h-4" />
					<span>浏览文章</span>
				</a>
			</div>
		</article>
	</div>
</MainGridLayout>

<style>
	/* 卡片入场动画（保留原 404 页的浮入效果） */
	.article-paper.not-found-paper {
		animation: fadeInUp 0.6s ease-out;
	}

	@keyframes fadeInUp {
		from {
			opacity: 0;
			transform: translateY(30px);
		}
		to {
			opacity: 1;
			transform: translateY(0);
		}
	}
</style>
