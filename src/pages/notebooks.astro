									const inline = (s) => esc(s)
						.replace(/!\[([^\]]*)\]\(([^)]+)\)/g, (m, alt, url) => {
							const parts = (alt || "").split("|");
							const a = parts[0] || "";
							const w = parts[1] ? ` style="max-width:${parts[1]}px;border-radius:10px;margin:8px 0;display:block"` : ` style="max-width:100%;border-radius:10px;margin:8px 0;display:block"`;
							return `<img src="${url}" alt="${a}"${w}>`
						})
						.replace(/\*\*([^*]+)\*\*/g, "<b>$1</b>")
						.replace(/`([^`]+)`/g, "<code>$1</code>")
						.replace(/\*([^*]+)\*/g, "<i>$1</i>")
						.replace(/~~([^~]+)~~/g, "<s>$1</s>");
				const lines = src.split("\n");
				let h = "", i = 0;
				while (i < lines.length) {
					const l = lines[i];
					const head = l.match(/^(#{1,6})\s+(.*)$/);
					if (head) { const lv = Math.min(head[1].length, 4); const tag = lv <= 1 ? "h2" : lv === 2 ? "h3" : "h4"; h += `<${tag}>${inline(head[2])}</${tag}>`; i++; }

					else if (l.startsWith("> ")) { let t = l.slice(2), j = i + 1; while (lines[j] && lines[j].startsWith("> ")) { t += "<br>" + lines[j].slice(2); j++; } h += `<blockquote>${inline(t)}</blockquote>`; i = j; }
					else if (l.startsWith("|")) {
						const rows = []; let j = i; while (lines[j] && lines[j].startsWith("|")) { rows.push(lines[j]); j++; }
						let tbl = "<table>"; rows.forEach((r, k) => { const cells = r.split("|").slice(1, -1); if (k === 1 && /^[-: ]+$/.test(cells.map((c) => c.trim()).join(""))) return; tbl += `<tr>${cells.map((c) => `<${k === 0 ? "th" : "td"}>${inline(c.trim())}</${k === 0 ? "th" : "td"}>`).join("")}</tr>`; }); tbl += "</table>"; h += tbl; i = j;
					}
					else if (l.startsWith("- ")) { let t = "<ul>", j = i; while (lines[j] && lines[j].startsWith("- ")) { t += `<li>${inline(lines[j].slice(2))}</li>`; j++; } t += "</ul>"; h += t; i = j; }
					else if (/^\d+\.\s/.test(l)) { let t = "<ol>", j = i; while (lines[j] && /^\d+\.\s/.test(lines[j])) { t += `<li>${inline(lines[j].replace(/^\d+\.\s/, ""))}</li>`; j++; } t += "</ol>"; h += t; i = j; }
					else if (l.trim() === "") { i++; }
					else { let t = "", j = i; while (j < lines.length && lines[j].trim() !== "" && !/^#{1,6}\s/.test(lines[j]) && !lines[j].startsWith("|") && !lines[j].startsWith("- ")) { t += (t ? " " : "") + lines[j]; j++; } h += `<p>${inline(t)}</p>`; i = j; }
				}
				return h;
			}

			const $ = (s, r = document) => r.querySelector(s);
			function toast(msg) { const t = $("#toast"); t.textContent = msg; t.classList.add("show"); clearTimeout(t._t); t._t = setTimeout(() => t.classList.remove("show"), 1600); }
			function pace(dur, dist) { const [m, s] = dur.split(":").map(Number); const sec = m * 60 + s; const p = sec / dist; const mm = Math.floor(p / 60); const ss = Math.round(p % 60); return `${mm}'${String(ss).padStart(2, "0")}"`; }

			function renderShelf() {
				shelf.innerHTML = NOTEBOOKS.map((b) => `
					<div class="book" data-id="${b.id}" style="--accent:${b.accent}">
						<div class="spine"></div>
						<div class="pages"></div>
						<div class="cover">
							<div class="cf-top"><span>YuJing Library</span><span>${b.locked ? "🔒" : "📖"}</span></div>
							<div class="cf-main">
								<div class="cf-cn">${b.title}</div>
								<div class="cf-author">${b.author}</div>
							</div>
							<div class="cf-band"><span>${b.band}</span></div>
							<div class="cf-foot">
								<span class="cf-press"><b>Y</b> 自印 · 2026</span>
								<span class="cf-lock ${b.locked ? "" : "open"}">${b.locked ? '<svg viewBox="0 0 24 24" fill="none"><rect x="5" y="11" width="14" height="9" rx="2.5" stroke="#fff" stroke-width="2"/><path d="M8 11V7a4 4 0 0 1 8 0v4" stroke="#fff" stroke-width="2"/></svg>' : '<svg viewBox="0 0 24 24" fill="none"><path d="M5 11V7a4 4 0 0 1 8 0v4" stroke="#fff" stroke-width="2"/><path d="M18.5 3.5l2.5 2.5-5 5H11v-5l5-5z" fill="#fff"/></svg>'}</span>
							</div>
						</div>
					</div>`).join("");
				shelf.querySelectorAll(".book").forEach((el) => el.addEventListener("click", () => openNotebook(el.dataset.id)));
			}

			let pending = null, currentBook = null;
			function openNotebook(id) { const b = NOTEBOOKS.find((x) => x.id === id); if (b.locked) { pending = b; showPw(b); } else openReader(b); }
			function todayPw() { const d = new Date(); const p = (n) => String(n).padStart(2, "0"); return p(d.getFullYear() % 100) + p(d.getMonth() + 1) + p(d.getDate()); }
			function showPw(b) { $("#pwTitle").textContent = `《${b.title}》`; $("#pwHint").textContent = todayPw(); $("#pwInput").value = ""; $("#pwErr").textContent = ""; $("#pwOverlay").classList.add("show"); setTimeout(() => $("#pwInput").focus(), 200); }
			function tryUnlock() { if ($("#pwInput").value === todayPw()) { $("#pwOverlay").classList.remove("show"); openReader(pending); } else { $("#pwErr").textContent = "密码不对，再试试～"; const c = $("#pwCard"); c.classList.remove("shake"); void c.offsetWidth; c.classList.add("shake"); } }

			function openReader(b) { currentBook = b; const m = $("#bookModal"); m.innerHTML = b.type === "markdown" ? readerMarkdown(b) : b.type === "runs" ? readerRuns(b) : readerTexts(b); m.querySelector(".close-x").addEventListener("click", closeReader); $("#readerOverlay").classList.add("show"); }
			function closeReader() { $("#readerOverlay").classList.remove("show"); }

			function readerMarkdown(b) {
				const order = b._order || "old";
				const list = () => { const a = [...b.articles]; return order === "new" ? a.reverse() : a; };
				const dates = [...b.articles].map((a) => a.h).sort();
				const days = Math.round((new Date(dates[dates.length - 1]) - new Date(dates[0])) / 86400000);
				const arts = list();
				b._orderList = arts.map((a) => b.articles.indexOf(a));
				b._cur = 0;
				const toc = arts.map((a, i) => `<div class="toc-item" data-i="${b.articles.indexOf(a)}"><span class="idx">${String(i + 1).padStart(2, "0")}</span><span>${a.h}</span></div>`).join("");
				const body = arts.map((a) => `<div id="art-${b.articles.indexOf(a)}"><h2>${a.h}</h2>${md(a.body)}</div><hr class="nb-hr">`).join("");
				return `<button class="close-x" title="关闭">✕</button>
					<section class="left-page"><div class="page-pad">
						<div class="pg-head"><h2>目录</h2><button class="btn-soft" id="sortBtn">⇅ ${b._order === "new" ? "倒序" : "正序"}</button></div>
						<div class="recorded">📅 已记录 ${days} 天 · 共 ${b.articles.length} 篇</div>
						<button class="btn-soft" id="fishBtn" style="margin-bottom:10px;width:100%;justify-content:center">🎣 随机一篇</button>
						<div class="toc" id="toc">${toc}</div>
					</div></section>
					<div class="spine-shadow"></div>
					<section class="right-page"><div class="page-pad">
						<div class="pg-head"><h2>校园杂记</h2><span class="meta">余京 · 共 ${b.articles.length} 篇</span></div>
						<div class="art-nav"><button class="btn-soft" id="prevArt">← 上一篇</button><button class="btn-soft" id="nextArt">下一篇 →</button></div>
						<div class="content" id="content">${body}</div>
					</div></section>`;
			}

			function readerRuns(b) {
				const pct = Math.min(100, Math.round((b.totalKm / b.termGoal) * 100));
				const totalDist = b.runs.reduce((s, r) => s + r.distance, 0);
				const totalSec = b.runs.reduce((s, r) => { const [m, x] = r.duration.split(":").map(Number); return s + m * 60 + x; }, 0);
				const validHr = b.runs.filter((r) => r.heartRate != null);
				const avgHr = validHr.length ? Math.round(validHr.reduce((s, r) => s + r.heartRate, 0) / validHr.length) : "--";
				const avgPace = pace(`${Math.floor(totalSec / 60)}:${String(Math.round(totalSec % 60)).padStart(2, "0")}`, totalDist);
				const cards = b.runs.map((r) => `<div class="run-card"><div class="run-top"><span class="run-date">${r.date}</span><span class="run-dist">${r.distance} km</span></div><div class="run-grid"><span>用时 <b>${r.duration}</b></span><span>心率 <b>${r.heartRate ?? "--"}</b></span><span class="pace-tag">配速 ${pace(r.duration, r.distance)}/km</span></div></div>`).join("");
				const summary = `<div class="run-summary"><div class="rs-head">📊 本学期小结</div><div class="rs-grid"><div><span>总里程</span><b>${totalDist.toFixed(1)} km</b></div><div><span>打卡</span><b>${b.runs.length} 次</b></div><div><span>总用时</span><b>${Math.floor(totalSec / 60)}:${String(Math.round(totalSec % 60)).padStart(2, "0")}</b></div><div><span>平均配速</span><b>${avgPace}/km</b></div><div><span>平均心率</span><b>${avgHr}</b></div></div></div>`;
				return `<button class="close-x" title="关闭">✕</button>
					<section class="left-page"><div class="page-pad">
						<div class="pg-head"><h2>自律日记</h2></div>
						<div class="stat-num">${b.totalKm}<span style="font-size:18px;color:var(--nb-muted)"> km</span></div>
						<div class="stat-sub">本月打卡 ${b.monthCheckins} 次 · 学期目标 ${b.termGoal} km</div>
						<div class="progress"><i style="width:${pct}%"></i></div>
						<div class="stat-sub" style="margin-top:8px">已完成学期目标 ${pct}%</div>
					</div></section>
					<div class="spine-shadow"></div>
					<section class="right-page"><div class="page-pad">
						<div class="pg-head"><h2>跑步记录</h2><span class="meta">${b.runs.length} 条 · 上下滑动</span></div>
						<div class="content" id="content">${cards}${summary}</div>
					</div></section>`;
			}

			function readerTexts(b) {
				const items = [...b.texts].sort((a, c) => c.date.localeCompare(a.date));
				const toc = items.map((t, i) => `<div class="toc-item" data-i="${i}"><span class="idx">${t.date.slice(5)}</span><span class="lead">${t.content.slice(0, 12)}…</span></div>`).join("");
				const body = items.map((t, i) => `<div id="art-${i}"><div class="pg-head" style="margin:0 0 6px"><span class="run-date">${t.date}</span></div><p style="margin-top:0">${t.content}</p><hr class="nb-hr"></div>`).join("");
				return `<button class="close-x" title="关闭">✕</button>
					<section class="left-page"><div class="page-pad">
						<div class="pg-head"><h2>目录</h2></div>
						<div class="stat-sub" style="margin-bottom:10px">共 ${b.texts.length} 条思绪</div>
						<button class="btn-soft" id="fishBtn" style="margin-bottom:10px;width:100%;justify-content:center">🎣 随机一条</button>
						<div class="toc" id="toc">${toc}</div>
					</div></section>
					<div class="spine-shadow"></div>
					<section class="right-page"><div class="page-pad">
						<div class="pg-head"><h2>每日碎碎念</h2><span class="meta">余京</span></div>
						<div class="content" id="content">${body}</div>
					</div></section>`;
			}

			function gotoCur(b) {
				const el = document.getElementById(`art-${b._orderList[b._cur]}`);
				if (el) el.scrollIntoView({ behavior: "smooth", block: "start" });
				const m = $("#bookModal");
				m.querySelectorAll(".toc-item").forEach((x) => x.classList.remove("active"));
				const cur = m.querySelector(`.toc-item[data-i="${b._orderList[b._cur]}"]`);
				if (cur) cur.classList.add("active");
			}

			$("#bookModal").addEventListener("click", (e) => {
				const t = e.target.closest("#sortBtn,#fishBtn,#prevArt,#nextArt,.toc-item");
				if (!t) return;
				const b = currentBook;
				if (!b) return;
				if (t.id === "sortBtn") { b._order = b._order === "new" ? "old" : "new"; $("#bookModal").innerHTML = readerMarkdown(b); $("#bookModal").querySelector(".close-x").addEventListener("click", closeReader); }
				else if (t.id === "fishBtn") {
					if (b.type === "markdown") { b._cur = Math.floor(Math.random() * b._orderList.length); gotoCur(b); }
					else if (b.type === "texts") { const items = [...$("#bookModal").querySelectorAll(".toc-item")]; if (!items.length) return; const pick = items[Math.floor(Math.random() * items.length)]; const target = document.getElementById(`art-${pick.dataset.i}`); if (target) target.scrollIntoView({ behavior: "smooth", block: "start" }); items.forEach((x) => x.classList.remove("active")); pick.classList.add("active"); }
					toast("🎣 给你钓了一篇");
				} else if (t.id === "prevArt") { if (b._cur > 0) { b._cur--; gotoCur(b); } }
				else if (t.id === "nextArt") { if (b._cur < b._orderList.length - 1) { b._cur++; gotoCur(b); } }
				else if (t.classList.contains("toc-item")) { b._cur = b._orderList.indexOf(parseInt(t.dataset.i, 10)); gotoCur(b); }
			});

			$("#pwSubmit").addEventListener("click", tryUnlock);
			$("#pwInput").addEventListener("keydown", (e) => { if (e.key === "Enter") tryUnlock(); });
			$("#pwOverlay").addEventListener("click", (e) => { if (e.target.id === "pwOverlay") $("#pwOverlay").classList.remove("show"); });
			$("#readerOverlay").addEventListener("click", (e) => { if (e.target.id === "readerOverlay") closeReader(); });
			document.addEventListener("keydown", (e) => { if (e.key === "Escape") { closeReader(); $("#pwOverlay").classList.remove("show"); } });

			renderShelf();
		}

		if (document.readyState !== "loading") initNotebooks();
		else document.addEventListener("DOMContentLoaded", initNotebooks);
		document.addEventListener("swup:page:view", initNotebooks);
		if (window.swup && window.swup.hooks) { window.swup.hooks.on("page:view", initNotebooks); }
	</script>
</MainGridLayout>
