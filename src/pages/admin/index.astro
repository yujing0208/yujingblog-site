---
// /admin 单页管理台（v1 控制台版）
// 设计稿：preview/editor-preview.html（2026-10-04 视觉签收版）
// 数据层：复用 /js/editor 既有引擎（EditorGit / EditorTsIO / EditorMd / EditorForm / EditorUpload / EditorImgBed）
// 未迁入的旧编辑器（相册/公告）由 console.js 跳转到原 /admin/xxx-edit 页面
//
// ⚠️ 不要在本页写任何 <style>（哪怕 define:vars）：站点 astro.config 关了 cssCodeSplit，
// 全站 CSS 合并成单个 chunk，任何打包样式都会让本页引入 640KB 博客全局样式并覆盖 console.css。
// 编辑器样式全部走 public/js/editor/console.css（纯静态，不进打包管线）。
export const prerender = true;
---

<!doctype html>
<html lang="zh-CN">
<head>
	<meta charset="UTF-8" />
	<meta name="viewport" content="width=device-width, initial-scale=1" />
	<meta name="robots" content="noindex" />
	<title>记忆终端 · YuJing 的博客管理台</title>
	<link rel="stylesheet" href="/js/editor/console.css?v=1" />
</head>
<body>
	<div class="app">
		<aside class="side">
			<div class="side-brand">
				<div class="side-logo">
					<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 20h9"/><path d="M16.5 3.5a2.12 2.12 0 0 1 3 3L7 19l-4 1 1-4Z"/></svg>
				</div>
				<div class="side-brandtext">YuJing的记忆终端</div>
			</div>

			<div class="side-back">
				<button type="button" id="backSite">
					<svg class="ic" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M19 12H5"/><path d="M12 19l-7-7 7-7"/></svg>
					<span>回到站点</span>
				</button>
			</div>

			<nav class="side-scroll" id="nav"></nav>

			<button class="side-collapse" type="button" id="collapseBtn">
				<svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 18l-6-6 6-6"/></svg>
				<span>收起菜单</span>
			</button>
		</aside>

		<div class="scrim" id="scrim"></div>

		<div class="main">
			<header class="topbar">
				<button class="btn btn-icon hamburger" type="button" id="burger">
					<svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"><path d="M3 6h18M3 12h18M3 18h18"/></svg>
				</button>

				<div class="crumb" id="crumb"><b>仪表盘</b></div>
				<div class="topbar-sp"></div>

				<div class="status" id="status" title="点击查看推送面板" style="display:none">
					<span class="dot"></span><span id="statusText"></span>
				</div>
				<button class="btn btn-primary btn-sm" type="button" id="pushBtn" style="display:none">统一推送 (0)</button>

				<div class="crumb" style="gap:6px">
					<span class="pill" id="userPill">…</span>
				</div>
			</header>

			<main class="views" id="views">
				<section class="view on" id="v-dash"></section>
				<section class="view" id="v-posts"></section>
				<section class="view" id="v-diary"></section>
				<section class="view" id="v-friends"></section>
				<section class="view" id="v-projects"></section>
				<section class="view" id="v-website"></section>
				<section class="view" id="v-timeline"></section>
				<section class="view" id="v-anime"></section>
				<section class="view" id="v-devices"></section>
				<section class="view" id="v-footprints"></section>
				<section class="view" id="v-notebooks"></section>
				<section class="view" id="v-about"></section>
				<section class="view" id="v-albums"></section>
				<section class="view" id="v-announcement"></section>
				<section class="view" id="v-settings"></section>
				<section class="view" id="v-comments"></section>
				<section class="view" id="v-stats"></section>
				<section class="view" id="v-release"></section>
				<section class="view" id="v-cfbed"></section>
				<section class="view" id="v-backup"></section>
			</main>
		</div>
	</div>

	<div class="stage-mask" id="stageMask"></div>
	<aside class="stage-drawer" id="stageDrawer" aria-label="推送面板">
		<div class="stage-head">
			<h3>推送面板</h3>
			<button class="btn btn-sm" type="button" id="stageClose">关闭</button>
		</div>
		<div class="stage-list" id="stageList"></div>
		<div class="stage-foot">
			<button class="btn btn-primary" type="button" id="stagePush">统一推送</button>
			<button class="btn btn-danger" type="button" id="stageClear">清空</button>
		</div>
	</aside>

	<!-- 引擎脚本（全部沿用线上既有文件，顺序与旧编辑器一致） -->
	<script is:inline src="/js/editor/auth-gate.js?v=1"></script>
	<script is:inline src="/js/editor/github.js?v=4"></script>
	<script is:inline src="/js/editor/ts-io.js?v=3"></script>
	<script is:inline src="/js/editor/md.js?v=3"></script>
	<script is:inline src="/js/editor/markdown-it.min.js?v=1"></script>
	<script is:inline src="/js/editor/schema.js?v=3"></script>
	<script is:inline src="/js/editor/form.js?v=3"></script>
	<script is:inline src="/js/editor/upload.js?v=3"></script>
	<script is:inline src="/js/editor/imgbed.js?v=2"></script>
	<script is:inline src="/js/editor/console.js?v=1"></script>
</body>
</html>
