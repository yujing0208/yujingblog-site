---
// 可视化编辑器 · 路由壳
// /admin/<page>-edit → 加载对应编辑器（纯静态 bundle，运行时不依赖构建）
// 注意：EDIT_PAGES 必须定义在 getStaticPaths 内部——Astro 会把 getStaticPaths 提取为
// 独立模块，frontmatter 顶层非 export 的 const 不会进入该模块作用域（否则构建报 not defined）。
export const prerender = true;

import "@/styles/markdown.css";
import "@/styles/markdown-extend.styl";
import { siteConfig } from "@/config";

export function getStaticPaths() {
	const EDIT_PAGES = [
		"projects-edit",
		"friends-edit",
		"websites-edit",
		"about-edit",
		"timeline-edit",
		"diary-edit",
		"devices-edit",
		"anime-edit",
		"announcement-edit",
		"footprints-edit",
		"albums-edit",
		"post-edit",
	];
	return EDIT_PAGES.map((page) => ({ params: { page } }));
}

const { page } = Astro.params;
const pageName = page.replace(/-edit$/, "");
const hue = siteConfig.themeColor.hue;
---

<!doctype html>
<html lang="zh-CN">
<head>
	<meta charset="UTF-8" />
	<meta name="viewport" content="width=device-width, initial-scale=1" />
	<meta name="robots" content="noindex" />
	<title>内容编辑器 - {page}</title>
	<link rel="stylesheet" href="/js/editor/style.css?v=5" />
	<style define:vars={{ hue: String(hue) }}>
		:root { --hue: var(--hue); }
	</style>
</head>
<body data-editor-page={pageName}>
	<div id="ed-pages" class="ed-pages"></div>
	<div id="editor-root"></div>

	<script is:inline src="/js/editor/github.js?v=3"></script>
	<script is:inline src="/js/editor/ts-io.js?v=3"></script>
	<script is:inline src="/js/editor/md.js?v=3"></script>
	<script is:inline src="/js/editor/markdown-it.min.js?v=1"></script>
	<script is:inline src="/js/editor/schema.js?v=3"></script>
	<script is:inline src="/js/editor/form.js?v=3"></script>
	<script is:inline src="/js/editor/upload.js?v=3"></script>
	<script is:inline src="/js/editor/imgbed.js?v=2"></script>
	<script is:inline src="/js/editor/app.v2.js?v=9"></script>
</body>
</html>
