---
import Comment from "@components/comment/index.astro";
import MainGridLayout from "@layouts/MainGridLayout.astro";
import "../styles/paper-page.css";
import "../styles/paper-friends.css";
import { siteConfig } from "../config";
import { getFriendsList } from "../data/friends";

export const prerender = true;

if (!siteConfig.featurePages.friends) {
	return Astro.redirect("/404/");
}

const title = "友情链接";
const description = "这里收录了一些我喜欢的站点，欢迎互相交流走访。";

// 稳定顺序（与 FlatPaper links.yml 一致，不做随机洗牌）
const items = getFriendsList();

// ── 友链可达性 / 反链状态 ──
// 数据来自自建 Friend-Circle-Lite 的 link.json（GitHub Action 每 4 小时刷新，经 jsDelivr 分发）。
// 构建期抓取；取不到就退化为「无状态」（不显示小点），不阻断部署。
// 判定：不可达 或 已检测但无反链 → 迷失（红点，进底部折叠分组）；可达 → 绿点。
// ⚠️ 用 raw 而不是 jsDelivr：jsDelivr 对 @分支 文件是 max-age=604800（7 天）强缓存，
//   实测 Action 更新 link.json 后 CDN 仍返回旧版（has_backlink 全为 null）→ 状态点会全部退化成绿点。
const LINK_JSON = "https://raw.githubusercontent.com/yujing0208/Friend-Circle-Lite/page/link.json";

// ── 白名单 ──
// 名单里的站点：只要可达就是绿点，不再要求「检测到反链」（仍会因不可达进迷失）。
// 可填站点 URL 或站点名，两种写法都行；大小写 / 末尾斜杠 / www 前缀都不敏感。
// 加人方式：往下面数组里加一行字符串即可。
const WHITELIST: string[] = [
	// "https://example.com/",
	// "某某站点",
];

function normKey(v: string): string {
	const s = String(v || "").trim();
	if (/^https?:\/\//i.test(s)) return normSite(s);
	return s.toLowerCase();
}

const whitelistKeys = new Set<string>(WHITELIST.map(normKey));

function normSite(u: string): string {
	const raw = String(u || "").trim();
	try {
		const url = new URL(raw);
		return (url.host.replace(/^www\./, "") + url.pathname.replace(/\/+$/, "")).toLowerCase();
	} catch {
		return raw.replace(/^https?:\/\//, "").replace(/^www\./, "").replace(/\/+$/, "").toLowerCase();
	}
}

type FriendState = "ok" | "lost" | "unknown";
type FriendStatus = { state: FriendState; reason: string };

const linkStatus = new Map<string, { reachable: boolean | null; hasBacklink: boolean | null }>();
try {
	const controller = new AbortController();
	const timer = setTimeout(() => controller.abort(), 8000);
	const res = await fetch(LINK_JSON, { headers: { Accept: "application/json,text/plain,*/*" }, signal: controller.signal });
	clearTimeout(timer);
	if (res.ok) {
		const data = await res.json();
		for (const row of (data && data.link_data) || []) {
			if (!row || !row.link) continue;
			linkStatus.set(normSite(row.link), {
				reachable: typeof row.reachable === "boolean" ? row.reachable : null,
				hasBacklink: typeof row.has_backlink === "boolean" ? row.has_backlink : null,
			});
		}
	}
} catch (e) {
	// 构建期取不到就退化为「无状态」
}

function statusOf(item: { siteurl: string; title: string }): FriendStatus {
	const st = linkStatus.get(normSite(item.siteurl));
	if (!st) return { state: "unknown", reason: "" };
	if (st.reachable === false) return { state: "lost", reason: "站点不可达" };
	// 白名单：不要求反链，可达即绿点
	if (whitelistKeys.has(normSite(item.siteurl)) || whitelistKeys.has(normKey(item.title))) return { state: "ok", reason: "可达（白名单）" };
	// hasBacklink 三种取值：true=检测到了反链 / false=检测过但没有 / null=判定不了
	// （没配友链页，或页面是 SPA·跳转壳，抓不出友链列表）。只有 false 才进迷失，
	// null 不能当成「无反链」冤枉人。
	if (st.hasBacklink === true) return { state: "ok", reason: "可达 · 已检测到反链" };
	if (st.hasBacklink === false) return { state: "lost", reason: "未检测到反链" };
	if (st.reachable === true) return { state: "ok", reason: st.hasBacklink === null ? "可达 · 无法检测反链" : "可达" };
	return { state: "unknown", reason: "" };
}

const statusMap = new Map<string, FriendStatus>();
for (const f of items) statusMap.set(f.siteurl, statusOf(f));
const lostItems = items.filter((f) => statusMap.get(f.siteurl)?.state === "lost");

// 按主标签分组，对应 FlatPaper 的 class_name 分组（friends-group__head）
const GROUP_DESCS: Record<string, string> = {
	博客: "收录的博客站点，欢迎互相走访。",
	社团: "校园技术社团与组织。",
	博客园: "中文独立博客聚合与发现。",
};
type Group = { name: string; desc?: string; items: typeof items };
const groups: Group[] = [];
for (const item of items) {
	// 不可达 / 未检测到反链的站点不进常规分组，统一收到底部「迷失」
	if (statusMap.get(item.siteurl)?.state === "lost") continue;
	const name = item.tags?.[0] ?? "其他";
	let g = groups.find((x) => x.name === name);
	if (!g) {
		g = { name, desc: GROUP_DESCS[name], items: [] };
		groups.push(g);
	}
	g.items.push(item);
}

// 某分组若整组都进了迷失，则不再展示空标题
for (let i = groups.length - 1; i >= 0; i -= 1) {
	if (!groups[i].items.length) groups.splice(i, 1);
}

// 头像加载失败时的占位图（内联 SVG，不需要静态资源）
const FALLBACK_AVATAR =
	"data:image/svg+xml," +
	encodeURIComponent(
		`<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 50 50"><rect width="50" height="50" fill="#d8e8d2"/><g fill="none" stroke="#4f8862" stroke-width="2.6" stroke-linecap="round"><path d="M20 30 L14 36 M36 20 L30 26 M22 22 l6 6 M15 25 a7 7 0 0 1 0-10 l3-3 a7 7 0 0 1 10 0 M35 25 a7 7 0 0 1 0 10 l-3 3 a7 7 0 0 1-10 0" transform="translate(0,-3)"/></g></svg>`,
	);
const onAvatarError = `this.onerror=null;this.src='${FALLBACK_AVATAR}'`;
---

<MainGridLayout title={title} description={description}>
	<!-- FlatPaper link.ejs 壳层：article-paper--with-top-img（顶图出血 + 标题上移压图） -->
	<article class="article-paper friends-page article-paper--with-top-img article-paper--page-top-img card-base relative z-10 w-full">
		<!-- 顶图：FlatPaper 朋友圈同款拼贴图。
		     ⚠️ 必须放 public/assets/**（构建时 public/images 会被 sync-content 整体替换成内容仓的 images）
		     ⚠️ ?v=2：/assets/** 是 `max-age=31536000, immutable` 的一年缓存，且**连 404 一起缓存**。
		        2026-10-03 的 assets 覆盖事故把这个不带版本号的 URL 在 CDN 上冻成了 404，
		        源文件修好也回不来 —— 只能靠换 URL 解冻。 -->
		<figure class="article-top-img article-top-img--page" aria-label="友情链接">
			<img
				src="/assets/friends/links-top.webp?v=2"
				alt=""
				loading="eager"
				fetchpriority="high"
				referrerpolicy="no-referrer"
				draggable="false"
			/>
		</figure>

		<!-- 页面头：label-pill + h1 + 副标题（flatpaper article-header，压在顶图下缘） -->
		<header class="article-header">
			<span class="label-pill">友链</span>
			<h1>{title}</h1>
			{description && <p class="friends-subtitle">{description}</p>}
		</header>

		<!-- FlatPaper friends-group / friends-grid / friend-card--tape -->
		{
			groups.map((group) => (
				<section class="friends-group">
					<div class="friends-group__head">
						<h2>
							<span class="green-dot" />
							{group.name}
						</h2>
						{group.desc && <span class="friends-group__desc">{group.desc}</span>}
					</div>

					<ul class="friends-grid">
						{group.items.map((item) => (
							<li class="friend-card friend-card--tape">
								<a
									class="friend-card__link"
									href={item.siteurl}
									target="_blank"
									rel="noopener noreferrer"
									title={`${item.title} · ${item.desc}`}
								>
									<div class="friend-card__avatar-wrap">
										<img
											class="friend-card__avatar"
											src={item.imgurl}
											alt={item.title}
											loading="lazy"
											referrerpolicy="no-referrer"
											onerror={onAvatarError}
										/>
									</div>
									<div class="friend-card__body">
										<span class="friend-card__title-row">
											<strong class="friend-card__name">{item.title}</strong>
											{statusMap.get(item.siteurl)?.state === "unknown" ? null : (
												<span
													class:list={[
														"friend-card__status",
														statusMap.get(item.siteurl)?.state === "ok" ? "friend-card__status--ok" : "friend-card__status--lost",
													]}
													title={statusMap.get(item.siteurl)?.reason || "可达"}
													aria-label={statusMap.get(item.siteurl)?.reason || "可达"}
												/>
											)}
										</span>
										<span class="friend-card__desc">{item.desc}</span>
									</div>
								</a>
								{item.rss && (
									<a
										class="friend-card__rss"
										href={item.rss}
										target="_blank"
										rel="noopener noreferrer"
										aria-label={`${item.title} 的 RSS`}
										title="RSS"
									>
										<svg
											xmlns="http://www.w3.org/2000/svg"
											width="1em"
											height="1em"
											viewBox="0 0 24 24"
											fill="none"
											stroke="currentColor"
											stroke-width="1.8"
											stroke-linecap="round"
											stroke-linejoin="round"
											class="lucide lucide-rss"
											aria-hidden="true"
										>
											<path d="M4 11a9 9 0 0 1 9 9" />
											<path d="M4 4a16 16 0 0 1 16 16" />
											<circle cx="5" cy="19" r="1" />
										</svg>
									</a>
								)}
							</li>
						))}
					</ul>
				</section>
			))
		}
			{/* ── 迷失：不可达或未检测到反链的站点（FCLite link.json，默认折叠）── */}
		{
			lostItems.length > 0 && (
				<details class="friends-group friends-group--lost">
					<summary class="friends-group__head friends-group__summary">
						<h2>
							<span class="friend-card__status friend-card__status--lost" />
							迷失
						</h2>
						<span class="friends-group__desc">不可达或未检测到反链的站点 · {lostItems.length} 个</span>
						<span class="friends-group__chevron" aria-hidden="true" />
					</summary>

					<ul class="friends-grid">
						{lostItems.map((item) => {
							const lostReason = statusMap.get(item.siteurl)?.reason || "状态异常";
							return (
								<li class="friend-card friend-card--tape">
									<a
										class="friend-card__link"
										href={item.siteurl}
										target="_blank"
										rel="noopener noreferrer"
										title={`${item.title} · ${lostReason}`}
									>
										<div class="friend-card__avatar-wrap">
											<img
												class="friend-card__avatar"
												src={item.imgurl}
												alt={item.title}
												loading="lazy"
												referrerpolicy="no-referrer"
												onerror={onAvatarError}
											/>
										</div>
										<div class="friend-card__body">
											<span class="friend-card__title-row">
												<strong class="friend-card__name">{item.title}</strong>
												<span
													class="friend-card__status friend-card__status--lost"
													title={lostReason}
													aria-label={lostReason}
												/>
											</span>
											<span class="friend-card__desc">{item.desc}</span>
										</div>
									</a>
								</li>
							);
						})}
					</ul>
				</details>
			)
		}

		<!-- 本站信息 / 申请模板 / 友链申请要求（照抄 homulilly.com /links/ 的 friends-intro）
		     必须位于 article-paper 纸卡内部，和友链卡片同板 -->
		<div class="friends-intro">
		<p><strong>本站信息</strong> : </p>
		<figure class="highlight yaml">
			<span class="code-bar">
				<span class="code-lang">YAML</span>
				<button type="button" class="code-action code-copy" aria-label="复制代码">
					<svg xmlns="http://www.w3.org/2000/svg" width="1em" height="1em" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-copy" aria-hidden="true"><rect width="14" height="14" x="8" y="8" rx="2" ry="2" /><path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2" /></svg>
				</button>
				<button type="button" class="code-action code-fold" aria-label="折叠代码">
					<svg xmlns="http://www.w3.org/2000/svg" width="1em" height="1em" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-chevron-up" aria-hidden="true"><path d="m18 15-6-6-6 6" /></svg>
				</button>
			</span>
			<table>
				<tr>
					<td class="gutter"><pre><span class="line">1</span><br /><span class="line">2</span><br /><span class="line">3</span><br /><span class="line">4</span><br /><span class="line">5</span><br /></pre></td>
					<td class="code"><pre><span class="line"><span class="attr">name:</span> <span class="string">YuJing的记忆终端</span></span><br /><span class="line"><span class="attr">link:</span> <span class="string">https://yujingblog.top</span></span><br /><span class="line"><span class="attr">descr:</span> <span class="string">记一些无用的日常，和有光的时刻。</span></span><br /><span class="line"><span class="attr">avatar:</span> <span class="string">https://yujingblog.top/assets/home/avatar.webp</span></span><br /><span class="line"><span class="attr">rss:</span> <span class="string">https://yujingblog.top/atom.xml</span></span><br /></pre></td>
				</tr>
			</table>
		</figure>
		<figure class="highlight yaml">
			<span class="code-bar">
				<span class="code-lang">YAML</span>
				<button type="button" class="code-action code-copy" aria-label="复制代码">
					<svg xmlns="http://www.w3.org/2000/svg" width="1em" height="1em" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-copy" aria-hidden="true"><rect width="14" height="14" x="8" y="8" rx="2" ry="2" /><path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2" /></svg>
				</button>
				<button type="button" class="code-action code-fold" aria-label="折叠代码">
					<svg xmlns="http://www.w3.org/2000/svg" width="1em" height="1em" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-chevron-up" aria-hidden="true"><path d="m18 15-6-6-6 6" /></svg>
				</button>
			</span>
			<table>
				<tr>
					<td class="gutter"><pre><span class="line">1</span><br /><span class="line">2</span><br /><span class="line">3</span><br /><span class="line">4</span><br /><span class="line">5</span><br /></pre></td>
					<td class="code"><pre><span class="line"><span class="attr">name:</span> </span><br /><span class="line"><span class="attr">link:</span> </span><br /><span class="line"><span class="attr">descr:</span> </span><br /><span class="line"><span class="attr">avatar:</span> </span><br /><span class="line"><span class="attr">rss:</span> </span><br /></pre></td>
				</tr>
			</table>
		</figure>
		<details class="flatpaper-note flatpaper-note--info flatpaper-note--sticky" open>
			<summary class="flatpaper-note__title">
				<span class="flatpaper-note__icon" aria-hidden="true"></span>
				<span class="flatpaper-note__label">友链申请要求</span>
				<span class="flatpaper-note__chevron" aria-hidden="true"></span>
			</summary>
			<div class="flatpaper-note__body">
				<ol>
					<li>网站需全站启用 HTTPS，访问稳定。</li>
					<li>接受博客、笔记、生活记录等类型的个人网站。</li>
					<li>网站需已发布 10 篇以上原创文章，并保持长期更新与维护。</li>
					<li>内容应具有一定价值，避免大量转载、采集或低质量内容。</li>
					<li>暂不接受免费域名、临时域名或无法长期稳定访问的网站申请友链。</li>
				</ol>
			</div>
		</details>
	</div>
	</article>

	<!-- 复制 / 折叠按钮交互（document 级委托，swup 换页后依然有效） -->
	<script is:inline>
		(function () {
			if (window.__fpFriendsCodeWired) return;
			window.__fpFriendsCodeWired = true;
			document.addEventListener("click", function (e) {
				var t = e.target;
				if (!t || !t.closest) return;
				var scope = document.querySelector(".friends-intro");
				if (!scope) return;
				var copyBtn = t.closest(".friends-intro .code-copy");
				if (copyBtn) {
					var fig = copyBtn.closest("figure.highlight");
					if (!fig) return;
					var lines = fig.querySelectorAll("td.code .line");
					var text = Array.prototype.map.call(lines, function (l) { return l.textContent; }).join("\n");
					var done = function () {
						copyBtn.classList.add("is-copied");
						setTimeout(function () { copyBtn.classList.remove("is-copied"); }, 1200);
					};
					if (navigator.clipboard && navigator.clipboard.writeText) {
						navigator.clipboard.writeText(text).then(done, done);
					} else {
						var ta = document.createElement("textarea");
						ta.value = text;
						document.body.appendChild(ta);
						ta.select();
						try { document.execCommand("copy"); } catch (err) {}
						ta.remove();
						done();
					}
					return;
				}
				var foldBtn = t.closest(".friends-intro .code-fold");
				if (foldBtn) {
					var f = foldBtn.closest("figure.highlight");
					if (f) f.classList.toggle("is-folded");
				}
			});
		})();
	</script>

	<!-- 评论区 -->
	<Comment path="/friends" />
</MainGridLayout>
