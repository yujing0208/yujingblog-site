---
import Pagination from "@components/control/Pagination.astro";
import CategoryBar from "@components/features/posts/CategoryBar.astro";
import PaperFeaturedCarousel from "@components/features/posts/PaperFeaturedCarousel.astro";
import PaperPostList from "@components/features/posts/PaperPostList.astro";
import PostPage from "@components/features/posts/PostPage.astro";
import MainGridLayout from "@layouts/MainGridLayout.astro";
import PaperHomeLayout from "@layouts/PaperHomeLayout.astro";
import { render } from "astro:content";
import type { GetStaticPaths } from "astro";

import { siteConfig } from "../config";
import { PAGE_SIZE } from "../constants/constants";
import { getSortedPosts } from "../utils/content-utils";
import { initPostIdMap } from "../utils/permalink-utils";
import { getPostUrl } from "../utils/url-utils";

const showCategoryBar = siteConfig.postListLayout.categoryBar?.enable ?? false;

// 首页是否走手账布局（PaperHomeLayout + PaperPostList）。
// 关掉后完全回落到原有 MainGridLayout + PostPage，功能一条不删。
const usePaperHome =
	(siteConfig.homeLayout ?? "banner") === "paper" &&
	(siteConfig.paperHero?.enable ?? true);

export const getStaticPaths = (async ({ paginate }) => {
	const allBlogPosts = await getSortedPosts();
	// 初始化文章 ID 映射（用于 permalink 功能）
	initPostIdMap(allBlogPosts);
	return paginate(allBlogPosts, { pageSize: PAGE_SIZE });
}) satisfies GetStaticPaths;
// https://github.com/withastro/astro/issues/6507#issuecomment-1489916992

const { page } = Astro.props;

const len = page.data.length;
const isFirstPage = (page.currentPage ?? 1) === 1;

// 手账布局对分页全量生效（2026-10-01 需求）：
// 「首页点下一页后的所有页面都要和首页保持一样的文章卡片布局，都是双侧边栏」。
// 旧逻辑只在第 1 页用纸片布局，第 2 页起回落 MainGridLayout，
// 导致卡片样式与侧栏（单/双栏）跟首页完全不一样。现在统一走 PaperHomeLayout。
const paperMode = usePaperHome;

// 置顶文章（照搬 flatpaper 的 featured：取 frontmatter pinned 的文章，
// 按时间倒序，最多 4 篇 —— 对应原版 keys.slice(0, 4)）
const featuredItems = paperMode
	? await (async () => {
			const pinned = page.data.filter((e: any) => e.data.pinned === true).slice(0, 4);
			const items = [];
			for (const entry of pinned) {
				const { remarkPluginFrontmatter } = await render(entry);
				items.push({
					slug: entry.id,
					url: getPostUrl(entry),
					title: entry.data.title,
					summary: String(
						entry.data.description ??
							remarkPluginFrontmatter?.excerpt ??
							"",
					)
						.replace(/<[^>]*>/gu, " ")
						.replace(/\s+/gu, " ")
						.trim(),
					date: entry.data.published
						? new Date(entry.data.published).toISOString().slice(0, 10)
						: "",
					category: entry.data.category ?? "",
					image: entry.data.image ?? "",
				});
			}
			return items;
		})()
	: [];
// 置顶文章已进轮播，从「最新文章」列表排除，避免重复
const featuredSlugs = featuredItems.map((it) => it.slug);
---

{
	paperMode ? (
		<PaperHomeLayout title={siteConfig.title} description={siteConfig.subtitle}>
			{/* 置顶文章轮播（照搬 flatpaper featured-carousel）：仅第 1 页显示。
			    第 2 页起 page.data 里没有置顶文章（getRawSortedPosts 把 pinned 排在最前），
			    显式用 isFirstPage 关掉，保证分页页与首页的差异只有「列表内容」。 */}
			{isFirstPage && <PaperFeaturedCarousel items={featuredItems} autoplay={5000} />}
			<PaperPostList page={page} heading="最新文章" />
		</PaperHomeLayout>
	) : (
		<MainGridLayout>
			{showCategoryBar && <CategoryBar />}
			<PostPage page={page} />
			<Pagination
				class="mx-auto onload-animation"
				page={page}
				style={`animation-delay: calc(var(--content-delay) + ${len * 50}ms)`}
			/>
		</MainGridLayout>
	)
}
