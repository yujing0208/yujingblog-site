---
import { MomentCard } from "@components/features/diary";
import MomentsCover from "@components/features/diary/MomentsCover.astro";
import MainGridLayout from "@layouts/MainGridLayout.astro";

// 展开评论区与文章页共用一套 Twikoo 功能性样式（OwO 面板尺寸等）
import "../styles/twikoo.css";

import { siteConfig } from "../config";
import type { DiaryItem } from "../data/diary";
import { getDiaryList } from "../data/diary";
import I18nKey from "../i18n/i18nKey";
import { i18n } from "../i18n/translation";

if (!siteConfig.featurePages.diary) {
	return Astro.redirect("/404/");
}

const moments = getDiaryList();

const title = i18n(I18nKey.diary);
const subtitle = i18n(I18nKey.diarySubtitle);

// 置顶（兼容 DiaryItem 无 pinned 字段的情况）
type DiaryItemWithPinned = DiaryItem & { pinned?: boolean };
const pinnedMoments = moments.filter((m) => (m as DiaryItemWithPinned).pinned);
const normalMoments = moments.filter((m) => !(m as DiaryItemWithPinned).pinned);
---

<MainGridLayout title={title} description={subtitle}>
  <!-- 微信朋友圈风格封面 -->
  <MomentsCover />

  <!-- 置顶说说（无置顶时隐藏） -->
  <a
    href="/diary/"
    class="wx-pinned"
    id="pinned-block"
    style={pinnedMoments.length === 0 ? "display:none" : ""}
  >
    <div class="wx-pinned-tag">
      <span>置顶</span>
    </div>
    <div class="wx-pinned-items" id="pinned-items">
      {
        pinnedMoments.map((m) => (
          <div class="wx-pinned-preview">
            {m.images && m.images.length > 0 ? (
              <div class={`wx-pimgs wx-pimgs-${Math.min(m.images.length, 9)}`}>
                {m.images.slice(0, 9).map((img) => (
                  <img src={img} class="wx-pinned-img" loading="lazy" alt="" />
                ))}
              </div>
            ) : (
              <p class="wx-ptxt">
                {m.content.slice(0, 60)}
                {m.content.length > 60 ? "..." : ""}
              </p>
            )}
          </div>
        ))
      }
    </div>
  </a>

  <!-- 标签筛选状态条（默认隐藏，点击标签后出现） -->
  <div class="wx-filter-bar" id="wx-filter-bar" hidden>
    <span class="wx-filter-icon">
      <svg
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        width="14"
        height="14"
      >
        <polygon points="22 3 2 3 10 12.46 10 19 14 21 14 12.46 22 3"></polygon>
      </svg>
    </span>
    <span class="wx-filter-tag" id="wx-filter-tag"></span>
    <span class="wx-filter-count" id="wx-filter-count"></span>
    <button type="button" class="wx-filter-clear" id="wx-filter-clear">
      <svg
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        width="12"
        height="12"
      >
        <line x1="18" y1="6" x2="6" y2="18"></line>
        <line x1="6" y1="6" x2="18" y2="18"></line>
      </svg>
      显示全部
    </button>
  </div>

  <!-- 说说列表 -->
  <div class="wx-feed" id="moments-feed">
    {
      normalMoments.length > 0 ? (
        normalMoments.map((moment) => (
          <div class="wx-feed-item">
            <MomentCard moment={moment} />
            <div
              class="twikoo-entry-comments mt-3 hidden"
              data-diary-id={moment.id}
            >
              {/* 与文章页评论区同一套纸卡外壳（comments-section，样式见 paper-comments.css，
                  全局主包已引入）：撕边纸层 + 顶部粉胶带 + 「评论」标题 */}
              <section
                class="comments-section diary-comments-section"
                aria-label="评论"
              >
                <header class="comments-section__head">
                  <h2>
                    <svg
                      class="lucide"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="1.8"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      width="18"
                      height="18"
                      aria-hidden="true"
                    >
                      <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"></path>
                    </svg>
                    评论
                  </h2>
                </header>
                <div id={`tcomment-${moment.id}`}></div>
              </section>
            </div>
          </div>
        ))
      ) : (
        <div class="wx-empty" id="moments-empty">
          <div class="wx-empty-icon">
            <svg
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.5"
              stroke-linecap="round"
              stroke-linejoin="round"
              width="32"
              height="32"
            >
              <circle cx="12" cy="12" r="10"></circle>
              <path d="M8 15h8"></path>
              <line x1="9" y1="9" x2="9.01" y2="9"></line>
              <line x1="15" y1="9" x2="15.01" y2="9"></line>
            </svg>
          </div>
          <h3>还没有发布任何动态</h3>
          <p>快去记录你的生活点滴吧</p>
        </div>
      )
    }
  </div>

  <!-- ═══════ 评论按钮（twikoo，保留现有行为） ═══════ -->
  <script is:inline>
    (function () {
      const TWIKOO_SCRIPT_URL = "/assets/js/twikoo.all.min.js?v=1.7.14";
      const COMMENT_CONFIG = {
        envId: "https://twikoo.yujingblog.top",
        lang: "zh-CN",
      };

      let scriptLoading = false;
      let scriptLoaded = false;
      const loadedEntries = new Set();

      async function ensureScript() {
        if (scriptLoaded || document.getElementById("twikoo-diary-script")) {
          return;
        }
        if (scriptLoading) {
          await new Promise((resolve) => {
            const check = setInterval(() => {
              if (scriptLoaded) {
                clearInterval(check);
                resolve();
              }
            }, 100);
          });
          return;
        }
        scriptLoading = true;
        return new Promise((resolve, reject) => {
          const script = document.createElement("script");
          script.id = "twikoo-diary-script";
          script.src = TWIKOO_SCRIPT_URL;
          script.async = true;
          script.onload = () => {
            scriptLoaded = true;
            resolve();
          };
          script.onerror = reject;
          document.head.appendChild(script);
        });
      }

      async function initEntry(_container, diaryId) {
        if (!diaryId || loadedEntries.has(diaryId)) return;
        try {
          await ensureScript();
          if (typeof twikoo === "undefined") return;
          loadedEntries.add(diaryId);
          await twikoo.init({
            ...COMMENT_CONFIG,
            el: "#tcomment-" + diaryId,
            path: "/diary/" + diaryId,
          });
        } catch (e) {
          console.error("[Twikoo Diary] 初始化失败:", diaryId, e);
        }
      }

      function handleToggle(btn) {
        const diaryId = btn.dataset.diaryId;
        const wrapper = btn.closest(".wx-feed-item") || btn.closest(".diary-entry-wrapper");
        if (!wrapper || !diaryId) return;
        const comments = wrapper.querySelector(".twikoo-entry-comments");
        const text = btn.querySelector(".twikoo-toggle-text");
        if (!comments) return;
        const isOpen = !comments.classList.contains("hidden");
        if (isOpen) {
          comments.classList.add("hidden");
          if (text) text.textContent = "评论";
        } else {
          comments.classList.remove("hidden");
          if (text) text.textContent = "收起";
          if (!loadedEntries.has(diaryId)) {
            initEntry(comments, diaryId);
          }
        }
      }

      function bindButtons() {
        document.querySelectorAll(".twikoo-toggle-btn").forEach((btn) => {
          if (btn.dataset.twikooBound) return;
          btn.dataset.twikooBound = "1";
          btn.addEventListener("click", () => handleToggle(btn));
        });
      }

      if (document.readyState === "loading") {
        document.addEventListener("DOMContentLoaded", bindButtons);
      } else {
        bindButtons();
      }

      document.addEventListener("swup:contentReplaced", () => {
        setTimeout(bindButtons, 200);
      });
      document.addEventListener("mizuki:page:loaded", () => {
        bindButtons();
      });
    })();
  </script>

  <!-- ═══════ 标签筛选：点击标签过滤同类说说 ═══════ -->
  <script is:inline>
    (function () {
      // 模块级状态：当前筛选标签（null=全部）
      let currentTag = null;

      function applyFilter(tag) {
        currentTag = tag || null;

        const feed = document.getElementById("moments-feed");
        const filterBar = document.getElementById("wx-filter-bar");
        const filterTagEl = document.getElementById("wx-filter-tag");
        const filterCountEl = document.getElementById("wx-filter-count");
        const pinnedBlock = document.getElementById("pinned-block");
        if (!feed || !filterBar) return;

        // 1) 过滤说说卡片
        let visible = 0;
        feed.querySelectorAll(".wx-feed-item").forEach((item) => {
          let match = true;
          if (currentTag) {
            match = Array.from(item.querySelectorAll(".tag-item")).some(
              (t) => t.dataset.tag === currentTag,
            );
          }
          item.classList.toggle("is-filtered-out", !match);
          if (match) visible++;
        });

        // 2) 置顶块：含该标签才显示
        if (pinnedBlock) {
          if (currentTag) {
            const pMatch = Array.from(pinnedBlock.querySelectorAll(".tag-item")).some(
              (t) => t.dataset.tag === currentTag,
            );
            pinnedBlock.style.display = pMatch ? "" : "none";
          } else {
            // 无筛选：仅当确有置顶内容时才显示，否则保持隐藏
            const hasPinned = pinnedBlock.querySelector(".wx-pinned-preview");
            pinnedBlock.style.display = hasPinned ? "" : "none";
          }
        }

        // 3) 高亮当前标签
        document.querySelectorAll(".tag-item").forEach((t) => {
          t.classList.toggle("active", currentTag !== null && t.dataset.tag === currentTag);
        });

        // 4) 筛选状态条
        if (currentTag) {
          filterBar.hidden = false;
          if (filterTagEl) filterTagEl.textContent = "#" + currentTag;
          if (filterCountEl) filterCountEl.textContent = "· " + visible + " 条";
        } else {
          filterBar.hidden = true;
        }

        // 5) 同步 URL（支持 ?tag= 深链，不触发跳转）
        try {
          const url = new URL(window.location.href);
          if (currentTag) url.searchParams.set("tag", currentTag);
          else url.searchParams.delete("tag");
          history.replaceState(null, "", url.toString());
        } catch (e) {
          /* ignore */
        }
      }

      // 标签点击：document 级事件委托（swup 换页后依旧有效）
      document.addEventListener("click", (e) => {
        const tagEl = e.target.closest(".tag-item");
        if (!tagEl) return;
        const feed = document.getElementById("moments-feed");
        if (!feed || !feed.contains(tagEl)) return;
        const tag = tagEl.dataset.tag;
        if (!tag) return;
        // 再次点击当前标签 = 取消筛选
        applyFilter(currentTag === tag ? null : tag);
      });

      // 每次 DOM 就绪（含 swup 换页）时：绑定清除按钮 + 按 URL 恢复筛选
      function boot() {
        const clearBtn = document.getElementById("wx-filter-clear");
        if (clearBtn && !clearBtn.dataset.bound) {
          clearBtn.dataset.bound = "1";
          clearBtn.addEventListener("click", () => applyFilter(null));
        }
        let initTag = null;
        try {
          initTag = new URL(window.location.href).searchParams.get("tag");
        } catch (e) {
          /* ignore */
        }
        applyFilter(initTag);
      }

      if (document.readyState === "loading") {
        document.addEventListener("DOMContentLoaded", boot);
      } else {
        boot();
      }
      document.addEventListener("swup:contentReplaced", () => {
        setTimeout(boot, 200);
      });
      document.addEventListener("mizuki:page:loaded", boot);
    })();
  </script>

</MainGridLayout>

<style>
  /* ============================================
   * 说说列表
   * ============================================ */
  .wx-feed {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    padding: 1rem 0 2rem;
  }

  .wx-feed-item {
    position: relative;
  }

  .wx-feed-item.is-filtered-out {
    display: none;
  }

  .wx-feed-item:not(.is-filtered-out) + .wx-feed-item:not(.is-filtered-out)::before {
    content: '';
    position: absolute;
    top: -0.75rem;
    left: 1rem;
    right: 1rem;
    height: 0;
    border-top: 1px dashed var(--paper-dash);
  }

  /* 标签筛选状态条（手账手绘方框） */
  .wx-filter-bar {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.5rem 0.875rem;
    margin-bottom: 1rem;
    background: var(--paper-warm);
    border: 1.5px dashed var(--dash);
    border-radius: var(--radius-handdrawn);
    font-size: 0.8125rem;
    color: var(--ink);
  }
  .wx-filter-bar[hidden] {
    display: none;
  }
  .wx-filter-icon {
    display: inline-flex;
    color: var(--color-accent-strong);
    flex-shrink: 0;
  }
  .wx-filter-tag {
    font-weight: 600;
    color: var(--color-accent-strong);
  }
  .wx-filter-count {
    color: var(--ink-soft);
  }
  .wx-filter-clear {
    margin-left: auto;
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    padding: 0.25rem 0.625rem;
    font-size: 0.75rem;
    color: var(--ink-soft);
    background: transparent;
    border: 1.5px dashed var(--dash);
    border-radius: var(--radius-handdrawn);
    cursor: pointer;
    transition:
      color 0.2s ease,
      background 0.2s ease,
      border-color 0.2s ease;
  }
  .wx-filter-clear:hover {
    color: var(--color-accent-strong);
    border-color: var(--color-accent-strong);
    background: var(--color-accent-soft);
  }

  /* 空状态（纸卡） */
  .wx-empty {
    text-align: center;
    padding: 3rem 1rem;
    background: var(--card-bg);
    border-radius: 4px;
    box-shadow: var(--paper-shadow);
  }

  .wx-empty-icon {
    width: 4rem;
    height: 4rem;
    margin: 0 auto 1rem;
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--color-accent-soft);
    border-radius: 50%;
    color: var(--color-accent-strong);
    font-size: 2rem;
  }

  .wx-empty h3 {
    font-size: 1rem;
    font-weight: 600;
    color: var(--ink);
    margin-bottom: 0.375rem;
  }

  .wx-empty p {
    font-size: 0.875rem;
    color: var(--ink-soft);
    margin: 0;
  }

  /* 响应式 */
  @media (max-width: 480px) {
    .wx-feed {
      gap: 1.25rem;
      padding: 0.75rem 0 1.5rem;
    }

    .wx-feed-item:not(.is-filtered-out) + .wx-feed-item:not(.is-filtered-out)::before {
      top: -0.625rem;
      left: 0.75rem;
      right: 0.75rem;
    }
  }
</style>

<style is:global>
  /* ============================================
   * 置顶块样式
   * ============================================ */
  .wx-pinned {
    display: flex;
    align-items: stretch;
    background: var(--card-bg);
    border-radius: 4px;
    box-shadow: var(--paper-shadow);
    overflow: hidden;
    margin-bottom: 1.25rem;
    min-height: 4.5rem;
    text-decoration: none;
    color: var(--ink);
    transition: box-shadow 0.22s ease, translate 0.22s ease;
  }
  .wx-pinned:hover {
    box-shadow: var(--small-shadow);
    translate: 0 -3px;
  }
  .wx-pinned-tag {
    display: flex;
    align-items: center;
    padding: 0.25rem 0.875rem;
    margin: auto 0.75rem;
    background-color: var(--tape-yellow);
    background-image: var(--tape-stripes);
    color: var(--ink);
    font-size: 1rem;
    font-weight: 700;
    border-radius: 2px;
    transform: rotate(-2deg);
    flex-shrink: 0;
    white-space: nowrap;
  }
  .wx-pinned-items {
    display: flex;
    flex: 1;
    justify-content: flex-end;
    overflow-x: auto;
    overflow-y: hidden;
    scrollbar-width: none;
    gap: 0;
  }
  .wx-pinned-items::-webkit-scrollbar {
    display: none;
  }
  .wx-pinned-preview {
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0.5rem;
    min-width: 4rem;
    max-width: 7.5rem;
    flex: 1;
    border-left: 1px dashed var(--paper-dash);
    overflow: hidden;
  }
  .wx-pinned-preview:first-child {
    border-left: none;
  }
  .wx-pimgs {
    display: grid;
    gap: 2px;
    width: 100%;
    aspect-ratio: 1;
    border-radius: 4px;
    overflow: hidden;
  }
  .wx-pimgs-1 { grid-template-columns: 1fr; }
  .wx-pimgs-2 { grid-template-columns: 1fr 1fr; }
  .wx-pimgs-3 {
    grid-template-columns: 1fr 1fr;
    grid-template-rows: 1fr 1fr;
  }
  .wx-pimgs-3 .wx-pinned-img:first-child { grid-row: 1 / 3; }
  .wx-pimgs-4 {
    grid-template-columns: 1fr 1fr;
    grid-template-rows: 1fr 1fr;
  }
  .wx-pimgs-5,
  .wx-pimgs-6 {
    grid-template-columns: 1fr 1fr 1fr;
    grid-template-rows: 1fr 1fr;
  }
  .wx-pimgs-7,
  .wx-pimgs-8,
  .wx-pimgs-9 {
    grid-template-columns: 1fr 1fr 1fr;
    grid-template-rows: 1fr 1fr 1fr;
  }
  .wx-pinned-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .wx-ptxt {
    margin: 0;
    font-size: 0.625rem;
    color: var(--ink-soft);
    line-height: 1.5;
    display: -webkit-box;
    -webkit-line-clamp: 4;
    -webkit-box-orient: vertical;
    overflow: hidden;
    word-break: break-all;
  }
  @media (max-width: 480px) {
    .wx-pinned-preview {
      min-width: 3.5rem;
      max-width: 6rem;
      padding: 0.375rem;
    }
    .wx-ptxt {
      font-size: 0.5625rem;
      -webkit-line-clamp: 3;
    }
  }

  /* ============================================
   * 动态卡片（手账纸卡：4px 圆角 + 常驻纸影，hover 纸影加深上浮）
   * ============================================ */
  #moments-feed .moment-card {
    position: relative;
    background: var(--card-bg);
    border-radius: 4px;
    box-shadow: var(--paper-shadow);
    padding: 1rem 1rem 1rem 1rem;
    overflow: hidden;
    transition: box-shadow 0.22s ease, translate 0.22s ease;
  }
  #moments-feed .moment-card:hover {
    box-shadow: var(--small-shadow);
    translate: 0 -3px;
  }

  #moments-feed .card-header { display: flex; align-items: center; gap: 0.625rem; margin-bottom: 0.75rem; }
  #moments-feed .card-avatar { flex-shrink: 0; }
  #moments-feed .avatar-img {
    width: 2.5rem; height: 2.5rem; border-radius: 50%; object-fit: cover;
    border: 2px solid var(--color-accent-soft); box-sizing: border-box;
  }
  #moments-feed .card-user-info { flex: 1; min-width: 0; }
  #moments-feed .user-row { display: flex; align-items: center; gap: 0.375rem; margin-bottom: 0.125rem; }
  /* 卡内「置顶」徽章：小黄胶带 */
  #moments-feed .pinned-badge {
    display: inline-flex; align-items: center; gap: 0.25rem;
    padding: 0.125rem 0.5rem;
    background-color: var(--tape-yellow);
    background-image: var(--tape-stripes);
    color: var(--ink);
    border-radius: 2px;
    font-size: 0.7rem; font-weight: 700;
    transform: rotate(-2deg);
  }
  #moments-feed .pinned-icon { width: 14px; height: 14px; }
  #moments-feed .user-name { font-size: 0.9375rem; font-weight: 600; color: var(--color-accent-strong); }
  #moments-feed .meta-row { display: flex; align-items: center; gap: 0.375rem; font-size: 0.75rem; color: var(--ink-soft); }
  #moments-feed .meta-dot { opacity: 0.5; }
  #moments-feed .location {
    display: inline-flex;
    align-items: center;
    gap: 0.125rem;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  #moments-feed .location-icon { font-size: 0.875rem; flex-shrink: 0; width: 14px; height: 14px; }
  #moments-feed .mood {
    display: inline-flex;
    align-items: center;
    gap: 0.125rem;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  #moments-feed .mood-icon { font-size: 0.875rem; flex-shrink: 0; width: 14px; height: 14px; }

  /* 展开评论区：与文章页同一套 comments-section 纸卡外壳（撕边纸层 + 粉胶带 + 标题，
     样式在 paper-comments.css 随主包下发）。外层容器只负责显示/收起，不再自带底色。 */
  #moments-feed .twikoo-entry-comments {
    background: transparent;
    border: none;
    border-radius: 0;
    padding: 0;
  }
  /* 卡内嵌入时收紧上下外距（原 26px 8px 是卡外平级区块的节奏） */
  #moments-feed .diary-comments-section {
    margin-block: 4px 2px;
  }

  #moments-feed .card-content { margin-bottom: 0.75rem; }
  #moments-feed .moment-markdown { word-break: break-word; line-height: 1.7; color: var(--ink); }
  #moments-feed .moment-markdown p { margin-bottom: 0.375rem; }
  #moments-feed .moment-markdown p:last-child { margin-bottom: 0; }
  #moments-feed .moment-markdown img { border-radius: 4px; margin-top: 0.5rem; max-width: 100%; }
  #moments-feed .moment-markdown a { color: var(--color-accent-strong); text-decoration: underline; }

  /* 图片网格基础布局（列数由 --img-cols 控制：1/2/3） */
  #moments-feed .card-images {
    display: grid;
    gap: 0.375rem;
    margin-bottom: 0.75rem;
