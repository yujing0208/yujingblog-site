---
import type { CollectionEntry } from "astro:content";
import { render } from "astro:content";
/**
 * 处理 permalink 的文章（包括全局 permalink 和自定义 permalink）
 * 全局 permalink 启用时，所有文章链接在根目录下生成
 * 例如：%post_id% => /1/, %year%-%postname% => /2024-my-post/
 * 自定义 permalink 也在根目录下
 * 例如：permalink: "custom-page" => /custom-page/
 */
import Image from "@components/atoms/Image/Image.astro";
import Comment from "@components/comment/index.astro";
import Encryptor from "@components/features/auth/Encryptor.astro";
import {
	LastModified,
	PostMeta,
} from "@components/features/posts";
import PaperArticleFooter from "@components/features/posts/PaperArticleFooter.astro";
import PaperLicense from "@components/features/posts/PaperLicense.astro";
import Markdown from "@components/misc/Markdown.astro";
import MainGridLayout from "@layouts/MainGridLayout.astro";
import { getSortedPosts } from "@utils/content-utils";
import {
	generatePermalinkSlug,
	hasCustomPermalink,
	initPostIdMap,
} from "@utils/permalink-utils";
import { getPostPublicDescription } from "@utils/post-card-content";
import { getCategoryUrl, getFileDirFromPath } from "@utils/url-utils";
import "@/styles/paper-post.css";
import { Icon } from "astro-icon/components";
import { licenseConfig, shareConfig } from "src/config";

import { permalinkConfig } from "@/config";

import { profileConfig, siteConfig } from "../config";
import { formatDateToYYYYMMDD } from "../utils/date-utils";

export async function getStaticPaths() {
	const blogEntries = await getSortedPosts();

	// 初始化文章 ID 映射
	initPostIdMap(blogEntries);

	const paths: {
		params: { permalink: string };
		props: { entry: CollectionEntry<"posts"> };
	}[] = [];

	for (const entry of blogEntries) {
		let permalink: string | null = null;

		// 优先使用自定义 permalink
		if (hasCustomPermalink(entry)) {
			permalink =
				entry.data.permalink?.replace(/^\/+/, "").replace(/\/+$/, "") ?? null;
		}
		// 其次使用全局 permalink（如果启用）
		else if (permalinkConfig.enable) {
			permalink = generatePermalinkSlug(entry);
		}

		// 只处理有 permalink 的文章
		if (permalink) {
			paths.push({
				params: { permalink },
				props: { entry },
			});
		}
	}

	return paths;
}

const { entry } = Astro.props;
const { Content, headings } = await render(entry);

const { remarkPluginFrontmatter } = await render(entry);

// 处理加密逻辑
const isEncrypted = !!(entry.data.encrypted && entry.data.password);
const publicDescription = getPostPublicDescription(
	entry.data,
	entry.data.title,
);

const jsonLd = {
	"@context": "https://schema.org",
	"@type": "BlogPosting",
	headline: entry.data.title,
	description: publicDescription,
	keywords: entry.data.tags,
	author: {
		"@type": "Person",
		name: profileConfig.name,
		url: Astro.site,
	},
	datePublished: formatDateToYYYYMMDD(entry.data.published),
	inLanguage: entry.data.lang
		? entry.data.lang.replace("_", "-")
		: siteConfig.lang.replace("_", "-"),
};

// Process cover image for ShareCard & OG
let posterCoverUrl = entry.data.image;

// Process avatar image for ShareCard
let posterAvatarUrl = profileConfig.avatar;
---

<MainGridLayout
	banner={entry.data.image}
	title={entry.data.title}
	description={publicDescription}
	lang={entry.data.lang}
	setOGTypeArticle={true}
	postSlug={entry.id}
	headings={headings}
	publishedDate={entry.data.published}
	category={entry.data.category || undefined}
	wordCount={remarkPluginFrontmatter.words}
>
	<script
		is:inline
		slot="head"
		type="application/ld+json"
		set:html={JSON.stringify(jsonLd)}
	/>
	<script>
		import("../scripts/right-sidebar-layout.js");
	</script>
	<div
		class="flex w-full rounded-(--radius-large) overflow-hidden relative mb-4"
	>
		<div
			id="post-container"
			class:list={[
				"card-base z-10 px-6 md:px-9 pt-6 pb-4 relative w-full ",
				{},
			]}
		>
			<!-- FlatPaper 题图（对齐演示站 article-top-img）：卡顶出血 + 底部渐隐融合 -->
			{
				entry.data.image && siteConfig.showCoverInContent && (
					<figure class="fp-article-top-img onload-animation">
						<Image
							id="post-cover"
							src={entry.data.image}
							basePath={getFileDirFromPath(entry.filePath || "")}
							class="fp-article-cover-img"
							widths={[640, 1024, 1536, 2048]}
							sizes="(max-width: 768px) 100vw, (max-width: 1200px) 80vw, 1200px"
						/>
					</figure>
				)
			}

			<!-- FlatPaper 文章头：分类 label-pill + 标题，压在题图渐变尾上 -->
			<div
				class:list={[
					"fp-article-header onload-animation",
					{
						"fp-article-header--overlap":
							entry.data.image && siteConfig.showCoverInContent,
					},
				]}
			>
				{
					entry.data.category && (
						<a
							class="label-pill"
							href={getCategoryUrl(entry.data.category)}
							aria-label={entry.data.category}
						>
							<Icon
								name="material-symbols:folder-outline"
								class="text-[14px]"
								is:inline
							/>
							{entry.data.category}
						</a>
					)
				}
				<h1
					data-pagefind-body
					data-pagefind-weight="10"
					data-pagefind-meta="title"
					class="fp-article-title transition w-full block font-bold text-black/90 dark:text-white/90"
				>
					{entry.data.title}
				</h1>
			</div>

			<!-- metadata（字数/阅读时长并入 meta 行，对应 flatpaper meta-line 位） -->
			<div class="onload-animation">
				<PostMeta
					className="mb-5"
					published={entry.data.published}
					updated={entry.data.updated}
					tags={entry.data.tags}
					id={entry.id}
					showEncrypted={isEncrypted}
					words={remarkPluginFrontmatter.words}
					minutes={remarkPluginFrontmatter.minutes}
					showWordCount={true}
					showReadingTime={true}
				/>
				{
					(!entry.data.image ||
						(entry.data.image &&
							!siteConfig.showCoverInContent)) && (
						<div class="mt-4 border-(--line-divider) border-dashed border-b mb-5" />
					)
				}
			</div>

			{
				isEncrypted ? (
					<Encryptor
						password={entry.data.password}
						slug={entry.id}
						hint={entry.data.passwordHint}
					>
						<Markdown class="mb-6 markdown-content onload-animation">
							<Content />
						</Markdown>
					</Encryptor>
				) : (
					<>
						<Markdown class="mb-6 markdown-content onload-animation">
							<Content />
						</Markdown>
						<!-- FlatPaper 文章结尾区：评论/分享 reactions + 上一篇/下一篇导航 -->
					<PaperArticleFooter
						title={entry.data.title}
						author={entry.data.author}
						description={publicDescription}
						pubDate={formatDateToYYYYMMDD(entry.data.published)}
						coverImage={posterCoverUrl}
						url={Astro.url.toString()}
						siteTitle={siteConfig.title}
						avatar={posterAvatarUrl}
						showShare={shareConfig.enable && entry.data.showShare !== false}
						prevSlug={entry.data.nextSlug}
						prevTitle={entry.data.nextTitle}
						nextSlug={entry.data.prevSlug}
						nextTitle={entry.data.prevTitle}
					/>
					</>
				)
			}
		</div>
	</div>

	{
		licenseConfig.enable && (
			<PaperLicense
				title={entry.data.title}
				pubDate={entry.data.published}
				author={entry.data.author}
				sourceLink={entry.data.sourceLink}
				licenseName={entry.data.licenseName}
				licenseUrl={entry.data.licenseUrl}
			/>
		)
	}

	<!-- 评论 -->
	<Comment post={entry} />

	{
		siteConfig.showLastModified && (
			<LastModified
				updatedDate={entry.data.updated || entry.data.published}
			/>
		)
	}
</MainGridLayout>
