---
import DeviceCard from "@components/features/devices/DeviceCard.astro";
import { PageHeader } from "@components/features/page-header";

import { siteConfig } from "../config";
import { devicesData } from "../data/devices";
import I18nKey from "../i18n/i18nKey";
import { i18n } from "../i18n/translation";
import MainGridLayout from "../layouts/MainGridLayout.astro";

export const prerender = true;

// 检查设备页面是否启用
if (!siteConfig.featurePages.devices) {
	return Astro.redirect("/404/");
}

// 设备数据
const devices = devicesData;
const brands = Object.keys(devices);
const viewDetailsText = i18n(I18nKey.devicesViewDetails);
---

<MainGridLayout title={i18n(I18nKey.devices)}>
	<!-- 引入右侧边栏布局管理器 -->
	<script>
		import("../scripts/right-sidebar-layout.js");
	</script>
	<div
		class="flex w-full rounded-(--radius-large) overflow-hidden relative min-h-32"
	>
		<div class="card-base z-10 px-9 py-6 relative w-full">
			<!-- 页面标题 -->
			<PageHeader
				title={i18n(I18nKey.devices)}
				subtitle={i18n(I18nKey.devicesSubtitle)}
			/>

			<!-- 过滤按钮 -->
			<div class="mb-6">
				<div class="filter-container flex flex-wrap gap-2">
					{
						brands.map((brand, index) => (
							<button
								data-brand={brand}
								class={`filter-tag px-6 py-2.5 rounded-lg font-medium transition-all ${
									index === 0 ? "active" : ""
								}`}
							>
								{brand}
							</button>
						))
					}
				</div>
			</div>

			<!-- 设备列表 -->
			<div
				id="devices-container"
				class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6"
			>
				{
					brands.length > 0 &&
						devices[brands[0]].map((device, index) => (
							<DeviceCard
								device={device}
								index={index}
								viewDetailsText={viewDetailsText}
							/>
						))
				}
			</div>

			<!-- 隐藏数据用于客户端渲染 -->
			<script
				is:inline
				id="devices-data"
				type="application/json"
				set:html={JSON.stringify(devices)}
			/>
			<script
				is:inline
				id="i18n-data"
				type="application/json"
				set:html={JSON.stringify({ viewDetails: viewDetailsText })}
			/>
		</div>
	</div>

	<!-- 设备分类筛选：使用事件委托挂载到 body，Swup 无刷新切换后无需重新绑定 -->
	<script is:inline>
		(function () {
			if (window.__mizukiDevicesFilterBound) return;
			window.__mizukiDevicesFilterBound = true;

			function renderDevices(brand) {
				var container = document.getElementById('devices-container');
				var dataEl = document.getElementById('devices-data');
				if (!container || !dataEl) return;
				var devices = JSON.parse(dataEl.textContent || '{}');
				var items = devices[brand] || [];
				container.innerHTML = items.map(function(device, index) {
					return [
						'<a href="' + device.link + '" target="_blank" rel="noopener noreferrer"',
						' class="device-card group relative block cursor-pointer"',
						' style="animation-delay: ' + (index * 100) + 'ms">',
						'<div class="relative p-6 pb-0">',
						'<div class="device-card-imgbox flex justify-center items-center h-48 overflow-hidden relative">',
						'<img src="' + device.image + '" alt="' + device.name + '" class="w-auto h-full max-h-full object-contain group-hover:scale-110 transition-all duration-500 drop-shadow-md relative z-10" loading="lazy"/>',
						'</div></div>',
						'<div class="p-6 pt-4 relative z-10">',
						'<h3 class="text-lg font-bold text-black/90 dark:text-white/90 group-hover:text-(--primary) transition-colors duration-300">' + device.name + '</h3>',
						'<div class="device-spec inline-flex items-center gap-2 px-3 py-1 text-sm my-3">',
						'<span class="font-medium">' + device.specs + '</span></div>',
						'<p class="text-sm text-black/60 dark:text-white/60 line-clamp-2">' + device.description + '</p>',
						'</div></a>'
					].join('');
				});
			}

			document.body.addEventListener('click', function (e) {
				var btn = e.target.closest('.filter-tag');
				if (!btn || !document.getElementById('devices-container')) return;
				var buttons = document.querySelectorAll('.filter-tag');
				buttons.forEach(function(b) { b.classList.remove('active'); });
				btn.classList.add('active');
				renderDevices(btn.getAttribute('data-brand'));
			});
		})();
	</script>
</MainGridLayout>

<style is:global>
	/* paper 适配：筛选按钮 = 手绘虚线框（与动态页 tag-item 同语言） */
	.filter-container {
		display: flex;
		flex-wrap: wrap;
		gap: 0.75rem;
		margin-bottom: 1rem;
	}

	.filter-tag {
		padding: 0.5rem 1.1rem;
		border: 1.5px dashed var(--dash);
		border-radius: var(--radius-handdrawn);
		background: transparent;
		color: var(--ink-soft);
		font-size: 0.875rem;
		font-weight: 500;
		cursor: pointer;
		transition: all 0.2s ease;
		white-space: nowrap;
	}

	.filter-tag:hover:not(.active) {
		color: var(--color-accent-strong);
		border-color: var(--color-accent-strong);
		background: var(--color-accent-soft);
	}

	.filter-tag.active {
		background: var(--color-accent-strong);
		color: #fff;
		border-color: var(--color-accent-strong);
		border-style: solid;
		box-shadow: var(--small-shadow);
	}

	/* 设备卡片：纸卡壳层（4px 撕边纸由 card-base 体系承担，这里对齐语言） */
	.device-card {
		border-radius: 4px;
		background: var(--card-bg);
		border: 1px solid var(--paper-line);
		box-shadow: var(--paper-shadow);
		transition: box-shadow 0.22s ease, translate 0.22s ease, border-color 0.22s ease;
	}

	@media (hover: hover) and (pointer: fine) {
		.device-card:hover {
			translate: 0 -3px;
			box-shadow: var(--small-shadow);
			border-color: var(--paper-dash);
		}
	}

	.device-card-imgbox {
		border-radius: 3px;
		background: var(--paper-warm);
	}

	/* 规格标签：手绘虚线小框 */
	.device-spec {
		border: 1.5px dashed var(--dash);
		border-radius: var(--radius-handdrawn);
		background: transparent;
		color: var(--ink-soft);
	}

	/* 设备卡片动画效果 */
	@keyframes fadeInUp {
		from {
			opacity: 0;
			transform: translateY(20px);
		}
		to {
			opacity: 1;
			transform: translateY(0);
		}
	}

	.onload-animation {
		animation: fadeInUp 0.6s cubic-bezier(0.25, 0.1, 0.25, 1) forwards;
		opacity: 0;
	}

	/* 卡片内容文本截断 */
	.line-clamp-2 {
		display: -webkit-box;
		-webkit-line-clamp: 2;
		-webkit-box-orient: vertical;
		overflow: hidden;
	}

	/* 响应式调整 */
	@media (width < 768px) {
		.filter-container {
			gap: 0.5rem;
		}

		.filter-tag {
			padding: 0.4rem 0.9rem;
			font-size: 0.8rem;
		}

		.device-card .relative.p-6\.pb-0 {
			padding: 1rem 1rem 0;
		}

		.device-card .p-6\.pt-4 {
			padding: 1rem;
		}
	}
</style>
