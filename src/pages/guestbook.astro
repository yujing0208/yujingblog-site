---
// 留言板（留言墙）—— 1:1 照搬 homulilly.com/comment/
// 结构 / 类名 / 文案 / 初始化方式均与 homulilly 一致，后端同为 Twikoo。
import { commentConfig } from "@/config";
import MainGridLayout from "@layouts/MainGridLayout.astro";
import Twikoo from "@components/comment/Twikoo.astro";
import "../styles/paper-page.css";

export const prerender = true;

const title = "留言板";
const description = "在这里给我留言，畅所欲言～";

// Twikoo 环境地址（照搬 homulilly 的 data-guestbook-env / twikoo.init({envId})）
const twikooEnvId = String(commentConfig.twikoo?.envId ?? "").replace(/\/+$/, "");
const pageSize = 15;
const avatarFallback = "/images/icon-error.webp";
// 站长评论改名（2026-10-01 定稿）：不隐藏任何评论；站长留言照常上墙/展示，
//   但昵称统一显示为 YuJing（下方 Twikoo 评论区的改名逻辑在 Twikoo.astro，全站生效）。
//   owner-hashes = sha256(站长邮箱 2803673194@qq.com)（weavatar 头像 URL 特征）
//   owner-nicks  = 站长常用昵称兜底
---

<MainGridLayout title={title} description={description}>
	<link slot="head" rel="stylesheet" href="/paper-guestbook-wall.css" />

	<!-- 留言墙（照搬 homulilly /comment/ 的 DOM 结构） -->
	<div class="article-tape-wrap w-full relative">
		<span class="tape tape--top-right" aria-hidden="true"></span>
		<article
			class="article-paper guestbook-page card-base relative z-10 w-full"
		>
			<!-- 页面头：label-pill + h1（flatpaper guestbook.ejs article-header） -->
			<header class="article-header">
				<span class="label-pill">留言板</span>
				<h1>{title}</h1>
				<p class="guestbook-subtitle">欢迎在这里留下足迹，说点什么吧～</p>
			</header>

			<section
				class="guestbook-wall"
				data-guestbook-system="twikoo"
				data-guestbook-env={twikooEnvId}
				data-page-size={String(pageSize)}
				data-avatar-fallback={avatarFallback}
				data-guestbook-owner-nicks="余京,YuJing"
				data-guestbook-owner-hashes="46d038eb362227469c0145d278dc3dbf,9735dc7774c6444b2647f25b595d67d5668e1d0ad38aa11557f3a7a4954a1abb"
				data-guestbook-owner-display="YuJing"
				aria-label="留言板"
			>
				<div class="guestbook-wall__summary" hidden>
					<span class="guestbook-wall__stat" data-guestbook-stat="total"></span>
					<span class="guestbook-wall__stat" data-guestbook-stat="shown" hidden></span>
					<button
						class="guestbook-wall__sort"
						type="button"
						data-guestbook-sort
						hidden
					>
					</button>
					<a class="guestbook-wall__write" href="#tcomment">
						在下方留言，刷新后就会贴到墙上
					</a>
				</div>
				<p class="guestbook-wall__state" data-guestbook-state aria-live="polite">
					正在铺开留言墙…
				</p>
				<ul class="guestbook-wall__list" data-guestbook-list></ul>
				<button
					class="guestbook-wall__more"
					type="button"
					data-guestbook-more
					hidden
				>
					展开更多留言
				</button>
			</section>
		</article>
	</div>

	<!-- 下方评论区：Twikoo（复用骨架自带组件：懒加载 + Swup 钩子 + 本地 SDK）
	     站长评论正常展示，昵称统一显示为 YuJing（改名逻辑在 Twikoo.astro） -->
	<section class="comments-section" aria-label="评论">
		<header class="comments-section__head">
			<h2>
				<svg
					class="lucide"
					viewBox="0 0 24 24"
					fill="none"
					stroke="currentColor"
					stroke-width="2"
					stroke-linecap="round"
					stroke-linejoin="round"
					aria-hidden="true"
				>
					<path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"
					></path>
				</svg>
				评论
			</h2>
		</header>
		<Twikoo path="/guestbook/" />
	</section>
</MainGridLayout>
