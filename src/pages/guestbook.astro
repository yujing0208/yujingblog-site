---
import MainGridLayout from "@layouts/MainGridLayout.astro";
import GuestbookChat from "@components/widgets/guestbook/GuestbookChat.svelte";
import "@components/widgets/guestbook/guestbook-chat.css";

export const prerender = true;

const title = "留言板";
const description = "在这里给我留言，畅所欲言～";
---

<MainGridLayout title={title} description={description}>
	<div class="guestbook-page guestbook-fullscreen">
		<GuestbookChat client:idle />
	</div>
</MainGridLayout>

<style>
	/* 全屏模式：隐藏博客侧边栏，留言板撑满 */
	.guestbook-fullscreen {
		height: calc(100dvh - 8.5rem);
		min-height: 32rem;
	}

	.guestbook-fullscreen :global(.guestbook-chat) {
		height: 100%;
	}

	/* 隐藏左侧边栏 */
	.guestbook-fullscreen :global(#main-grid > .contents > #sidebar),
	.guestbook-fullscreen :global(#main-grid > #sidebar) {
		display: none !important;
	}

	/* 隐藏右侧边栏 */
	.guestbook-fullscreen :global(.right-sidebar-container) {
		display: none !important;
	}

	/* 主内容区占满整行 */
	.guestbook-fullscreen :global(main#swup-container) {
		grid-column: 1 / -1 !important;
		max-width: 100% !important;
	}

	@media (max-width: 768px) {
		.guestbook-fullscreen {
			height: calc(100dvh - 9rem);
			min-height: 30rem;
		}
	}
</style>
