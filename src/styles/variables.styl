/* utils */
white(a)
  rgba(255, 255, 255, a)

black(a)
  rgba(0, 0, 0, a)

rainbow-light = linear-gradient(to right, oklch(0.80 0.10 0), oklch(0.80 0.10 30), oklch(0.80 0.10 60), oklch(0.80 0.10 90), oklch(0.80 0.10 120), oklch(0.80 0.10 150), oklch(0.80 0.10 180), oklch(0.80 0.10 210), oklch(0.80 0.10 240), oklch(0.80 0.10 270), oklch(0.80 0.10 300), oklch(0.80 0.10 330), oklch(0.80 0.10 360))
rainbow-dark = linear-gradient(to right, oklch(0.70 0.10 0), oklch(0.70 0.10 30), oklch(0.70 0.10 60), oklch(0.70 0.10 90), oklch(0.70 0.10 120), oklch(0.70 0.10 150), oklch(0.70 0.10 180), oklch(0.70 0.10 210), oklch(0.70 0.10 240), oklch(0.70 0.10 270), oklch(0.70 0.10 300), oklch(0.70 0.10 330), oklch(0.70 0.10 360))

/*
 * ============================================================
 *  手账 / 纸张主题（FlatPaper 风格）设计层
 * ============================================================
 *  原则：
 *   1. 保留 var(--hue) 色相驱动 —— 用户主题色仍然生效
 *   2. 底色换成米黄纸张，纸面奶白，墨色偏暖（非纯黑）
 *   3. 圆角改成手绘不规则形
 *   4. 阴影改成纸张投影（暖棕、低透明度、大扩散）
 *   5. 暗色模式做成「深色牛皮纸 / 黑纸」
 * ============================================================
 */

:root
  /* 页面容器宽度上限（2026-10-06 补定义）
     ⚠️ 这个变量之前**从未定义过**，但全站 7 处 CSS 都在消费它：
       #top-row            width: min(94%, var(--page-width))
       .paper-shell-container { width: min(94%, var(--page-width)) }
       #top-row.paper-hero-layout { width: min(94%, var(--page-width)) !important }
       .max-w-\(--page-width\) { max-width: var(--page-width) }
       --toc-width: calc((100vw - var(--page-width)) / 2 - 1rem)
     CSS 规范：var() 引用未定义的自定义属性时，**整条声明作废**，
     于是这些 width 全退回 initial(auto)，导航栏与内容容器各自被父级拉伸，
     右端因此错位（参考站是同一宽度所以看不出来）。

     值取 FlatPaper 原站真值 1300px ——
     原站 style.css 原文：.site-header, .paper-shell, .site-footer
       { width: min(94vw, 1300px); margin-inline: auto; }
     本站多处注释「照搬 FlatPaper 的 min(94vw, 1300px)」也是这个数。 */
  --page-width 1300px

  --radius-large 1rem
  /* 手绘不规则圆角：像用剪刀随手剪出来的纸片 */
  --radius-handdrawn 255px 15px 225px 15px / 15px 225px 15px 255px
  --radius-handdrawn-sm 12px 4px 14px 5px / 5px 13px 4px 12px
  --content-delay 150ms
  --wallpaper-opacity 0.8
  --wallpaper-blur 0px
  --card-transparent-opacity 0.5

/* An util to define variables that vary with light and dark mode */
define(vars)
  :root
    for key, value in vars
      {key}: value[0]
  :root.dark
    for key, value in vars
      if length(value) > 1
        {key}: value[1]

define({
  /* ---------- 强调色：指向演示站 --color-accent* 令牌 ---------- */
  --primary: var(--color-accent) var(--color-accent)

  /* ---------- 纸张底色（抄演示站真值） ---------- */
  /* 亮：米黄纸底 #f7f3e9  →  暗：深墨蓝黑 #15171c */
  --page-bg: #f7f3e9 #15171c
  /* 亮：奶白纸面 #fffdf6  →  暗：深色牛皮纸 #1d2027 */
  --card-bg: #fffdf6 #1d2027
  --card-bg-transparent: rgba(255, 253, 246, 0.82) rgba(29, 32, 39, 0.82)
  /* 更暖的第二层纸（嵌套卡片 / 侧栏用） */
  --paper-warm: #f8f2e2 #272b34
  /* 纸张纹理线条色 */
  --paper-line: rgba(89, 62, 30, 0.055) rgba(255, 255, 255, 0.05)
  --paper-line-strong: rgba(89, 62, 30, 0.09) rgba(255, 255, 255, 0.08)

  /* ---------- 纸胶带（手账标志性元素） ---------- */
  --tape-yellow: rgba(238, 201, 110, 0.72)
  --tape-pink: rgba(232, 168, 158, 0.62)
  --tape-green: rgba(143, 192, 152, 0.62)
  --tape-blue: rgba(111, 169, 217, 0.58)
  --tape-brown: rgba(202, 169, 134, 0.75)
  --tape-stripes: repeating-linear-gradient(45deg, rgba(255, 255, 255, 0.25) 0 2px, transparent 2px 7px)

  /* ---------- 纸张投影：暖棕、低透明、大扩散 ---------- */
  --paper-shadow: rgba(82, 64, 38, 0.13) rgba(0, 0, 0, 0.35)

  --btn-content: var(--color-accent-strong) var(--color-accent)

  --btn-regular-bg: oklch(0.955 0.02 88) oklch(0.33 0.02 265)
  --btn-regular-bg-hover: oklch(0.92 0.035 88) oklch(0.38 0.025 265)
  --btn-regular-bg-active: oklch(0.885 0.05 88) oklch(0.43 0.03 265)

  --btn-plain-bg-hover: oklch(0.955 0.02 88) oklch(0.30 0.02 265)
  --btn-plain-bg-active: oklch(0.975 0.012 88) oklch(0.27 0.015 265)

  --btn-card-bg-hover: oklch(0.978 0.012 88) oklch(0.3 0.018 265)
  --btn-card-bg-active: oklch(0.92 0.03 88) oklch(0.35 0.022 265)

  --enter-btn-bg: var(--btn-regular-bg)
  --enter-btn-bg-hover: var(--btn-regular-bg-hover)
  --enter-btn-bg-active: var(--btn-regular-bg-active)

  /* 墨色：偏暖的深棕灰，不用纯黑 */
  --deep-text: #2c3531 var(--color-accent-soft)

  --text-color: oklch(0.36 0.02 80) oklch(0.92 0.008 265)
  --text-muted: oklch(0.575 0.022 80) oklch(0.70 0.012 265)
  --text-strong: oklch(0.26 0.018 80) oklch(0.97 0.006 265)

  --title-active: var(--color-accent-strong)

  --line-divider: rgba(89, 62, 30, 0.12) white(0.09)

  --line-color: rgba(89, 62, 30, 0.14) white(0.11)
  --meta-divider: rgba(89, 62, 30, 0.22) white(0.2)
  --content-meta: rgba(60, 48, 32, 0.68) white(0.6)

  --inline-code-bg: var(--btn-regular-bg)
  --inline-code-color: var(--btn-content)
  --selection-bg: oklch(0.88 0.055 88) oklch(0.40 0.05 265)
  --codeblock-selection: var(--selection-bg)
  /* 代码块也做成纸质感：亮色偏米，暗色偏墨 */
  --codeblock-bg: oklch(0.965 0.012 88) oklch(0.215 0.012 265)
  --codeblock-topbar-bg: oklch(0.935 0.016 88) oklch(0.175 0.012 265)

  --license-block-bg: rgba(89, 62, 30, 0.045) var(--codeblock-bg)

  --link-underline: oklch(0.92 0.04 88) oklch(0.40 0.05 265)
  --link-hover: oklch(0.945 0.03 88) oklch(0.40 0.05 265)
  --link-active: oklch(0.885 0.05 88) oklch(0.35 0.045 265)

  --float-panel-bg: oklch(0.994 0.008 90) oklch(0.235 0.012 265)

  --scrollbar-bg-light: rgba(89, 62, 30, 0.32)
  --scrollbar-bg-hover-light: rgba(89, 62, 30, 0.45)
  --scrollbar-bg-active-light: rgba(89, 62, 30, 0.58)

  --scrollbar-bg-dark: white(0.35)
  --scrollbar-bg-hover-dark: white(0.48)
  --scrollbar-bg-active-dark: white(0.6)

  --scrollbar-bg: var(--scrollbar-bg-light) var(--scrollbar-bg-dark)
  --scrollbar-bg-hover: var(--scrollbar-bg-hover-light) var(--scrollbar-bg-hover-dark)
  --scrollbar-bg-active: var(--scrollbar-bg-active-light) var(--scrollbar-bg-active-dark)

  --color-selection-bar: rainbow-light rainbow-dark

  --display-light-icon: 1 0
  --display-dark-icon: 0 1

  /* admonition 换成手账色系（纸胶带五色） */
  --admonitions-color-tip: var(--green) var(--green)
  --admonitions-color-note: var(--blue) var(--blue)
  --admonitions-color-important: var(--violet) var(--violet)
  --admonitions-color-warning: var(--yellow) var(--yellow)
  --admonitions-color-caution: var(--red) var(--red)

  --toc-badge-bg: oklch(0.90 0.04 88) var(--btn-regular-bg)
  --toc-btn-hover: oklch(0.935 0.018 88) oklch(0.22 0.012 265)
  --toc-btn-active: oklch(0.905 0.018 88) oklch(0.25 0.012 265)
  --toc-width: calc((100vw - var(--page-width)) / 2 - 1rem)
  --toc-item-active: var(--color-accent-strong) var(--color-accent-soft)
})

/* 非全屏壁纸模式下，--card-bg-transparent 应该和 --card-bg 一致（不透明） */
body:not(.wallpaper-transparent)
  --card-bg-transparent: var(--card-bg)

body.wallpaper-transparent
  --card-bg-transparent: unquote("rgba(255, 253, 246, var(--card-transparent-opacity, 0.8))")

:root.dark body.wallpaper-transparent
  --card-bg-transparent: unquote("rgba(29, 32, 39, var(--card-transparent-opacity, 0.8))")
