# build output
dist/

# generated types
.astro/
demo
plans

# dependencies
node_modules/

# logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# environment variables
.env
.env.production

# content repository (independent mode)
/content/
*.backup

# Content sync destinations (managed by content repo when ENABLE_CONTENT_SYNC=true)
# These are populated by sync-content.js on dev/build — do NOT commit directly
/src/content/posts/*
!/src/content/posts/.gitkeep
/src/content/spec/*
!/src/content/spec/.gitkeep
/src/settings/

# Large zip files
*.zip

# macOS-specific files
.DS_Store

.vercel

package-lock.json
bun.lockb
yarn.lock

# ide
.idea
*.iml
.claude

cache/
fuwari/
src/data/myself.ts
src/pages/myself.astro

# Bangumi generated data
src/data/bangumi-data.json

# Bilibili generated data
src/data/bilibili-data.json

# Lighthouse CI
.lighthouseci/

# Live2D editor source files
*.psd
*.psd~
*.cmo3
*.vtube.json

.vercel
.env*

# ---- 内容分离：以下内容仓库产物由 sync-content.js 构建期生成，禁止提交 ----
# images/  -> public/images（内容仓库 images 整体同步，整体替换）
/public/images/
# settings/ -> src/settings（可编辑配置文件，整体由内容仓库提供）
#   不屏蔽的话，sync-content.js 结尾那句 `git add .` 会把内容仓的 settings
#   提交进站点仓库，造成"配置有两个源"的混乱。
/src/settings/
# data/  -> src/data（merge 同步；此处显式列举内容仓库拥有的文件，
#           站点仓库独有的 data 文件仍可正常跟踪）
/src/data/anime.ts
/src/data/announcement.ts
/src/data/devices.ts
/src/data/diary.ts
/src/data/footprints.ts
/src/data/friends.ts
/src/data/notebooks.ts
/src/data/projects.ts
/src/data/skills.ts
/src/data/timeline.ts
/src/data/website.ts
